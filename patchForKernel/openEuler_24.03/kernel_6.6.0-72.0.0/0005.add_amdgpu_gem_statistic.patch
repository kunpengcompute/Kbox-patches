+static int amdgpu_debugfs_gem_statistics_show(struct seq_file *m, void *unused) 
+{
+	struct amdgpu_device *adev = m->private;
+	struct drm_device *dev = adev_to_drm(adev);
+	struct drm_file *file;
+	int r;
+
+	r = mutex_lock_interruptible(&dev->filelist_mutex);
+	if (r)
+		return r;
+
+	list_for_each_entry(file, &dev->filelist, lhead)
+	{
+		struct task_struct *taskp = NULL;
+		struct gem_sizes sizes;
+		char *cgroup_path = NULL;
+		char *container_id = NULL;
+		unsigned int cgroup_id = 0;
+		struct container_mem_stats *stats;
+		bool found = false;
+
+		sizes.vram = 0;
+		sizes.gtt = 0;
+		spin_lock(&file->table_lock);
+		idr_for_each(&file->object_idr, amdgpu_debugfs_gem_bo_statistics, &sizes);
+		spin_unlock(&file->table_lock);
+		if (!sizes.total)
+			continue;
+
+		rcu_read_lock();
+		taskp = pid_task(file->pid, PIDTYPE_PID);
+		if (!taskp) {
+			rcu_read_unlock();
+			continue;
+		}
+		task_lock(taskp);
+		cgroup_path = get_task_cgroup_path(taskp);
+		if (!cgroup_path) {
+			task_unlock(taskp);
+			rcu_read_unlock();
+			continue;
+		}
+		if (strstr(cgroup_path, "/docker-")) {
+			container_id = extract_container_id(cgroup_path, '-');
+        } else if (strstr(cgroup_path, "/kubepods/")) {
+			container_id = extract_container_id_k8s(cgroup_path, "/pod");
+        } else if (strstr(cgroup_path, "cri-containerd")) { //k8s用systemd驱动管理资源控制器
+			container_id = extract_container_id_cri(cgroup_path);
+        }
+		if(container_id) {
+			mutex_lock(&container_stats_mutex);
+			list_for_each_entry(stats, &container_stats_list, list)
+			{
+				if (strcmp(stats->container_id, container_id) == 0)
+				{
+					stats->total_vram += sizes.vram;
+					stats->total_gtt += sizes.gtt;
+					found = true;
+					break;
+				}
+			}
+			if (!found) {
+				stats = kzalloc(sizeof(*stats), GFP_KERNEL);
+				if (stats) {
+					strncpy(stats->container_id, container_id, sizeof(stats->container_id));
+					stats->total_vram = sizes.vram;
+					stats->total_gtt = sizes.gtt;
+					list_add_tail(&stats->list, &container_stats_list);
+				}
+			}
+			mutex_unlock(&container_stats_mutex);
+			kfree(container_id);
+		}
+		kfree(cgroup_path);
+		task_unlock(taskp);
+		rcu_read_unlock();
+	}
+
+	struct list_head *pos;
+	struct list_head *q;
+
+	mutex_unlock(&dev->filelist_mutex);
+	mutex_lock(&container_stats_mutex);
+	if (!list_empty(&container_stats_list)) {
+		list_for_each_safe(pos, q, &container_stats_list) {
+			struct container_mem_stats *tmp = list_entry(pos, struct container_mem_stats, list);
+			seq_printf(m,"container_id:%s vram:%zu byte gtt:%zu byte\n", tmp->container_id, tmp->total_vram, tmp->total_gtt);
+			list_del(&tmp->list);
+			kfree(tmp);
+		}
+	}
+	mutex_unlock(&container_stats_mutex);
+	return 0;
+}
