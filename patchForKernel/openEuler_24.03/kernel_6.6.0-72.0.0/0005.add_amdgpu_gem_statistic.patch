+static bool is_contain_vm_statistic(const char *str) {
+    if (str == NULL) {
+        return false;
+    }
+    return strstr(str, "PID") && strstr(str, "PhoneID") && strstr(str, "VPID");
+}
+
+static int read_to_vm_list(char *read_buf) {
+    char *line;
+    char *token;
+    struct vm_info_t vm_info;
+    char *remaining = read_buf;
+    bool haved_vm_statistic = false;
+
+    if (!read_buf) {
+        return -EINVAL;
+    }
+
+    while ((line = strsep(&remaining, "\n")) != NULL) {
+        struct pid *pid_struct = NULL;
+        char *container_id = NULL;
+        struct task_struct *task;
+        char *cgroup_path = NULL;
+        struct vm_statistic_t *vm_statistic;
+        bool found = false;
+        int field_count = 0;
+        char *line_remaining = line;
+
+        if (is_contain_vm_statistic(line)) {
+            haved_vm_statistic = true;
+            continue;
+        }
+
+        if (!haved_vm_statistic) {
+            continue;
+        }
+
+        while ((token = strsep(&line_remaining, " \t")) != NULL) {
+            if (!token || strlen(token) == 0) {
+                continue;
+            }
+
+            switch (field_count) {
+                case 0:
+                    kstrtoint(token, 10, &vm_info.pid);
+                    break;
+                case 6:
+                    kstrtoint(token, 10, &vm_info.used_size);
+                    break;
+            }
+            field_count++;
+        }
+
+        if (field_count != VM_DEBUGFS_FILED_COUNT) {
+            continue;
+        }
+
+        pid_struct = find_vpid(vm_info.pid);
+        if (!pid_struct) {
+            pr_err("Could not find pid structure for PID %d\n", vm_info.pid);
+            continue;
+        }
+        get_pid(pid_struct);
+
+        rcu_read_lock();
+        task = pid_task(pid_struct, PIDTYPE_PID);
+        if (!task) {
+            rcu_read_unlock();
+            put_pid(pid_struct);
+            continue;
+        }
+        task_lock(task);
+        cgroup_path = get_task_cgroup_path(task);
+        if (!cgroup_path) {
+            task_unlock(task);
+            rcu_read_unlock();
+            put_pid(pid_struct);
+            continue;
+        }
+        if (strstr(cgroup_path, "/docker-")) {
+            container_id = extract_container_id(cgroup_path, '-');
+        } else if (strstr(cgroup_path, "/kubepods/")) {
+            container_id = extract_container_id_k8s(cgroup_path, "/pod");
+        } else if (strstr(cgroup_path, K8S_CONTAINER_FEATURE_CODE)) { //k8s用systemd驱动管理资源控制器
+            container_id = extract_container_id_cri(cgroup_path);
+        } 
+
+        if (container_id) {
+            mutex_lock(&vm_container_stats_mutex);
+            list_for_each_entry(vm_statistic, &vm_container_stats_list, list) {
+                if (strcmp(vm_statistic->container_id, container_id) == 0) {
+                    vm_statistic->total_vram += vm_info.used_size;
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                vm_statistic = kzalloc(sizeof(struct vm_statistic_t), GFP_KERNEL);
+                if (vm_statistic) {
+                    strlcpy(vm_statistic->container_id, container_id, sizeof(vm_statistic->container_id));
+                    vm_statistic->total_vram = vm_info.used_size;
+                    list_add_tail(&vm_statistic->list, &vm_container_stats_list);
+                    container_num++;
+                } else {
+                    pr_err("Failed to allocate memory for vm_statistic\n");
+                }
+            }
+            mutex_unlock(&vm_container_stats_mutex);
+            kfree(container_id);
+        }
+        kfree(cgroup_path);
+        task_unlock(task);
+        rcu_read_unlock();
+        put_pid(pid_struct);
+        
+    }
+
+    return 0;
+}
