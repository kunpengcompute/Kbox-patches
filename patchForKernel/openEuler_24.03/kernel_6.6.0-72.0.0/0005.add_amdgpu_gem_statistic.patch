+// 定时器回调函数
+static enum hrtimer_restart update_timer_callback(struct hrtimer *timer) {
+    queue_work(update_workqueue, &update_work);
+
+    // 重新启动定时器
+    hrtimer_forward_now(&update_timer, update_interval);
+    return HRTIMER_RESTART;
