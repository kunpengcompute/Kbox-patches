+static void generate_data_amd(struct debugfs_cache *cache)
+{
+    char **str_array = NULL;
+    ssize_t total_len = 0;
+    int amd_num = amd_node_count / 4;
+    int i;
+
+    if (amd_num == 0) {
+        goto empty_handle;
+    }
+
+    str_array = kmalloc(sizeof(char *) * amd_num, GFP_KERNEL);
+    if (!str_array) {
+        pr_err("Failed to allocate memory for string array\n");
+        goto empty_handle;
+    }
+    for (i = 0; i < amd_num; i++) {
+        str_array[i] = read_debugfs_to_buffer(AMD_DEBUGFS_FMT, i + 1); //AMD的节点从1开始
+        if (str_array[i]) {
+            total_len += strlen(str_array[i]);
+        }
+    }
+    if (total_len == 0) {
+        goto empty_handle;
+    }
+    cache->data = kmalloc(total_len + 1, GFP_KERNEL);
+    if (!cache->data) {
+        pr_err("Failed to allocate memory for cache data\n");
+        goto free_str_array;
+    }
+    cache->data[0] = '\0';
+    for (i = 0; i < amd_num; i++) {
+        if (str_array[i]) {
+            strcat(cache->data, str_array[i]);
+            kfree(str_array[i]);
+        }
+    }
+    cache->size = total_len;
+    kfree(str_array);
+    return;
+
+free_str_array:
+    for (i = 0; i <= amd_num; i++) {
+        if (str_array[i]) {
+            kfree(str_array[i]);
+        }
+    }
+    kfree(str_array);
+empty_handle:
+    cache->data = NULL;
+    cache->size = 0;
+}
+
+static void generate_data_dc(struct debugfs_cache *cache) {
+    struct vm_statistic_t *vm_statistic;
+    int i;
+    char tmp_buf[256];
+    int pos = 0;
+    
+    mutex_lock(&vm_container_stats_mutex);
+    while (!list_empty(&vm_container_stats_list)) {
+        vm_statistic = list_first_entry(&vm_container_stats_list, struct vm_statistic_t, list);
+        list_del(&vm_statistic->list);
+        kfree(vm_statistic);
+    }
+    container_num = 0;
+    mutex_unlock(&vm_container_stats_mutex);
+    
+    for (i = 0; i < vm_node_count; i++) {
+        char *read_buf = read_debugfs_to_buffer(VM_DEBUGFS_PATH, i);
+        if (read_buf) {
+            read_to_vm_list(read_buf);
+            kfree(read_buf);
+        } else {
+            break;
+        }
+    }
+
+    if (container_num == 0) {
+        goto empty_handle;
+    }
+
+    cache->data = kmalloc(MAX_RECORD_LENGTH * container_num + 1, GFP_KERNEL);
+    if (!cache->data) {
+        pr_err("Failed to allocate memory for cache data\n");
+        goto empty_handle;
+    }
+    mutex_lock(&vm_container_stats_mutex);
+    list_for_each_entry(vm_statistic, &vm_container_stats_list, list) {
+        int len = snprintf(tmp_buf, sizeof(tmp_buf), "container_id:%s vram:%zu byte\n",
+                           vm_statistic->container_id, vm_statistic->total_vram);
+        int bytes_to_copy = min(len, MAX_RECORD_LENGTH);
+        memcpy(cache->data + pos, tmp_buf, bytes_to_copy);
+        pos += bytes_to_copy;
+    }
+    cache->size = pos;
+    mutex_unlock(&vm_container_stats_mutex);
+    return;
+
+empty_handle:
+    cache->data = NULL;
+    cache->size = 0;
+}
+
+static void update_cache(struct work_struct *work)
+{
+    struct debugfs_cache *new_cache = kmalloc(sizeof(*new_cache), GFP_KERNEL);
+    if (!new_cache) {
+        pr_err("Failed to allocate memory for cache\n");
+        return;
+    }
+    int new_idx = atomic_read(&active_idx) ^ 1;
+
+    if (amd_vendor) {
+        generate_data_amd(new_cache);
+    } else {
+        generate_data_dc(new_cache);
+    }
+    
+    rcu_assign_pointer(cache[new_idx], new_cache);
+    atomic_set(&active_idx, new_idx);
+    
+    synchronize_rcu();
+    struct debugfs_cache *old_cache = rcu_dereference_raw(cache[new_idx ^ 1]);
+    rcu_assign_pointer(cache[new_idx ^ 1], NULL); // 将旧缓存指针置空
+    if (old_cache) {
+        if (old_cache->data) {
+            kfree(old_cache->data);
+        }
+        kfree(old_cache); // 释放旧缓存
+    }
+}
+
+static ssize_t debugfs_read_vm_data(struct file *file, char __user *buf,
+                          size_t len, loff_t *ppos)
+{
+    struct debugfs_cache *c;
+    int idx = atomic_read(&active_idx);
+    ssize_t ret = 0;
+
+    rcu_read_lock();
+    c = rcu_dereference(cache[idx]);
+    
+    if (!c || *ppos >= c->size) {
+        rcu_read_unlock();
+        return 0;
+    }
+
+    len = min_t(size_t, len, c->size - *ppos);
+    if (copy_to_user(buf, c->data + *ppos, len)) {
+        ret = -EFAULT;
+    } else {
+        *ppos += len;
+        ret = len;
+    }
+    
+    rcu_read_unlock();
+    return ret;
+}
+
+static const struct file_operations debugfs_fops = {
+    .read = debugfs_read_vm_data,
+    .mmap = NULL
+};
+
+static int __init amd_module_init(void) {
+    struct pci_dev *pdev = NULL;
+    for_each_pci_dev(pdev) {
+        unsigned short vendor_id = pdev->vendor;
+        if (vendor_id == VM_VENDOR_ID) {
+            vm_vendor = true;
+            vm_node_count++;
+        }
+        if (vendor_id == AMD_VENDOR_ID) {
+            amd_vendor = true;
+            amd_node_count++;
+        }
+    }
+
+    if (!amd_vendor && !vm_vendor) {
+        return 0;
+    }
+    statistics_node = debugfs_create_file("gpu_statistics", 0444, NULL, NULL, &debugfs_fops);
+    if(!statistics_node) {
+        pr_err("Failed to created gpu_statistics file");
+        return -ENOMEM;
+    }
+    update_workqueue = alloc_workqueue("update_workqueue", 0, 0);
+    INIT_WORK(&update_work, update_cache);
+        
+    hrtimer_init(&update_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+    update_timer.function = update_timer_callback;
+    update_interval = ktime_set(5, 0);
+    hrtimer_start(&update_timer, update_interval, HRTIMER_MODE_REL);
+
+    return 0;
+}
+
+static void __exit amd_module_exit(void) {
+    if (!amd_vendor && !vm_vendor) {
+        return;
+    }
+    hrtimer_cancel(&update_timer);
+    flush_workqueue(update_workqueue); // 等待工作队列完成
+    destroy_workqueue(update_workqueue);
+    synchronize_rcu();
+    debugfs_remove(statistics_node);
+    if (cache[0]) {
+        if (cache[0]->data) {
+            kfree(cache[0]->data);
+        }
+        kfree(cache[0]);
+    }
+    if (cache[1]) {
+        if (cache[1]->data) {
+            kfree(cache[1]->data);
+        }
+        kfree(cache[1]);
+    }
+}
+
+module_init(amd_module_init);
+module_exit(amd_module_exit);
+
+MODULE_LICENSE("GPL");
