+static int amdgpu_debugfs_gem_bo_statistics(int id, void *ptr, void *data)
+{
+	struct drm_gem_object *gobj = ptr;
+	struct amdgpu_bo *bo = gem_to_amdgpu_bo(gobj);
+	if (!bo->tbo.resource) {
+		printk("amdgpu_debugfs_gem_bo_statistics: bo->tbo.resource is null\n");
+		return 0;
+	}
+
+	struct gem_sizes *sizes = data;
+	struct dma_buf_attachment *attachment = READ_ONCE(bo->tbo.base.import_attach);
+	unsigned domain = amdgpu_mem_type_to_domain(bo->tbo.resource->mem_type);
+	unsigned long bo_size = amdgpu_bo_size(bo);
+
+	if (!attachment) {
+		switch (domain) {
+		case AMDGPU_GEM_DOMAIN_VRAM:
+			sizes->vram += bo_size;
+			break;
+		case AMDGPU_GEM_DOMAIN_GTT:
+			sizes->gtt += bo_size;
+			break;
+		case AMDGPU_GEM_DOMAIN_CPU:
+			sizes->cpu += bo_size;
+			break;
+		default:
+			sizes->others += bo_size;
+			break;
+		}
+		sizes->total += bo_size;
+	}
+	return 0;
+}
