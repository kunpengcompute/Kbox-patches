+/* 
+ * To implement the method for reading debugfs nodes, the 
+ * kernel_read function requires the debugfs node to 
+ * implement the read_iter method, but the corresponding 
+ * node lacks this method.
+ */ 
+static ssize_t debugfs_read(struct file *file, void *buf, size_t count, loff_t *pos) {
+    struct kvec iov = {
+        .iov_base       = buf,
+        .iov_len        = min_t(size_t, count, MAX_RW_COUNT),
+    };
+    struct kiocb kiocb;
+    struct iov_iter iter;
+    ssize_t ret;
+
+    init_sync_kiocb(&kiocb, file);
+    kiocb.ki_pos = pos ? *pos : 0;
+    iov_iter_kvec(&iter, READ, &iov, 1, iov.iov_len);
+    ret = seq_read_iter(&kiocb, &iter);
+    if (ret > 0 && pos) {
+        *pos = kiocb.ki_pos;
+    }
+    return ret;
+}
+
+static char *read_debugfs_to_buffer(char *path, int node) {
+    struct file *filp = NULL;
+    loff_t pos = 0;
+    ssize_t buffer_size = PAGE_SIZE;
+    ssize_t ret;
+    char *buf = NULL;
+    char *new_buf = NULL;
+
+    char filename[100];
+
+    snprintf(filename, 100, path, node);
+    filp = filp_open(filename, O_RDONLY, 0);
+    if (IS_ERR(filp)) {
+        return NULL;
+    }
+
+    buf = kmalloc(buffer_size, GFP_KERNEL);
+    if (!buf) {
+        pr_err("Failed to alloc buffer\n");
+        goto err_handle;
+    }
+
+    while (true) {
+        ret = debugfs_read(filp, buf, buffer_size - 1, &pos);
+        if (ret < 0) {
+            pr_err("Failed to read file: %zd\n", ret);
+            goto err_handle;
+        } else if (ret == 0) {
+            break;
+        }
+
+        if (ret < buffer_size - 1) {
+            break;
+        }
+
+        buffer_size *= 2;
+        pos = 0;
+        new_buf = krealloc(buf, buffer_size, GFP_KERNEL);
+        if (!new_buf) {
+            pr_err("Failed to realloc buffer\n");
+            goto err_handle;
+        }
+        buf = new_buf;
+    }
+
+    buf[ret] = '\0';
+    filp_close(filp, NULL);
+    return buf;
+
+err_handle:
+    kfree(buf);
+    if (filp) {
+      filp_close(filp, NULL);
+    }
+    return NULL;
+}
