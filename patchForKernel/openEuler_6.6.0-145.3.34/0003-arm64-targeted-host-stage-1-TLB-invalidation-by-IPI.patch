+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ASM_TLBI_IPI_H
+#define __ASM_TLBI_IPI_H
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+struct mm_struct;
+
+/* Bit values follow the OLK-6.6 disable_tlbflush_is= flags. */
+#define ARM64_TLBI_IPI_RANGE	0x01
+#define ARM64_TLBI_IPI_PAGE	0x02
+#define ARM64_TLBI_IPI_SWITCH	0x04
+#define ARM64_TLBI_IPI_MM	0x08
+#define ARM64_TLBI_IPI_LAZY	0x10
+/* Test only, deliberately unsafe: flush the calling CPU alone (negative control). */
+#define ARM64_TLBI_IPI_BROKEN	0x80
+
+#ifdef CONFIG_ARM64_TLBI_IPI
+extern unsigned int arm64_tlbi_ipi_flags;
+
+static __always_inline bool arm64_tlbi_ipi_test(unsigned int flag)
+{
+	return unlikely(READ_ONCE(arm64_tlbi_ipi_flags) & flag);
+}
+
+bool arm64_tlbi_ipi_mm(struct mm_struct *mm);
+bool arm64_tlbi_ipi_page(struct mm_struct *mm, unsigned long uaddr);
+bool arm64_tlbi_ipi_range(struct mm_struct *mm, unsigned long start,
+			  unsigned long pages, unsigned long stride,
+			  bool last_level, int tlb_level);
+void arm64_tlbi_ipi_new_asid(struct mm_struct *mm);
+void arm64_tlbi_ipi_track(struct mm_struct *mm);
+void arm64_tlbi_ipi_switch_out(struct mm_struct *prev);
+void arm64_tlbi_ipi_enter_lazy(struct mm_struct *mm);
+#else
+static inline bool arm64_tlbi_ipi_test(unsigned int flag) { return false; }
+static inline bool arm64_tlbi_ipi_mm(struct mm_struct *mm) { return false; }
+static inline bool arm64_tlbi_ipi_page(struct mm_struct *mm, unsigned long uaddr)
+{
+	return false;
+}
+static inline bool arm64_tlbi_ipi_range(struct mm_struct *mm, unsigned long start,
+					unsigned long pages, unsigned long stride,
+					bool last_level, int tlb_level)
+{
+	return false;
+}
+#endif
+#endif
