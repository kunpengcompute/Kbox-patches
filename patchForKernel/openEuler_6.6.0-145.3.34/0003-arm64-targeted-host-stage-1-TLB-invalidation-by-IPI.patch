diff --git a/arch/arm64/mm/tlbi-ipi.c b/arch/arm64/mm/tlbi-ipi.c
new file mode 100644
index 0000000..f07cf9a
--- /dev/null
+++ b/arch/arm64/mm/tlbi-ipi.c
@@ -0,0 +1,324 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * cubesandbox-v2 experiment: targeted host stage-1 TLB invalidation.
+ *
+ * Follows the OLK-6.6 "tlbi: Do not force the broadcasting of TLBI" patch
+ * (FUJITSU).  CPUs without DVM broadcast filtering pay a system-wide cost for
+ * every TLBI ...IS; when enabled, user-ASID page/range/mm flushes instead run
+ * local TLBIs, by synchronous IPI, on the CPUs in mm_cpumask().
+ *
+ * mm_cpumask() holds every CPU that may have TLB entries for the current
+ * ASID of the mm.  A CPU sets its bit before it can use the ASID
+ * (check_and_switch_context()); only the CPU itself clears it, after it has
+ * stopped using the ASID and invalidated it locally (switch and lazy modes).
+ * A newly allocated ASID starts with an empty mask: entries tagged with the
+ * old one are removed by the rollover flush before that ASID is reused.
+ * Tracking is always on, so the flags can be changed at runtime.
+ */
+#include <linux/cpumask.h>
+#include <linux/init.h>
+#include <linux/iommu.h>
+#include <linux/irqflags.h>
+#include <linux/moduleparam.h>
+#include <linux/percpu.h>
+#include <linux/smp.h>
+#include <linux/string.h>
+#include <asm/mmu_context.h>
+#include <asm/tlbflush.h>
+#include <asm/virt.h>
+
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "arm64_tlbi_ipi."
+
+unsigned int arm64_tlbi_ipi_flags __read_mostly;
+
+/*
+ * Host only: the flags stay 0 unless the kernel runs at EL2 (VHE).  In a
+ * guest, IPIs trap to the hypervisor and HCR_EL2.FB upgrades the local TLBIs
+ * (including those of the switch and lazy exits) to broadcasts, so every
+ * mode would be slower than the plain broadcast it replaces.
+ */
+static bool flags_allowed(unsigned int flags)
+{
+	if (!flags || is_kernel_in_hyp_mode())
+		return true;
+	pr_warn_once("arm64_tlbi_ipi: not a VHE host, keeping broadcast TLBIs\n");
+	return false;
+}
+
+static int flags_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int flags;
+	int ret = kstrtouint(val, 0, &flags);
+
+	if (ret)
+		return ret;
+	if (!flags_allowed(flags))
+		return -EOPNOTSUPP;
+	WRITE_ONCE(arm64_tlbi_ipi_flags, flags);
+	return 0;
+}
+
+static const struct kernel_param_ops flags_ops = {
+	.set = flags_set,
+	.get = param_get_uint,
+};
+module_param_cb(flags, &flags_ops, &arm64_tlbi_ipi_flags, 0644);
+MODULE_PARM_DESC(flags, "0x1 range, 0x2 page, 0x4 switch, 0x8 mm, 0x10 lazy, 0x80 broken (test only)");
+static bool stats;
+module_param(stats, bool, 0644);
+MODULE_PARM_DESC(stats, "Count requests and targets");
+
+DEFINE_PER_CPU(struct mm_struct *, arm64_tlbi_ipi_lazy_mm);
+
+enum ipi_stat {
+	REQ_PAGE, REQ_RANGE, REQ_MM, TARGETS, SELF, FALLBACK,
+	TRACK, SWITCH_DROP, LAZY_DROP, LAZY_RELOAD, NR_IPI_STATS
+};
+
+static DEFINE_PER_CPU(u64 [NR_IPI_STATS], ipi_stats);
+static const char * const stat_names[] = {
+	"page", "range", "mm", "targets", "self", "fallback",
+	"track", "switch_drop", "lazy_drop", "lazy_reload"
+};
+
+static void count(enum ipi_stat stat, unsigned int n)
+{
+	if (READ_ONCE(stats))
+		this_cpu_add(ipi_stats[stat], n);
+}
+
+static int report_get(char *buf, const struct kernel_param *kp)
+{
+	int i, cpu, len = 0;
+
+	for (i = 0; i < NR_IPI_STATS; i++) {
+		u64 sum = 0;
+
+		for_each_possible_cpu(cpu)
+			sum += per_cpu(ipi_stats, cpu)[i];
+		len += sysfs_emit_at(buf, len, "%s%s=%llu", i ? " " : "",
+				     stat_names[i], sum);
+	}
+	return len + sysfs_emit_at(buf, len, "\n");
+}
+
+static const struct kernel_param_ops report_ops = { .get = report_get };
+module_param_cb(report, &report_ops, NULL, 0444);
+
+/* Compatible with the OLK-6.6 boot option: disable_tlbflush_is=range,page,switch,mm */
+static int __init disable_tlbflush_is_setup(char *str)
+{
+	static const char * const names[] = { "range", "page", "switch", "mm", "lazy" };
+	unsigned int flags = 0;
+	char *tok;
+	int i;
+
+	while ((tok = strsep(&str, ","))) {
+		for (i = 0; i < ARRAY_SIZE(names); i++)
+			if (!strcmp(tok, names[i]))
+				break;
+		if (i == ARRAY_SIZE(names)) {
+			pr_warn("disable_tlbflush_is: unknown flag '%s'\n", tok);
+			return 0;
+		}
+		flags |= 1U << i;
+	}
+	if (!flags_allowed(flags))
+		return 0;
+	arm64_tlbi_ipi_flags = flags;
+	pr_info("disable_tlbflush_is: flags 0x%x\n", flags);
+	return 0;
+}
+early_param("disable_tlbflush_is", disable_tlbflush_is_setup);
+
+static bool eligible(struct mm_struct *mm)
+{
+	/*
+	 * SMMU SVA with BTM snoops broadcast TLBIs on shared ASIDs, and
+	 * smp_call_function() must not wait with IRQs disabled.
+	 */
+	if (mm == &init_mm || mm_valid_pasid(mm) || irqs_disabled()) {
+		count(FALLBACK, 1);
+		return false;
+	}
+	/*
+	 * Publish the PTE update to the table walkers and order it before
+	 * mm_cpumask() is sampled.  Pairs with the dsb in arm64_tlbi_ipi_track():
+	 * either we see a joining CPU's bit or its walks see the new PTE.
+	 */
+	dsb(ish);
+	return true;
+}
+
+static void run(struct mm_struct *mm, smp_call_func_t func, void *info,
+		enum ipi_stat req)
+{
+	const struct cpumask *mask = mm_cpumask(mm);
+
+	if (READ_ONCE(stats)) {
+		count(req, 1);
+		count(TARGETS, cpumask_weight_and(mask, cpu_online_mask));
+		count(SELF, cpumask_test_cpu(raw_smp_processor_id(), mask));
+	}
+	if (arm64_tlbi_ipi_test(ARM64_TLBI_IPI_BROKEN)) {
+		/* Negative control for the stale-TLB tests: never use in production. */
+		preempt_disable();
+		if (cpumask_test_cpu(smp_processor_id(), mask)) {
+			unsigned long flags;
+
+			local_irq_save(flags);
+			func(info);
+			local_irq_restore(flags);
+		}
+		preempt_enable();
+		return;
+	}
+	on_each_cpu_mask(mask, func, info, true);
+}
+
+struct flush_args {
+	struct mm_struct *mm;
+	unsigned long start, pages, stride;
+	bool last_level;
+	int tlb_level;
+};
+
+/*
+ * The ASID is read on each target: a CPU in the mask is using (or used) the
+ * ASID it observed itself, which cannot be older than this read.
+ */
+static void ipi_flush_mm(void *info)
+{
+	unsigned long asid = __TLBI_VADDR(0, ASID((struct mm_struct *)info));
+
+	__tlbi(aside1, asid);
+	__tlbi_user(aside1, asid);
+	dsb(nsh);
+}
+
+static void ipi_flush_range(void *info)
+{
+	struct flush_args *a = info;
+	unsigned long asid = ASID(a->mm);
+
+	if (a->last_level)
+		__flush_tlb_range_op(vale1, a->start, a->pages, a->stride, asid,
+				     a->tlb_level, true);
+	else
+		__flush_tlb_range_op(vae1, a->start, a->pages, a->stride, asid,
+				     a->tlb_level, true);
+	dsb(nsh);
+}
+
+bool arm64_tlbi_ipi_mm(struct mm_struct *mm)
+{
+	if (!eligible(mm))
+		return false;
+	run(mm, ipi_flush_mm, mm, REQ_MM);
+	return true;
+}
+
+bool arm64_tlbi_ipi_page(struct mm_struct *mm, unsigned long uaddr)
+{
+	struct flush_args a = {
+		.mm = mm, .start = uaddr, .pages = 1, .stride = PAGE_SIZE,
+		.last_level = true, .tlb_level = 0,
+	};
+
+	if (!eligible(mm))
+		return false;
+	run(mm, ipi_flush_range, &a, REQ_PAGE);
+	return true;
+}
+
+bool arm64_tlbi_ipi_range(struct mm_struct *mm, unsigned long start,
+			  unsigned long pages, unsigned long stride,
+			  bool last_level, int tlb_level)
+{
+	struct flush_args a = {
+		.mm = mm, .start = start, .pages = pages, .stride = stride,
+		.last_level = last_level, .tlb_level = tlb_level,
+	};
+
+	if (!eligible(mm))
+		return false;
+	run(mm, ipi_flush_range, &a, REQ_RANGE);
+	return true;
+}
+
+/* new_context(): a fresh ASID, under cpu_asid_lock. */
+void arm64_tlbi_ipi_new_asid(struct mm_struct *mm)
+{
+	cpumask_clear(mm_cpumask(mm));
+	/* Before mm->context.id is published; fast-path joiners set bits after reading it. */
+	smp_wmb();
+}
+
+/* check_and_switch_context(), IRQs off: before the ASID is loaded. */
+void arm64_tlbi_ipi_track(struct mm_struct *mm)
+{
+	int cpu = smp_processor_id();
+
+	if (unlikely(__this_cpu_read(arm64_tlbi_ipi_lazy_mm))) {
+		if (__this_cpu_read(arm64_tlbi_ipi_lazy_mm) == mm)
+			count(LAZY_RELOAD, 1);
+		__this_cpu_write(arm64_tlbi_ipi_lazy_mm, NULL);
+	}
+	/* Test first: the mask cache line is shared by every CPU using the mm. */
+	if (cpumask_test_cpu(cpu, mm_cpumask(mm)))
+		return;
+	cpumask_set_cpu(cpu, mm_cpumask(mm));
+	/* Pairs with eligible(); a dsb, as table walks are not ordered by a dmb. */
+	dsb(ish);
+	count(TRACK, 1);
+}
+
+static void local_flush_asid(struct mm_struct *mm)
+{
+	unsigned long asid = __TLBI_VADDR(0, ASID(mm));
+
+	dsb(nshst);
+	__tlbi(aside1, asid);
+	__tlbi_user(aside1, asid);
+	dsb(nsh);
+}
+
+/* switch_mm(), after the next ASID is loaded: stop receiving flushes for prev. */
+void arm64_tlbi_ipi_switch_out(struct mm_struct *prev)
+{
+	int cpu = smp_processor_id();
+
+	if (prev == &init_mm || system_uses_ttbr0_pan() ||
+	    !cpumask_test_cpu(cpu, mm_cpumask(prev)))
+		return;
+	/*
+	 * Flushers that no longer see the bit skip this CPU; the prev ASID is
+	 * not in use here any more and is invalidated before it can be loaded
+	 * again.
+	 */
+	cpumask_clear_cpu(cpu, mm_cpumask(prev));
+	local_flush_asid(prev);
+	count(SWITCH_DROP, 1);
+}
+
+/*
+ * enter_lazy_tlb(): a kernel thread (or idle) keeps mm as active_mm.  Point
+ * TTBR0 at the reserved tables so no walk can allocate entries for the mm,
+ * then leave the mask: idle CPUs stop receiving flushes for it.  switch_mm()
+ * reloads the mm even if it is unchanged.
+ */
+void arm64_tlbi_ipi_enter_lazy(struct mm_struct *mm)
+{
+	int cpu = smp_processor_id();
+
+	if (mm == &init_mm || system_uses_ttbr0_pan() ||
+	    __this_cpu_read(arm64_tlbi_ipi_lazy_mm) == mm ||
+	    !cpumask_test_cpu(cpu, mm_cpumask(mm)))
+		return;
+	cpu_set_reserved_ttbr0();
+	__this_cpu_write(arm64_tlbi_ipi_lazy_mm, mm);
+	cpumask_clear_cpu(cpu, mm_cpumask(mm));
+	local_flush_asid(mm);
+	count(LAZY_DROP, 1);
+}
