+#ifdef CONFIG_KVM_ARM_TLBI_IPI
+/* Host callbacks establish global S2-before-S1 completion across targets. */
+void __kvm_tlb_flush_vmid_range_local_s2(struct kvm_s2_mmu *mmu,
+					 phys_addr_t start, unsigned long pages)
+{
+	struct tlb_inv_context cxt;
+
+	dsb(nshst);
+	__tlb_switch_to_guest(mmu, &cxt);
+	__flush_s2_tlb_range_op(ipas2e1, start, pages, PAGE_SIZE, 0);
+	dsb(nsh);
+	isb();
+	__tlb_switch_to_host(&cxt);
+}
+
+void __kvm_tlb_flush_vmid_local_s1(struct kvm_s2_mmu *mmu)
+{
+	struct tlb_inv_context cxt;
+
+	__tlb_switch_to_guest(mmu, &cxt);
+	__tlbi(vmalle1);
+	dsb(nsh);
+	isb();
+	__tlb_switch_to_host(&cxt);
+}
+
+void __kvm_tlb_flush_vmid_local(struct kvm_s2_mmu *mmu)
+{
+	struct tlb_inv_context cxt;
+
+	dsb(nshst);
+	__tlb_switch_to_guest(mmu, &cxt);
+	__tlbi(vmalls12e1);
+	dsb(nsh);
+	isb();
+	__tlb_switch_to_host(&cxt);
+}
+#endif
