+    /*
+     * madvise() returns EAGAIN if kernel resources, such as
+     * slab, are temporarily unavailable.
+     */
+    if (error == -ENOMEM)
+            error = -EAGAIN;
+    return error;
+}
+
+int madvise_set_anon_name(struct mm_struct *mm, unsigned long start,
+                         unsigned long len_in, const char *name)
+{
+    unsigned long end;
+    unsigned long len;
