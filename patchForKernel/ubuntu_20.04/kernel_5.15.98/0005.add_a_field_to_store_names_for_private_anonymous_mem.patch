+/* mmap_lock should be read-locked */
+static inline bool is_same_vma_anon_name(struct vm_area_struct *vma,
+                                        const char *name)
+{
+       const char *vma_name = vma_anon_name(vma);
+
+       /* either both NULL, or pointers to same string */
+       if (vma_name == name)
