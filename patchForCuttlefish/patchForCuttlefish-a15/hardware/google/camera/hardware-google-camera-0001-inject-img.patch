+bool EmulatedSensor::LoadPngImage(const char* directory) {
+  DIR* dir = opendir(directory);
+  if (dir == nullptr) {
+    ALOGE("%s: opendir failed for %s, errno=%d (%s)", __FUNCTION__,
+          directory, errno, strerror(errno));
+    return false;
+  }
+
+  std::string png_path;
+  struct dirent* entry;
+  while ((entry = readdir(dir)) != nullptr) {
+    const char* name = entry->d_name;
+    size_t len = strlen(name);
+    if (len > 4 && strcasecmp(name + len - 4, ".png") == 0) {
+      png_path = std::string(directory) + "/" + name;
+      break;
+    }
+  }
+  closedir(dir);
+
+  if (png_path.empty()) return false;
+
+  FILE* fp = fopen(png_path.c_str(), "rb");
+  if (fp == nullptr) {
+    ALOGE("%s: fopen failed for %s", __FUNCTION__, png_path.c_str());
+    return false;
+  }
+
+  png_byte header[8];
+  if (fread(header, 1, 8, fp) != 8 || png_sig_cmp(header, 0, 8)) {
+    ALOGE("%s: invalid PNG signature in %s", __FUNCTION__, png_path.c_str());
+    fclose(fp);
+    return false;
+  }
+
+  png_structp png_ptr =
+      png_create_read_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+  if (png_ptr == nullptr) {
+    fclose(fp);
+    return false;
+  }
+
+  png_infop info_ptr = png_create_info_struct(png_ptr);
+  if (info_ptr == nullptr) {
+    png_destroy_read_struct(&png_ptr, nullptr, nullptr);
+    fclose(fp);
+    return false;
+  }
+
+  if (setjmp(png_jmpbuf(png_ptr))) {
+    ALOGE("%s: libpng error during read of %s", __FUNCTION__, png_path.c_str());
+    png_destroy_read_struct(&png_ptr, &info_ptr, nullptr);
+    fclose(fp);
+    return false;
+  }
+
+  png_init_io(png_ptr, fp);
+  png_set_sig_bytes(png_ptr, 8);
+  png_read_info(png_ptr, info_ptr);
+
+  png_width_ = png_get_image_width(png_ptr, info_ptr);
+  png_height_ = png_get_image_height(png_ptr, info_ptr);
+  png_byte color_type = png_get_color_type(png_ptr, info_ptr);
+  png_byte bit_depth = png_get_bit_depth(png_ptr, info_ptr);
+
+  if (bit_depth == 16) png_set_strip_16(png_ptr);
+  if (color_type == PNG_COLOR_TYPE_PALETTE) png_set_palette_to_rgb(png_ptr);
+  if (color_type == PNG_COLOR_TYPE_GRAY && bit_depth < 8)
+    png_set_expand_gray_1_2_4_to_8(png_ptr);
+  if (png_get_valid(png_ptr, info_ptr, PNG_INFO_tRNS))
+    png_set_tRNS_to_alpha(png_ptr);
+  if (color_type == PNG_COLOR_TYPE_RGB || color_type == PNG_COLOR_TYPE_GRAY)
+    png_set_add_alpha(png_ptr, 0xFF, PNG_FILLER_AFTER);
+  if (color_type == PNG_COLOR_TYPE_GRAY ||
+      color_type == PNG_COLOR_TYPE_GRAY_ALPHA)
+    png_set_gray_to_rgb(png_ptr);
+
+  png_read_update_info(png_ptr, info_ptr);
+
+  size_t row_bytes = png_get_rowbytes(png_ptr, info_ptr);
+  png_image_buffer_.resize(png_height_ * row_bytes);
+
+  std::vector<png_bytep> row_pointers(png_height_);
+  for (uint32_t i = 0; i < png_height_; i++) {
+    row_pointers[i] = png_image_buffer_.data() + i * row_bytes;
+  }
+  png_read_image(png_ptr, row_pointers.data());
+
+  png_destroy_read_struct(&png_ptr, &info_ptr, nullptr);
+  fclose(fp);
+
+  png_loaded_ = true;
+  return true;
+}
+
+void EmulatedSensor::GetPngPixel(float u, float v, uint8_t* r, uint8_t* g,
+                                  uint8_t* b, uint8_t* a) {
+  if (png_width_ == 0 || png_height_ == 0) return;
+
+  u = std::max(0.0f, std::min(u, static_cast<float>(png_width_ - 1)));
+  v = std::max(0.0f, std::min(v, static_cast<float>(png_height_ - 1)));
+
+  uint32_t x0 = static_cast<uint32_t>(u);
+  uint32_t y0 = static_cast<uint32_t>(v);
+  uint32_t x1 = std::min(x0 + 1u, png_width_ - 1);
+  uint32_t y1 = std::min(y0 + 1u, png_height_ - 1);
+
+  float fx = u - x0;
+  float fy = v - y0;
+
+  size_t stride = png_width_ * 4;
+  const uint8_t* p00 = png_image_buffer_.data() + y0 * stride + x0 * 4;
+  const uint8_t* p10 = png_image_buffer_.data() + y0 * stride + x1 * 4;
+  const uint8_t* p01 = png_image_buffer_.data() + y1 * stride + x0 * 4;
+  const uint8_t* p11 = png_image_buffer_.data() + y1 * stride + x1 * 4;
+
+  *r = static_cast<uint8_t>(
+      (1.0f - fx) * (1.0f - fy) * p00[0] + fx * (1.0f - fy) * p10[0] +
+      (1.0f - fx) * fy * p01[0] + fx * fy * p11[0] + 0.5f);
+  *g = static_cast<uint8_t>(
+      (1.0f - fx) * (1.0f - fy) * p00[1] + fx * (1.0f - fy) * p10[1] +
+      (1.0f - fx) * fy * p01[1] + fx * fy * p11[1] + 0.5f);
+  *b = static_cast<uint8_t>(
+      (1.0f - fx) * (1.0f - fy) * p00[2] + fx * (1.0f - fy) * p10[2] +
+      (1.0f - fx) * fy * p01[2] + fx * fy * p11[2] + 0.5f);
+  *a = static_cast<uint8_t>(
+      (1.0f - fx) * (1.0f - fy) * p00[3] + fx * (1.0f - fy) * p10[3] +
+      (1.0f - fx) * fy * p01[3] + fx * fy * p11[3] + 0.5f);
+}
