diff --git a/envd/static_eth.sh b/envd/static_eth.sh
new file mode 100644
index 000000000..6da819023
--- /dev/null
+++ b/envd/static_eth.sh
@@ -0,0 +1,34 @@
+#!/system/bin/sh
+DEV=eth1
+TABLE=200
+i=0
+while [ $i -lt 12 ]; do
+    # 1) IP / 掩码 / 广播
+    if ! ip addr show dev $DEV 2>/dev/null | grep -q "169.254.0.21"; then
+        ip addr flush dev $DEV 2>/dev/null
+        ip addr add 169.254.0.21/30 broadcast 169.254.0.23 dev $DEV 2>/dev/null
+        ip link set $DEV up 2>/dev/null
+    fi
+    # 2) 自定义表内的链路路由
+    if ! ip route show table $TABLE 2>/dev/null | grep -q "169.254.0.20/30"; then
+        ip route add 169.254.0.20/30 dev $DEV scope link table $TABLE 2>/dev/null
+    fi
+    # 3) 自定义表内的默认网关
+    if ! ip route show table $TABLE 2>/dev/null | grep -q "default via 169.254.0.22"; then
+        ip route add default via 169.254.0.22 dev $DEV table $TABLE 2>/dev/null
+    fi
+    # 4) ip rule：源 .21 的流量查 table 200
+    if ! ip rule 2>/dev/null | grep -q "from 169.254.0.21 lookup $TABLE"; then
+        ip rule add from 169.254.0.21/32 lookup $TABLE 2>/dev/null
+    fi
+    i=$((i+1))
+    sleep 5
+done
+
+# 5) HTTP 代理：从内核命令行 androidboot.http_proxy=ip:port 读取
+#    若存在则写入 SettingsProvider，实现开机自配置
+#    实例启动时通过 --extra_kernel_cmdline="... androidboot.http_proxy=10.0.2.2:8080" 传入
+PROXY=$(getprop ro.boot.http_proxy)
+if [ -n "$PROXY" ]; then
+    settings put global http_proxy "$PROXY"
+fi
