diff --git a/shared/device.mk b/shared/device.mk
index f9107ffc6..47c955348 100644
--- a/shared/device.mk
+++ b/shared/device.mk
@@ -592,4 +592,18 @@ PRODUCT_CHECK_VENDOR_SEAPP_VIOLATIONS := true
 
 PRODUCT_CHECK_DEV_TYPE_VIOLATIONS := true
 
+# [ENVD_PACKAGING] envd 服务打包：将 envd 预编译二进制、init 脚本和
+# rc 配置文件安装到 vendor 分区，在系统启动完成后由 init 自动拉起
+PRODUCT_PACKAGES += envd
+PRODUCT_COPY_FILES += \
+    device/google/cuttlefish/envd/start-envd-init.sh:$(TARGET_COPY_OUT_VENDOR)/bin/start-envd-init.sh \
+    device/google/cuttlefish/envd/envd.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/envd.rc
+
+# [STATIC_ETH] 静态网络配置脚本和 init 服务，在 boot_completed 后由 init 自动拉起
+# 通过 ip 命令设置 eth1 的静态 IP 地址、路由表和策略路由
+# 放入 vendor 分区遵循通用系统镜像的路径约束要求
+PRODUCT_COPY_FILES += \
+    device/google/cuttlefish/envd/static_eth.sh:$(TARGET_COPY_OUT_VENDOR)/bin/static_eth.sh \
+    device/google/cuttlefish/envd/static_eth.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/static_eth.rc
+
 TARGET_BOARD_FASTBOOT_INFO_FILE = device/google/cuttlefish/shared/fastboot-info.txt
