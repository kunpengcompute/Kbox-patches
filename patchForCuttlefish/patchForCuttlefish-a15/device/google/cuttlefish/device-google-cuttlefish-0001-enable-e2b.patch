diff --git a/envd/envd.rc b/envd/envd.rc
new file mode 100644
index 000000000..7c8382b2b
--- /dev/null
+++ b/envd/envd.rc
@@ -0,0 +1,22 @@
+# [ENVD_PACKAGING] envd 服务 init 脚本
+# 在 post-fs-data 阶段创建 /data/e2b 目录结构，
+# 在 boot_completed 后以 root 身份拉起 envd 服务
+on post-fs-data
+    mkdir /data/e2b 0777 root root
+    mkdir /data/e2b/home 0777 root root
+    mkdir /data/e2b/run 0777 root root
+    mkdir /data/e2b/log 0777 root root
+    chmod 0777 /data/e2b
+    chmod 0777 /data/e2b/home
+    chmod 0777 /data/e2b/run
+    chmod 0777 /data/e2b/log
+
+service envd /system/bin/sh /vendor/bin/start-envd-init.sh
+    class late_start
+    user root
+    group root inet
+    seclabel u:r:su:s0
+    disabled
+
+on property:sys.boot_completed=1
+    start envd
diff --git a/envd/envd.te b/envd/envd.te
new file mode 100644
index 000000000..eaeaad006
--- /dev/null
+++ b/envd/envd.te
@@ -0,0 +1,6 @@
+# [ENVD_PACKAGING] envd 服务的 SELinux 类型定义
+# 声明 envd_exec 类型，标记 /vendor/bin/envd 为可执行文件
+type envd_exec, exec_type, vendor_file_type, file_type;
+
+# 允许 shell 对 envd 二进制文件执行 getattr，便于调试
+allow shell envd_exec:file getattr;
diff --git a/envd/start-envd-init.sh b/envd/start-envd-init.sh
new file mode 100644
index 000000000..9abcf832a
--- /dev/null
+++ b/envd/start-envd-init.sh
@@ -0,0 +1,21 @@
+#!/system/bin/sh
+# [ENVD_PACKAGING] envd 服务启动脚本
+# 由 init 通过 envd.rc 在 boot_completed 后调用，
+# 设置环境变量并启动 /vendor/bin/envd
+set -eu
+
+REMOTE_ROOT=/data/e2b
+PORT=49983
+IS_NOT_FC=false
+
+mkdir -p "$REMOTE_ROOT/home" "$REMOTE_ROOT/run" "$REMOTE_ROOT/log"
+chmod -R 777 "$REMOTE_ROOT" 2>/dev/null || true
+
+export E2B_HOME="$REMOTE_ROOT/home"
+export E2B_RUN_DIR="$REMOTE_ROOT/run"
+export E2B_FORWARD_DISABLED=true
+export E2B_SANDBOX=false
+
+cd /vendor/bin
+exec >> "$REMOTE_ROOT/log/envd.log" 2>&1
+exec /vendor/bin/envd -isnotfc="$IS_NOT_FC" -port="$PORT"
