From f9854dd8 Mon Sep 17 00:00:00 2001
From: kp-cvd-trim <kp@cuttlefish>
Date: Sun, 20 Jul 2026 00:00:00 +0800
Subject: [PATCH] trim webrtc signaling server and auto-exit

[PROCESS_TRIM] 禁用 WebRTC 信令服务。

diff --git a/host/frontend/webrtc/main.cpp b/host/frontend/webrtc/main.cpp
index b9564a9b9..bfcaef1c3 100644
--- a/host/frontend/webrtc/main.cpp
+++ b/host/frontend/webrtc/main.cpp
@@ -17,6 +17,8 @@
 #include <linux/input.h>
 
 #include <memory>
+#include <string>
+#include <thread>
 
 #include <android-base/logging.h>
 #include <android-base/strings.h>
@@ -384,6 +386,20 @@ int main(int argc, char** argv) {
     audio_handler->Start();
   }
   host_confui_server.Start();
+
+  // [PROCESS_TRIM] webrtc 进程在完成 socket 监听后自动退出。
+  // webrtc 仅在虚拟机启动阶段需要：保证所有 socket server（touch/keyboard/wayland）
+  // 在 crosvm 连接之前已处于监听状态，防止 crosvm 因 socket connect 阻塞。
+  // socket 监听就绪后，webrtc 立即退出；crosvm 的 connect 请求由内核 accept backlog
+  // 保证，写端关闭后 crosvm 非阻塞写会得到 EPIPE。
+  std::thread exit_detector([]() {
+    LOG(INFO) << "All socket servers are listening, auto-exiting webrtc "
+              << "process. Use 'adb connect localhost:<adb_host_port>' "
+              << "to connect after guest boots.";
+    std::exit(0);
+  });
+  exit_detector.detach();
+
   display_handler->Loop();
 
   return 0;
