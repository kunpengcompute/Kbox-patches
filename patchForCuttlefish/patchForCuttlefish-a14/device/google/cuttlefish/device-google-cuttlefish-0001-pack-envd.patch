From f9854dd87cb0c309157ccb065af1cc7d3ea20b09 Mon Sep 17 00:00:00 2001
From: envd-integration <envd@cuttlefish>
Date: Sun, 20 Jul 2026 00:00:00 +0800
Subject: [PATCH] envd service integration for android image

[ENVD_PACKAGING] Integrate envd service as a prebuilt vendor binary
into the Android system image. Includes:
- envd prebuilt arm64 binary (cc_prebuilt_binary)
- init rc script to create /data/e2b directories and launch envd
- SELinux type definition (envd_exec)
- startup shell script
- BoardConfig.mk sepolicy directory registration
- device.mk PRODUCT_PACKAGES and PRODUCT_COPY_FILES
- file_contexts SELinux labels

diff --git a/Android.bp b/Android.bp
index 3109bf3c9..2ea3209c0 100644
--- a/Android.bp
+++ b/Android.bp
@@ -193,3 +193,21 @@ filegroup {
     name: "cf_dtb",
     srcs: ["dtb.img"],
 }
+
+// [ENVD_PACKAGING] envd 预编译二进制（arm64 only），作为 vendor 分区预置服务
+// 由 shared/device.mk 中的 PRODUCT_PACKAGES 打包到系统镜像，
+// 通过 envd.rc init 脚本在系统启动完成后自动拉起
+cc_prebuilt_binary {
+    name: "envd",
+    arch: {
+        arm64: {
+            srcs: ["envd/envd-android-arm64"],
+        },
+    },
+    compile_multilib: "64",
+    vendor: true,
+    strip: {
+        none: true,
+    },
+    check_elf_files: false,
+}
diff --git a/envd/envd-android-arm64 b/envd/envd-android-arm64
new file mode 100644
index 000000000..0bd86a818
Binary files /dev/null and b/envd/envd-android-arm64 differ
diff --git a/envd/envd.rc b/envd/envd.rc
new file mode 100644
index 000000000..da7fba8cc
--- /dev/null
+++ b/envd/envd.rc
@@ -0,0 +1,22 @@
+# [ENVD_PACKAGING] envd 服务 init 脚本
+# 在 post-fs-data 阶段创建 /data/e2b 目录结构，
+# 在 boot_completed 后以 root 身份拉起 envd 服务
+on post-fs-data
+    mkdir /data/e2b 0777 root root
+    mkdir /data/e2b/home 0777 root root
+    mkdir /data/e2b/run 0777 root root
+    mkdir /data/e2b/log 0777 root root
+    chmod 0777 /data/e2b
+    chmod 0777 /data/e2b/home
+    chmod 0777 /data/e2b/run
+    chmod 0777 /data/e2b/log
+
+service envd /system/bin/sh /vendor/bin/start-envd-init.sh
+    class late_start
+    user root
+    group root inet
+    seclabel u:r:su:s0
+    disabled
+
+on property:sys.boot_completed=1
+    start envd
\ No newline at end of file
diff --git a/envd/envd.te b/envd/envd.te
new file mode 100644
index 000000000..eaeaad006
--- /dev/null
+++ b/envd/envd.te
@@ -0,0 +1,6 @@
+# [ENVD_PACKAGING] envd 服务的 SELinux 类型定义
+# 声明 envd_exec 类型，标记 /vendor/bin/envd 为可执行文件
+type envd_exec, exec_type, vendor_file_type, file_type;
+
+# 允许 shell 对 envd 二进制文件执行 getattr，便于调试
+allow shell envd_exec:file getattr;
diff --git a/envd/start-envd-init.sh b/envd/start-envd-init.sh
new file mode 100644
index 000000000..c1cafd986
--- /dev/null
+++ b/envd/start-envd-init.sh
@@ -0,0 +1,21 @@
+#!/system/bin/sh
+# [ENVD_PACKAGING] envd 服务启动脚本
+# 由 init 通过 envd.rc 在 boot_completed 后调用，
+# 设置环境变量并启动 /vendor/bin/envd
+set -eu
+
+REMOTE_ROOT=/data/e2b
+PORT=49983
+IS_NOT_FC=false
+
+mkdir -p "$REMOTE_ROOT/home" "$REMOTE_ROOT/run" "$REMOTE_ROOT/log"
+chmod -R 777 "$REMOTE_ROOT" 2>/dev/null || true
+
+export E2B_HOME="$REMOTE_ROOT/home"
+export E2B_RUN_DIR="$REMOTE_ROOT/run"
+export E2B_FORWARD_DISABLED=true
+export E2B_SANDBOX=false
+
+cd /vendor/bin
+exec >> "$REMOTE_ROOT/log/envd.log" 2>&1
+exec /vendor/bin/envd -isnotfc="$IS_NOT_FC" -port="$PORT"
\ No newline at end of file
diff --git a/shared/BoardConfig.mk b/shared/BoardConfig.mk
index 133454c9b..6ddcbf738 100644
--- a/shared/BoardConfig.mk
+++ b/shared/BoardConfig.mk
@@ -229,6 +229,7 @@ WIFI_DRIVER_FW_PATH_AP      := "/dev/null"
 # vendor sepolicy
 BOARD_VENDOR_SEPOLICY_DIRS += device/google/cuttlefish/shared/sepolicy/vendor
 BOARD_VENDOR_SEPOLICY_DIRS += device/google/cuttlefish/shared/sepolicy/vendor/google
+BOARD_VENDOR_SEPOLICY_DIRS += device/google/cuttlefish/envd
 
 BOARD_SEPOLICY_DIRS += system/bt/vendor_libs/linux/sepolicy
 
diff --git a/shared/device.mk b/shared/device.mk
index d860dda51..a522bf368 100644
--- a/shared/device.mk
+++ b/shared/device.mk
@@ -701,5 +702,12 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     android.hardware.cas-service.example
 
+# [ENVD_PACKAGING] envd 服务打包：将 envd 预编译二进制、init 脚本和
+# rc 配置文件安装到 vendor 分区，在系统启动完成后由 init 自动拉起
+PRODUCT_PACKAGES += envd
+PRODUCT_COPY_FILES += \
+    device/google/cuttlefish/envd/start-envd-init.sh:$(TARGET_COPY_OUT_VENDOR)/bin/start-envd-init.sh \
+    device/google/cuttlefish/envd/envd.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/envd.rc
+
 PRODUCT_COPY_FILES += \
     device/google/cuttlefish/shared/config/pci.ids:$(TARGET_COPY_OUT_VENDOR)/pci.ids
diff --git a/shared/sepolicy/vendor/file_contexts b/shared/sepolicy/vendor/file_contexts
index 0d9468773..d7418ee73 100644
--- a/shared/sepolicy/vendor/file_contexts
+++ b/shared/sepolicy/vendor/file_contexts
@@ -62,6 +62,9 @@
 /vendor/bin/cuttlefish_sensor_injection   u:object_r:cuttlefish_sensor_injection_exec:s0
 /vendor/bin/mac80211_create_radios u:object_r:mac80211_create_radios_exec:s0
 /vendor/bin/socket_vsock_proxy  u:object_r:socket_vsock_proxy_exec:s0
+# [ENVD_PACKAGING] envd 服务的 SELinux 文件上下文标记
+/vendor/bin/envd  u:object_r:envd_exec:s0
+/vendor/bin/start-envd-init.sh  u:object_r:vendor_configs_file:s0
 /vendor/bin/vsoc_input_service  u:object_r:vsoc_input_service_exec:s0
 /vendor/bin/rename_netiface  u:object_r:rename_netiface_exec:s0
 /vendor/bin/suspend_blocker  u:object_r:suspend_blocker_exec:s0
