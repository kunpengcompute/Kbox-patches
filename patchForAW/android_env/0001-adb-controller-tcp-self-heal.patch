+          subprocess.run(
+              [self._config.adb_path, 'connect', self._config.device_name],
+              stdin=subprocess.DEVNULL,
+              capture_output=True,
+              timeout=30,
+          )
+          time.sleep(1.0)
 
     raise errors.AdbControllerError(
         f'Error executing adb command: [{command_str}]\n'
