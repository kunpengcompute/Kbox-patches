@@ -24,6 +24,23 @@ from android_env.components import config_classes
 from android_env.components import errors
 
 
+def _is_disconnection(message: str) -> bool:
+  """Returns True if the message indicates an adb connection loss.
+
+  TCP devices (reached via `adb connect`) can drop transiently, e.g. when a
+  sandbox network is being re-configured; these errors are recoverable by
+  reconnecting, unlike genuine command failures.
+  """
+  lowered = message.lower()
+  return (
+      'device not found' in lowered
+      or 'device offline' in lowered
+      or 'connection refused' in lowered
+      or 'connection reset' in lowered
+      or 'connection closed' in lowered
+  )
+
+
 class AdbController:
   """Manages communication with adb."""
 
@@ -99,6 +116,12 @@ class AdbController:
   ) -> bytes:
     """Executes an adb command.
 
+    On failure the adb server is left untouched: killing the server would
+    sever every TCP device connection (e.g. redroid sandboxes reached via
+    `adb connect`), turning a legitimate command failure into a total
+    connectivity loss. If the failure indicates a disconnection, the device
+    is reconnected and the command retried; other failures raise immediately.
+
     Args:
       args: A list of strings representing each adb argument.
           For example: ['install', '/my/app.apk']
@@ -122,6 +145,7 @@ class AdbController:
         cmd_output = subprocess.check_output(
             command,
             stderr=subprocess.STDOUT,
+            stdin=subprocess.DEVNULL,
             timeout=timeout,
