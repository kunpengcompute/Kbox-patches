+def register_activity_mapping(overrides: dict[str, str]) -> None:
+  """Merges activity overrides into the default app-name-to-activity mapping.
+
+  Overrides take precedence over the defaults. Intended for device bases
+  (e.g. AOSP images) whose apps live under different packages/activities than
+  the stock Google apps assumed by the defaults.
+  """
+  global _PATTERN_TO_ACTIVITY  # pylint: disable=global-statement
+  _ACTIVITY_OVERRIDES.update(overrides)
+  _PATTERN_TO_ACTIVITY = immutabledict.immutabledict(
