@@ -0,0 +1,132 @@
+"""通用 LLM 封装：把任意 OpenAI 兼容端点接到官方 infer 抽象接口上。
+
+官方 agent（t3a / m3a 等）只认 `android_world.agents.infer` 里的两个抽象接口：
+    - LlmWrapper.predict(text_prompt)              （T3A 用，纯文本）
+    - MultimodalLlmWrapper.predict_mm(text, imgs)  （M3A 用，带截图）
+本模块按 OpenAI 兼容的 chat/completions 协议实现这两个接口，其余与官方
+Gpt4Wrapper 同构：一样的返回值形状（text, is_safe, raw_response）、一样的重试策略。
+这样 t3a.T3A(env, OpenAiCompatLlm()) / m3a.M3A(env, OpenAiCompatLlm()) 即可直接用。
+
+端点与模型全部由调用方指定，本模块不内置任何厂商默认值；任何提供 OpenAI 兼容
+chat/completions 的服务都可接入：
+    AW_LLM_API_KEY   必填，API key
+    AW_LLM_BASE_URL  必填，端点根地址（不要带 /chat/completions 后缀）
+    AW_LLM_MODEL     必填，模型名
+    AW_LLM_EFFORT    可选，推理档位；不设置则不发送该字段，由服务端自定
+"""
+
+from __future__ import annotations
+
+import base64
+import os
+import time
+from typing import Any, Optional
+
+import numpy as np
+import requests
+
+from android_world.agents import infer
+
+
+class OpenAiCompatLlm(infer.LlmWrapper, infer.MultimodalLlmWrapper):
+  """OpenAI 兼容 chat/completions 的官方 LlmWrapper 实现。"""
+
+  RETRY_WAITING_SECONDS = 20
+
+  def __init__(
+      self,
+      model_name: str | None = None,
+      api_key: str | None = None,
+      base_url: str | None = None,
+      max_retry: int = 3,
+      temperature: float = 0.0,
+      max_tokens: int = 2000,
+      reasoning_effort: str | None = None,
+  ):
+    self.api_key = api_key or os.environ.get('AW_LLM_API_KEY')
+    self.base_url = (base_url or os.environ.get('AW_LLM_BASE_URL') or '').rstrip('/')
+    self.model = model_name or os.environ.get('AW_LLM_MODEL')
+    missing = [
+        name
+        for name, value in (
+            ('AW_LLM_API_KEY', self.api_key),
+            ('AW_LLM_BASE_URL', self.base_url),
+            ('AW_LLM_MODEL', self.model),
+        )
+        if not value
+    ]
+    if missing:
+      raise RuntimeError(
+          '未设置 ' + '、'.join(missing) + '（这三个变量均为必填）。示例：\n'
+          '  export AW_LLM_API_KEY=<你的 API key>\n'
+          '  export AW_LLM_BASE_URL=<OpenAI 兼容端点的根地址>\n'
+          '  export AW_LLM_MODEL=<模型名>'
+      )
+    # 可选：不设置则不发送该字段，交由服务端决定默认档位。
+    self.reasoning_effort = reasoning_effort or os.environ.get('AW_LLM_EFFORT')
+    self.max_retry = min(max(max_retry, 1), 5)
+    self.temperature = temperature
+    self.max_tokens = max_tokens
+
+  @classmethod
+  def encode_image(cls, image: np.ndarray) -> str:
+    """与官方 Gpt4Wrapper 相同的 JPEG base64 编码（官方实现已返回 str）。"""
+    return infer.Gpt4Wrapper.encode_image(image)
+
+  def predict(
+      self, text_prompt: str
+  ) -> tuple[str, Optional[bool], Any]:
+    """纯文本调用（T3A 走这里）。"""
+    return self.predict_mm(text_prompt, [])
+
+  def predict_mm(
+      self, text_prompt: str, images: list[np.ndarray]
+  ) -> tuple[str, Optional[bool], Any]:
+    """带截图调用（M3A 走这里；需选择支持图像输入的模型）。"""
+    content: list[dict[str, Any]] = [{'type': 'text', 'text': text_prompt}]
+    for image in images:
+      content.append({
+          'type': 'image_url',
+          'image_url': {'url': f'data:image/jpeg;base64,{self.encode_image(image)}'},
+      })
+    payload = {
+        'model': self.model,
+        'temperature': self.temperature,
+        'max_tokens': self.max_tokens,
+    }
+    if self.reasoning_effort:
+      payload['reasoning_effort'] = self.reasoning_effort
+    payload['messages'] = [{'role': 'user', 'content': content}]
+    if len(content) == 1:  # 纯文本时退回字符串形式，兼容只认字符串的网关。
+      payload['messages'][0]['content'] = text_prompt
+
+    headers = {
+        'Content-Type': 'application/json',
+        'Authorization': f'Bearer {self.api_key}',
+    }
+
+    counter = self.max_retry
+    wait_seconds = self.RETRY_WAITING_SECONDS
+    while counter > 0:
+      try:
+        response = requests.post(
+            f'{self.base_url}/chat/completions',
+            headers=headers,
+            json=payload,
+            timeout=300,
+        )
+        if response.ok and 'choices' in response.json():
+          text = response.json()['choices'][0]['message'].get('content') or ''
+          if text:  # 推理模型可能把预算花在思维链上导致 content 为空，视为失败重试。
+            return text, None, response
+          print('LLM 返回空 content（可能被 max_tokens 截断），重试...')
+        else:
+          print(f'LLM API 报错: {response.text[:300]}')
+        time.sleep(wait_seconds)
+        wait_seconds *= 2
+      except Exception as e:  # pylint: disable=broad-exception-caught
+        time.sleep(wait_seconds)
+        wait_seconds *= 2
+        print(e)
+      counter -= 1
+    return infer.ERROR_CALLING_LLM, None, None
