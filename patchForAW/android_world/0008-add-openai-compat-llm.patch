+"""SeeAct 端点 shim：把官方 SeeAct 的 OpenAI 请求重定向到 AW_LLM_*。
+
+官方 SeeAct 不走 infer.LlmWrapper 抽象，而是自己调 seeact_utils.execute_openai_request()，
+那里把端点写死成 https://api.openai.com/v1/chat/completions 且只读 OPENAI_API_KEY，
+无法接入本底座的 AW_LLM_* 配置。这里做一次进程内替换：请求仍由官方 SeeAct 发起，
+只是端点、鉴权与模型名改由 AW_LLM_* 环境变量决定。
+
+只替换一个函数，不动官方源码；仅在 --agent_name=seeact 时由 redroid.run 调用 install()，
+其余 agent 路径完全不受影响。
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any
+
+import requests
+
+from android_world.agents import seeact_utils
+
+_TIMEOUT_SECONDS = 300
+
+
+def _execute_openai_request(
+    messages_payload: list[dict[str, Any]],
+    model: str | None = None,
+    temperature: float = 0.0,
+    max_tokens: int = 4096,
+) -> dict[str, Any]:
+  """与官方见签名一致的返回（response.json()），端点/密钥/模型取自 AW_LLM_*。
+
+  官方签名里的 model 参数被忽略：模型一律由 AW_LLM_MODEL 决定，避免 SeeAct
+  内部写死的 GPT 模型名被带到非 OpenAI 端点上。
+  """
+  del model  # 模型改由 AW_LLM_MODEL 决定
+  api_key = os.environ.get('AW_LLM_API_KEY')
+  base_url = (os.environ.get('AW_LLM_BASE_URL') or '').rstrip('/')
+  model_name = os.environ.get('AW_LLM_MODEL')
+  missing = [
+      name
+      for name, value in (
+          ('AW_LLM_API_KEY', api_key),
+          ('AW_LLM_BASE_URL', base_url),
+          ('AW_LLM_MODEL', model_name),
+      )
+      if not value
+  ]
+  if missing:
+    raise RuntimeError(
+        'SeeAct 需要设置 ' + '、'.join(missing) + '（与 redroid/openai_compat_llm 同一套变量）。'
+    )
+  response = requests.post(
+      f'{base_url}/chat/completions',
+      headers={
+          'Content-Type': 'application/json',
+          'Authorization': f'Bearer {api_key}',
+      },
+      json={
+          'model': model_name,
+          'messages': messages_payload,
+          'temperature': temperature,
+          'max_tokens': max_tokens,
+      },
+      timeout=_TIMEOUT_SECONDS,
+  )
+  return response.json()
+
+
+def install() -> None:
+  """进程内替换 seeact_utils.execute_openai_request（幂等，可重复调用）。"""
+  seeact_utils.execute_openai_request = _execute_openai_request
