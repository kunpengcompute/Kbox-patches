+  cleared = False
+  for db_path in _SMS_DB_PATHS:
+    try:
+      # The three statements must run in one sqlite3 session: .dbconfig
+      # trusted_schema on is only honored by the DELETEs issued afterwards
+      # (deleting from sms fires FTS triggers on the words virtual table).
+      adb_utils.issue_generic_request(
+          [
+              "shell",
+              f'sqlite3 {db_path} ".dbconfig trusted_schema on"'
+              ' "DELETE FROM sms;" "DELETE FROM threads;"',
+          ],
+          env,
+      )
+      remaining = (
+          adb_utils.issue_generic_request(
+              ["shell", f'sqlite3 {db_path} "SELECT count(*) FROM sms;"'], env
+          )
+          .generic.output.decode("utf-8", "replace")
+          .strip()
+      )
+      if remaining in ("0", ""):
+        cleared = True
+        break
+      logging.warning(
+          "SMS clear at %s left %s rows (stale history would fail"
+          " SimpleSmsResend)",
+          db_path,
+          remaining,
+      )
+    except Exception as exc:  # pylint: disable=broad-except
