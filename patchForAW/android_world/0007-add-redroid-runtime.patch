@@ -0,0 +1,117 @@
+"""redroid/AOSP 兼容补丁：修正官方 App/Activity 映射与底座实际版本不一致的问题。
+
+官方 android_world 面向 Google 版模拟器镜像：
+
+* clock / contacts / dialer / files 等一方 App 映射到 `com.google.android.*`，
+  而本底座是 AOSP redroid，只有 `com.android.*` 版本；
+* VLC 的启动 Activity 在新版本中从 `.gui.MainActivity` 换成了 `.StartActivity`
+  （旧入口不可导出，`am start` 会抛 SecurityException）；
+* Audio Recorder 的 `.app.welcome.WelcomeActivity` 同样不再导出，入口为
+  `.app.main.MainActivity`。
+
+本模块在运行时替换（只改内存中的映射表，官方源码不动）：
+
+1. `android_world.env.adb_utils._PATTERN_TO_ACTIVITY`：所有 `launch_app()` /
+   `close_app()` / 快照路径都走这张表；
+2. `android_world.task_evals.single.system._APP_NAME_TO_PACKAGE_NAME`：
+   `OpenAppTaskEval` 单独用这张表判定前台包名。
+
+AOSP 映射仅在“设备上确实存在 AOSP 版、且官方预期的 Google 版不存在”时启用，
+不影响真正带 Google 应用的底座。由 `redroid/env_factory.create_env()` 自动调用。
+"""
+
+from __future__ import annotations
+
+import re
+import subprocess
+
+from immutabledict import immutabledict
+
+from android_world.env import adb_utils
+
+# 官方映射（pattern -> Google 包）；仅当 Google 包缺失、AOSP 包存在时替换。
+_AOSP_OVERRIDES = {
+    'clock': (
+        'com.google.android.deskclock',
+        'com.android.deskclock/.DeskClock',
+    ),
+    'contacts': (
+        'com.google.android.contacts',
+        'com.android.contacts/.activities.PeopleActivity',
+    ),
+    'dialer|phone': (
+        'com.google.android.dialer',
+        'com.android.dialer/.main.impl.MainActivity',
+    ),
+    'files': (
+        'com.google.android.documentsui',
+        'com.android.documentsui/com.android.documentsui.files.FilesActivity',
+    ),
+}
+
+# App 自身版本差异导致的入口变更（与 Google/AOSP 无关）。
+_VERSION_OVERRIDES = {
+    'vlc|vlc app|vlc player': (
+        'org.videolan.vlc',
+        'org.videolan.vlc/.StartActivity',
+    ),
+    'audio recorder': (
+        'com.dimowner.audiorecorder',
+        'com.dimowner.audiorecorder/.app.main.MainActivity',
+    ),
+}
+
+
+def _installed_packages(serial: str, adb_path: str) -> frozenset[str]:
+  output = subprocess.run(
+      [adb_path, '-s', serial, 'shell', 'pm', 'list', 'packages'],
+      stdin=subprocess.DEVNULL,
+      capture_output=True,
+      text=True,
+      timeout=30,
+      check=False,
+  ).stdout
+  return frozenset(
+      line.removeprefix('package:').strip()
+      for line in output.splitlines()
+      if line.startswith('package:')
+  )
+
+
+def apply(installed: frozenset[str]) -> list[str]:
+  """按设备实际安装的包，替换官方映射表；返回生效的覆盖项说明。"""
+  overrides: dict[str, str] = {}
+
+  for pattern, (google_pkg, activity) in _AOSP_OVERRIDES.items():
+    aosp_pkg = activity.split('/')[0]
+    if google_pkg not in installed and aosp_pkg in installed:
+      overrides[pattern] = activity
+
+  for pattern, (pkg, activity) in _VERSION_OVERRIDES.items():
+    if pkg in installed:
+      overrides[pattern] = activity
+
+  if not overrides:
+    return []
+
+  adb_utils.register_activity_mapping(overrides)
+
+  # OpenAppTaskEval 用另一张「app_name -> 包名」表，需同步一方 App 的替换。
+  # 注意 pattern 可能是 `dialer|phone` 这样的正则，需按 app_name 逐一匹配。
+  from android_world.task_evals.single import system  # pylint: disable=import-outside-toplevel
+
+  package_overrides = {}
+  for app_name in system._APP_NAME_TO_PACKAGE_NAME:  # pylint: disable=protected-access
+    for pattern, activity in overrides.items():
+      if re.match(pattern.lower(), app_name.lower()):
+        package_overrides[app_name] = activity.split('/')[0]
+        break
+  if package_overrides:
+    system.register_package_mapping(package_overrides)
+
+  return [f'{name} -> {activity}' for name, activity in overrides.items()]
+
+
+def apply_for_device(serial: str, adb_path: str) -> list[str]:
+  """查询设备已安装包并应用兼容映射。"""
+  return apply(_installed_packages(serial, adb_path))
diff --git a/redroid/env_factory.py b/redroid/env_factory.py
new file mode 100644
index 0000000..0cbec36
--- /dev/null
+++ b/redroid/env_factory.py
@@ -0,0 +1,78 @@
+"""构建连接 cube/redroid 沙箱的 android_world 环境栈。
+
+环境栈（与官方 run.py 的区别：底层的 android_env 换成纯 adb 实现，
+无障碍树改用 UIAUTOMATOR 模式，不依赖 a11y forwarder APK 与模拟器 gRPC）：
+
+    AdbEnv (android_env.envs.adb_env)
+      └─ AndroidWorldController(a11y_method=UIAUTOMATOR)
+           └─ interface.AsyncAndroidEnv
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+
+from android_world.env import android_world_controller
+from android_world.env import interface
+from android_world.env.android_world_controller import A11yMethod
+from android_env.envs import adb_env
+from redroid import aosp_compat
+
+
+def resolve_adb_path(adb_path: str | None = None) -> str:
+  """返回可用的 adb 绝对路径（参数 > 环境变量 AW_ADB_PATH > PATH 查找）。"""
+  if adb_path:
+    return adb_path
+  env_path = os.environ.get('AW_ADB_PATH')
+  if env_path:
+    return env_path
+  found = shutil.which('adb')
+  if not found:
+    raise RuntimeError(
+        'adb 不在 PATH 中，请通过 --adb_path 或 AW_ADB_PATH 指定。'
+    )
+  return found
+
+
+def resolve_serial(serial: str | None = None) -> str:
+  """返回目标设备 serial（参数 > 环境变量 AW_ADB_SERIAL）。"""
+  serial = serial or os.environ.get('AW_ADB_SERIAL')
+  if not serial:
+    raise RuntimeError(
+        '未指定设备 serial，请通过 --serial 或 AW_ADB_SERIAL 指定（如 10.100.0.2:5555）。'
+    )
+  return serial
+
+
+def ensure_adb_connected(serial: str, adb_path: str) -> None:
+  """确保 adb 已连接目标设备（TCP 设备自动重连；幂等，失败静默）。"""
+  if ':' not in serial:  # USB / emulator-xxxx 之类，无需 connect。
+    return
+  subprocess.run(
+      [adb_path, 'connect', serial],
+      capture_output=True,
+      timeout=20,
+  )
+
+
+def create_env(
+    serial: str | None = None,
+    adb_path: str | None = None,
+    a11y_method: A11yMethod = A11yMethod.UIAUTOMATOR,
+) -> interface.AsyncEnv:
+  """创建连接指定 redroid 沙箱的 AsyncEnv。"""
+  serial = resolve_serial(serial)
+  adb_path = resolve_adb_path(adb_path)
+
+  ensure_adb_connected(serial, adb_path)
+  # 按设备实际安装的包，替换官方 Google App 映射（AOSP 版 / 新版本入口）。
+  # P6 清存储安全版已随 patch 进入官方源码，无需再打补丁。
+  aosp_compat.apply_for_device(serial, adb_path)
+
+  base = adb_env.AdbEnv(serial=serial, adb_path=adb_path)
+  controller = android_world_controller.AndroidWorldController(
+      base, a11y_method=a11y_method
+  )
+  return interface.AsyncAndroidEnv(controller)
