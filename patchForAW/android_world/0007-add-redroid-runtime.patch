--- /dev/null
+++ b/redroid/setup_apps.py
@@ -0,0 +1,263 @@
+"""安装 Android World 官方设备端 App（在官方 setup 基础上适配 redroid）。
+
+官方 run.py 在 `--perform_emulator_setup=True` 时做这件事：从 GCS 下载各用例需要的
+第三方 App、装进设备、做首次启动配置、保存 App 快照。本脚本把这一步原样搬到
+redroid 沙箱上，App 清单与安装/配置逻辑全部复用官方实现，仅做两处健壮性适配：
+
+1. 安装超时放宽到 5 分钟（VLC/OsmAnd 等大 APK 在 30s 内装不完）。
+2. 无 root 时（redroid production build）保存快照必然失败：官方实现会直接抛出
+   异常中止后续 App 的安装，这里改为**告警后继续**。任务初始化对缺失快照本身
+   是容错的（`TaskEval._initialize_apps` 只打印 warning），不影响跑用例，只是
+   多次跑同一个 App 的用例时不会自动清场。
+
+用法：
+  export AW_ADB_SERIAL=10.100.0.249:5555
+  .venv/bin/python -m redroid.setup_apps --list                       # 看可装哪些 App
+  .venv/bin/python -m redroid.setup_apps                              # 安装官方全量
+  .venv/bin/python -m redroid.setup_apps --apps markor vlc            # 只装指定 App
+  .venv/bin/python -m redroid.setup_apps --only-install               # 只装 APK，不做首次配置
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+
+from android_world.env import adb_utils
+from android_world.env.setup_device import apps as app_defs
+from android_world.env.setup_device import setup as setup_device
+from android_world.utils import app_snapshot
+from redroid import env_factory
+
+
+def _all_apps() -> tuple:
+  # 官方没有导出 App 清单常量，这里直接取模块内的 _APPS（仅用于 --list 与默认全量）。
+  return setup_device._APPS  # pylint: disable=protected-access
+
+
+def _patch_monkey_for_redroid() -> None:
+  """redroid 无物理按键，monkey 默认注入 syskeys 会以 251 退出。
+
+  官方有几个 App 的首次配置用 `adb shell monkey -p <pkg> ... 1` 启动应用
+  （audio recorder / joplin / vlc）。redroid 上该命令报
+  "SYS_KEYS has no physical keys but with factor 2.0%" 并返回 251，
+  被 AdbController 视为失败。加上 `--pct-syskeys 0` 即可正常启动。
+  """
+  original = adb_utils.issue_generic_request
+
+  def patched(args, env, timeout_sec=None):
+    if (
+        isinstance(args, (list, tuple))
+        and len(args) >= 2
+        and args[0] == 'shell'
+        and args[1] == 'monkey'
+        and '--pct-syskeys' not in args
+    ):
+      args = list(args)
+      args[2:2] = ['--pct-syskeys', '0']
+    return original(args, env, timeout_sec=timeout_sec)
+
+  adb_utils.issue_generic_request = patched
+
+
+def cmd_list() -> int:
+  for app_class in _all_apps():
+    kind = 'APK' if app_class.apk_names else '系统预装'
+    print(f'{app_class.app_name:24s} {app_class.__name__:24s} {kind}')
+  return 0
+
+
+# AOSP 一方 App 在 redroid 上首次启动会弹权限框；官方模拟器上用 Google 版
+# 时这些权限通常已预置。这里预授予，避免 Agent 把权限弹窗误当成目标界面。
+_AOSP_PERMISSIONS = {
+    'com.android.contacts': (
+        'android.permission.READ_CONTACTS',
+        'android.permission.WRITE_CONTACTS',
+        'android.permission.GET_ACCOUNTS',
+        'android.permission.POST_NOTIFICATIONS',
+    ),
+    'com.android.dialer': (
+        'android.permission.CALL_PHONE',
+        'android.permission.READ_PHONE_STATE',
+        'android.permission.READ_CALL_LOG',
+        'android.permission.WRITE_CALL_LOG',
+        'android.permission.POST_NOTIFICATIONS',
+    ),
+    'com.android.deskclock': ('android.permission.POST_NOTIFICATIONS',),
+}
+
+
+def _grant_aosp_permissions(env) -> None:
+  installed = set(adb_utils.get_all_package_names(env.controller.env))
+  for package, permissions in _AOSP_PERMISSIONS.items():
+    if package not in installed:
+      continue
+    for permission in permissions:
+      try:
+        adb_utils.grant_permissions(package, permission, env.controller)
+      except Exception:
+        pass  # 应用未声明该权限时 pm grant 会失败，忽略即可。
+
+
+def _install_apk(apk_name: str, env, timeout_sec: float) -> str:
+  """下载（有缓存则复用）并安装一个 APK，返回本地路径。
+
+  Android 14 默认拒绝安装 targetSdk < 23 的老 APK（如 clipper），
+  失败时用 `--bypass-low-target-sdk-block` 重试。
+  """
+  path = app_defs.download_app_data(apk_name)
+  try:
+    adb_utils.issue_generic_request(
+        ['install', '-r', path],
+        env.controller.env,
+        timeout_sec=timeout_sec,
+    )
+  except Exception:
+    adb_utils.issue_generic_request(
+        ['install', '-r', '--bypass-low-target-sdk-block', path],
+        env.controller.env,
+        timeout_sec=timeout_sec,
+    )
+  return path
+
+
+def _install_app(app, env, timeout_sec: float) -> str:
+  """安装单个 App；无 APK 的一方 App 直接跳过。"""
+  if not app.apk_names:
+    return '系统预装，跳过'
+
+  last_error = None
+  for apk_name in app.apk_names:
+    try:
+      _install_apk(apk_name, env, timeout_sec)
+      return f'已安装 {apk_name}'
+    except Exception as exc:  # 官方可能含多架构 APK，逐个尝试。
+      last_error = exc
+  raise RuntimeError(f'安装失败: {last_error}')
+
+
+def _setup_app(app, env) -> list[str]:
+  """执行首次启动配置并尽力保存快照，返回过程说明（不抛异常）。"""
+  notes = []
+  try:
+    app.setup(env)
+    notes.append('首次配置完成')
+  except Exception as exc:  # 官方实现只捕 ValueError，这里放宽以免中断全量安装。
+    notes.append(f'首次配置告警: {type(exc).__name__}: {exc}')
+  finally:
+    try:
+      adb_utils.press_home_button(env.controller)
+    except Exception:
+      pass
+
+  try:
+    app_snapshot.save_snapshot(app.app_name, env.controller)
+    notes.append('快照已保存')
+  except Exception as exc:
+    # redroid 无 root，无法读写 /data/data；任务初始化容忍快照缺失。
+    notes.append(f'快照跳过（需 root）: {type(exc).__name__}')
+  return notes
+
+
+def run(args: argparse.Namespace) -> int:
+  if args.apps:
+    app_list = []
+    for name in args.apps:
+      app_class = setup_device.get_app_mapping(name)
+      if app_class is None:
+        raise SystemExit(f'未知 App: {name}（--list 查看全部）')
+      app_list.append(app_class)
+  else:
+    app_list = list(_all_apps())
+
+  _patch_monkey_for_redroid()
+  env = env_factory.create_env(args.serial, args.adb_path)
+  failures = 0
+  try:
+    # 屏幕常亮，避免首次配置/后续用例执行中灭屏。
+    adb_utils.issue_generic_request(
+        ['shell', 'settings', 'put', 'system', 'screen_off_timeout', '2147483647'],
+        env.controller.env,
+    )
+    adb_utils.press_home_button(env.controller)
+    adb_utils.set_root_if_needed(env.controller.env)  # redroid 会提示不能 root，无妨。
+
+    print(f'[安装] 共 {len(app_list)} 个 App（APK 缓存: /tmp/android_world/app_data）')
+    for index, app in enumerate(app_list, 1):
+      print(f'\n[{index}/{len(app_list)}] {app.app_name} ({app.__class__.__name__})')
+      try:
+        install_note = _install_app(app, env, args.install_timeout)
+        print(f'  - {install_note}')
+      except Exception as exc:
+        failures += 1
+        print(f'  - 安装失败: {exc}')
+        continue
+
+      if args.only_install:
+        continue
+      for note in _setup_app(app, env):
+        print(f'  - {note}')
+
+    if not args.only_install:
+      _grant_aosp_permissions(env)
+
+    # 汇总：确认每个包确实在设备上。
+    installed = set(adb_utils.get_all_package_names(env.controller.env))
+    print('\n[汇总] App 安装状态:')
+    for app in app_list:
+      try:
+        if app.apk_names:
+          package = adb_utils.extract_package_name(
+              adb_utils.get_adb_activity(app.app_name)  # pyrefly: ignore[bad-argument-type]
+          )
+          status = 'OK' if package in installed else 'MISSING'
+        else:
+          status = '系统预装'
+      except Exception:
+        status = '未知'
+      print(f'  {app.app_name:24s} {status}')
+    if failures:
+      print(f'\n[完成] {failures} 个 App 安装失败，见上方日志。')
+      return 1
+    print('\n[完成] 全部成功。')
+    return 0
+  finally:
+    env.close()
+
+
+def _build_parser() -> argparse.ArgumentParser:
+  parser = argparse.ArgumentParser(
+      prog='python -m redroid.setup_apps',
+      description='安装 Android World 官方设备端 App 到 redroid 沙箱（复用官方实现）。',
+  )
+  parser.add_argument(
+      '--apps',
+      nargs='+',
+      help='只安装指定 App（按官方 app_name，如 markor / "simple sms messenger"）',
+  )
+  parser.add_argument(
+      '--list', action='store_true', help='列出官方可安装的 App 名称后退出'
+  )
+  parser.add_argument(
+      '--only-install', action='store_true', help='只安装 APK，跳过首次启动配置'
+  )
+  parser.add_argument(
+      '--install-timeout',
+      type=float,
+      default=300.0,
+      help='单个 APK 安装超时秒数（默认 300）',
+  )
+  parser.add_argument('--serial', help='adb serial，默认取环境变量 AW_ADB_SERIAL')
+  parser.add_argument('--adb_path', help='adb 路径，默认取环境变量 AW_ADB_PATH 或 PATH')
+  return parser
+
+
+def main() -> int:
+  args = _build_parser().parse_args()
+  if args.list:
+    return cmd_list()
+  return run(args)
+
+
+if __name__ == '__main__':
+  sys.exit(main())
