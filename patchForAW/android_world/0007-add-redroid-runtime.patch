index 0000000..0cbec36
--- /dev/null
+++ b/redroid/env_factory.py
@@ -0,0 +1,78 @@
+"""构建连接 cube/redroid 沙箱的 android_world 环境栈。
+
+环境栈（与官方 run.py 的区别：底层的 android_env 换成纯 adb 实现，
+无障碍树改用 UIAUTOMATOR 模式，不依赖 a11y forwarder APK 与模拟器 gRPC）：
+
+    AdbEnv (android_env.envs.adb_env)
+      └─ AndroidWorldController(a11y_method=UIAUTOMATOR)
+           └─ interface.AsyncAndroidEnv
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+
+from android_world.env import android_world_controller
+from android_world.env import interface
+from android_world.env.android_world_controller import A11yMethod
+from android_env.envs import adb_env
+from redroid import aosp_compat
+
+
+def resolve_adb_path(adb_path: str | None = None) -> str:
+  """返回可用的 adb 绝对路径（参数 > 环境变量 AW_ADB_PATH > PATH 查找）。"""
+  if adb_path:
+    return adb_path
+  env_path = os.environ.get('AW_ADB_PATH')
+  if env_path:
+    return env_path
+  found = shutil.which('adb')
+  if not found:
+    raise RuntimeError(
+        'adb 不在 PATH 中，请通过 --adb_path 或 AW_ADB_PATH 指定。'
+    )
+  return found
+
+
+def resolve_serial(serial: str | None = None) -> str:
+  """返回目标设备 serial（参数 > 环境变量 AW_ADB_SERIAL）。"""
+  serial = serial or os.environ.get('AW_ADB_SERIAL')
+  if not serial:
+    raise RuntimeError(
+        '未指定设备 serial，请通过 --serial 或 AW_ADB_SERIAL 指定（如 10.100.0.2:5555）。'
+    )
+  return serial
+
+
+def ensure_adb_connected(serial: str, adb_path: str) -> None:
+  """确保 adb 已连接目标设备（TCP 设备自动重连；幂等，失败静默）。"""
+  if ':' not in serial:  # USB / emulator-xxxx 之类，无需 connect。
+    return
+  subprocess.run(
+      [adb_path, 'connect', serial],
+      capture_output=True,
+      timeout=20,
+  )
+
+
+def create_env(
+    serial: str | None = None,
+    adb_path: str | None = None,
+    a11y_method: A11yMethod = A11yMethod.UIAUTOMATOR,
+) -> interface.AsyncEnv:
+  """创建连接指定 redroid 沙箱的 AsyncEnv。"""
+  serial = resolve_serial(serial)
+  adb_path = resolve_adb_path(adb_path)
+
+  ensure_adb_connected(serial, adb_path)
+  # 按设备实际安装的包，替换官方 Google App 映射（AOSP 版 / 新版本入口）。
+  # P6 清存储安全版已随 patch 进入官方源码，无需再打补丁。
+  aosp_compat.apply_for_device(serial, adb_path)
+
+  base = adb_env.AdbEnv(serial=serial, adb_path=adb_path)
+  controller = android_world_controller.AndroidWorldController(
+      base, a11y_method=a11y_method
+  )
+  return interface.AsyncAndroidEnv(controller)
