index 0000000..eab5188
--- /dev/null
+++ b/redroid/run.py
@@ -0,0 +1,365 @@
+"""run.py —— 在 cube + redroid 沙箱上运行 Android World 评测套件。
+
+本文件是 redroid 底座下的评测入口，CLI 与回显对齐官方 android_world/run.py
+（同名 flag、同款输出文案），差别只在三处：
+
+  1. 环境层：官方走 emulator（console 5554 / gRPC 8554），redroid 容器没有这两条
+     通路，这里换成纯 adb 的 AdbEnv（android_env/envs/adb_env.py），无障碍树固定
+     走 UIAUTOMATOR 模式。因此 --console_port / --perform_emulator_setup 保留以
+     兼容官方命令行，但对本底座无实际作用。
+  2. Agent 的 LLM：官方的 t3a_gpt4 / m3a_gpt4v / *_gemini_gcp 绑定具体厂商端点，
+     这里统一接 AW_LLM_* 的 OpenAI 兼容端点，故 --agent_name 取值收敛为
+     human_agent / random_agent / seeact / t3a / m3a。
+  3. 新增几个 redroid 必需的 flag：--serial（设备 serial，官方靠 `adb devices`
+     推断，容器场景不适用）、--list / --list_all（列出任务名，官方 run.py 无此能力）、
+     --max_steps 与 --demo_mode（扩展开关，缺省行为与官方一致）。
+
+其余全部复用官方实现：任务注册表、随机参数、suite 构建、episode 执行与判分
+（android_world.suite_utils），官方源码零修改。
+
+用法：
+  export AW_ADB_SERIAL=10.100.0.208:5555
+  .venv/bin/python -m redroid.run --list_all
+  .venv/bin/python -m redroid.run --tasks=CameraTakePhoto --agent_name=human_agent
+  .venv/bin/python -m redroid.run --tasks=A,B --agent_name=random_agent
+  .venv/bin/python -m redroid.run --suite_family=miniwob --agent_name=m3a
+  .venv/bin/python -m redroid.run --checkpoint_dir=runs/ckpt_AB --agent_name=random_agent
+"""
+
+from __future__ import annotations
+
+import math
+import os
+import sys
+from collections.abc import Sequence
+
+from absl import app
+from absl import flags
+from absl import logging
+from android_world import checkpointer as checkpointer_lib
+from android_world import constants
+from android_world import registry
+from android_world import suite_utils
+from android_world.agents import base_agent
+from android_world.agents import human_agent
+from android_world.agents import m3a
+from android_world.agents import random_agent
+from android_world.agents import seeact
+from android_world.agents import t3a
+from android_world.env import interface
+from redroid import env_factory
+from redroid import openai_compat_llm
+from redroid import seeact_compat
+
+logging.set_verbosity(logging.WARNING)
+
+# ---------------------------------------------------------------------------
+# Flags：以下 11 个与官方 run.py 逐字对齐（名字 / 类型 / 默认值 / help 文案）。
+# ---------------------------------------------------------------------------
+_ADB_PATH = flags.DEFINE_string(
+    'adb_path',
+    '',
+    'Path to adb. Fallback: $AW_ADB_PATH, then adb on PATH.',
+)
+_PERFORM_EMULATOR_SETUP = flags.DEFINE_boolean(
+    'perform_emulator_setup',
+    False,
+    'Whether to perform emulator setup. This must be done once and only once'
+    ' before running Android World. After an emulator is setup, this flag'
+    ' should always be False. (No-op on redroid: there is no emulator.)',
+)
+_DEVICE_CONSOLE_PORT = flags.DEFINE_integer(
+    'console_port',
+    5554,
+    'The console port of the running Android device. This can usually be'
+    ' retrieved by looking at the output of `adb devices`. In general, the'
+    ' first connected device is port 5554, the second is 5556, and'
+    ' so on. (Unused on redroid: the emulator console is absent.)',
+)
+
+_SUITE_FAMILY = flags.DEFINE_enum(
+    'suite_family',
+    registry.TaskRegistry.ANDROID_WORLD_FAMILY,
+    [
+        # Families from the paper.
+        registry.TaskRegistry.ANDROID_WORLD_FAMILY,
+        registry.TaskRegistry.MINIWOB_FAMILY_SUBSET,
+        # Other families for more testing.
+        registry.TaskRegistry.MINIWOB_FAMILY,
+        registry.TaskRegistry.ANDROID_FAMILY,
+        registry.TaskRegistry.INFORMATION_RETRIEVAL_FAMILY,
+    ],
+    'Suite family to run. See registry.py for more information.',
+)
+_TASK_RANDOM_SEED = flags.DEFINE_integer(
+    'task_random_seed', 30, 'Random seed for task randomness.'
+)
+
+_TASKS = flags.DEFINE_list(
+    'tasks',
+    None,
+    'List of specific tasks to run in the given suite family. If None, run all'
+    ' tasks in the suite family.',
+)
+_N_TASK_COMBINATIONS = flags.DEFINE_integer(
+    'n_task_combinations',
+    1,
+    'Number of task instances to run for each task template.',
+)
+
+_CHECKPOINT_DIR = flags.DEFINE_string(
+    'checkpoint_dir',
+    '',
+    'The directory to save checkpoints and resume evaluation from. If the'
+    ' directory contains existing checkpoint files, evaluation will resume from'
+    ' the latest checkpoint. If the directory is empty or does not exist, a new'
+    ' directory will be created.',
+)
+_OUTPUT_PATH = flags.DEFINE_string(
+    'output_path',
+    os.path.expanduser('~/android_world/runs'),
+    'The path to save results to if not resuming from a checkpoint is not'
+    ' provided.',
+)
+
+# Agent specific.
+_AGENT_NAME = flags.DEFINE_string(
+    'agent_name',
+    'm3a',
+    'Agent name. Available: human_agent / random_agent / seeact / t3a / m3a.'
+    ' The LLM-backed agents (t3a / m3a / seeact) read endpoint, key and model'
+    ' from the AW_LLM_* environment variables.',
+)
+
+_FIXED_TASK_SEED = flags.DEFINE_boolean(
+    'fixed_task_seed',
+    False,
+    'Whether to use the same task seed when running multiple task combinations'
+    ' (n_task_combinations > 1).',
+)
+
+# ---------------------------------------------------------------------------
+# Flags：redroid 扩展（官方 run.py 没有对应项）。
+# ---------------------------------------------------------------------------
+_SERIAL = flags.DEFINE_string(
+    'serial',
+    None,
+    'adb serial of the target redroid sandbox. Fallback: $AW_ADB_SERIAL.'
+    ' (redroid extension; official run.py infers the device via `adb devices`.)',
+)
+_LIST = flags.DEFINE_boolean(
+    'list',
+    False,
+    'List all task names of the --suite_family registry and exit.'
+    ' (redroid extension; official run.py has no such flag.)',
+)
+_LIST_ALL = flags.DEFINE_boolean(
+    'list_all',
+    False,
+    'List every task name across all 5 families (208 distinct tasks) and exit.'
+    ' (redroid extension; official run.py has no such flag.)',
+)
+_MAX_STEPS = flags.DEFINE_integer(
+    'max_steps',
+    None,
+    'Override the per-episode step budget (default: official complexity * 10).'
+    ' (redroid extension; official run.py has no such flag.)',
+)
+_DEMO_MODE = flags.DEFINE_boolean(
+    'demo_mode',
+    False,
+    'Show the goal as a notification and a running scoreboard on the device.'
+    ' (redroid extension; official run.py hard-codes this to False.)',
+)
+
+
+# MiniWoB is very lightweight and new screens/View Hierarchy load quickly.
+_MINIWOB_TRANSITION_PAUSE = 0.2
+
+# Additional guidelines for the MiniWob tasks.
+_MINIWOB_ADDITIONAL_GUIDELINES = [
+    (
+        'This task is running in a mock app, you must stay in this app and'
+        ' DO NOT use the `navigate_home` action.'
+    ),
+]
+
+
+def _get_agent(
+    env: interface.AsyncEnv,
+    family: str | None = None,
+) -> base_agent.EnvironmentInteractingAgent:
+  """Gets agent.
+
+  与官方 run.py 的差别：官方用 *_gpt4 / *_gemini_gcp 等后缀绑定厂商端点，这里统一
+  接 AW_LLM_* 的 OpenAI 兼容端点，故取值收敛为 human_agent / random_agent /
+  seeact / t3a / m3a。
+  """
+  print('Initializing agent...')
+  agent = None
+  if _AGENT_NAME.value == 'human_agent':
+    agent = human_agent.HumanAgent(env)
+  elif _AGENT_NAME.value == 'random_agent':
+    agent = random_agent.RandomAgent(env)
+  elif _AGENT_NAME.value == 'seeact':
+    # 官方 SeeAct 在 seeact_utils 里写死了 OpenAI 端点；先做一次进程内重定向，
+    # 使其端点/密钥/模型改由 AW_LLM_* 决定。
+    seeact_compat.install()
+    agent = seeact.SeeAct(env)
+  elif _AGENT_NAME.value == 't3a':
+    agent = t3a.T3A(env, openai_compat_llm.OpenAiCompatLlm())
+  elif _AGENT_NAME.value == 'm3a':
+    agent = m3a.M3A(env, openai_compat_llm.OpenAiCompatLlm())
+
+  if not agent:
+    raise ValueError(
+        f'Unknown agent: {_AGENT_NAME.value}'
+        ' (available: human_agent / random_agent / seeact / t3a / m3a)'
+    )
+
+  # 官方此处按 `agent.name in ['M3A', 'T3A', 'SeeAct']` 判断，但各 agent 构造时
+  # name 默认是空串，该条件恒为 False —— 官方注释里的 miniwob 附加 guidelines
+  # 实际从未生效。这里改为按能力探测，行为与官方注释的意图一致。
+  if (
+      family
+      and family.startswith('miniwob')
+      and hasattr(agent, 'set_task_guidelines')
+  ):
+    agent.set_task_guidelines(_MINIWOB_ADDITIONAL_GUIDELINES)
+  agent.name = _AGENT_NAME.value
+
+  return agent
+
+
+def _print_tasks() -> None:
+  """--list / --list_all：列出任务名后退出。
+
+  官方 run.py 没有列任务的 flag；这里新增。--list 跟随 --suite_family（缺省
+  android_world，即 android 91 + 信息检索 25 = 116 条）；--list_all 展开成
+  三个基本族（android / information_retrieval / miniwob），派生族只给计数摘要，
+  避免重复刷屏。
+  """
+  task_registry = registry.TaskRegistry()
+
+  if not _LIST_ALL.value:
+    names = sorted(task_registry.get_registry(family=_SUITE_FAMILY.value))
+    print(f'[{_SUITE_FAMILY.value}] {len(names)} tasks')
+    for name in names:
+      print(f'  {name}')
+    return
+
+  families = (
+      (registry.TaskRegistry.ANDROID_FAMILY, 'android'),
+      (registry.TaskRegistry.INFORMATION_RETRIEVAL_FAMILY, 'information_retrieval'),
+      (registry.TaskRegistry.MINIWOB_FAMILY, 'miniwob'),
+  )
+  distinct: set[str] = set()
+  for family, label in families:
+    names = sorted(task_registry.get_registry(family=family))
+    print(f'[{label}] {len(names)} tasks')
+    for name in names:
+      print(f'  {name}')
+    print()
+    distinct.update(names)
+
+  n_world = len(task_registry.get_registry(family=registry.TaskRegistry.ANDROID_WORLD_FAMILY))
+  n_android = len(task_registry.get_registry(family=registry.TaskRegistry.ANDROID_FAMILY))
+  n_ir = len(
+      task_registry.get_registry(family=registry.TaskRegistry.INFORMATION_RETRIEVAL_FAMILY)
+  )
+  n_subset = len(
+      task_registry.get_registry(family=registry.TaskRegistry.MINIWOB_FAMILY_SUBSET)
+  )
+  print(
+      f'[android_world] {n_world} tasks'
+      f' = android {n_android} + information_retrieval {n_ir} (names listed above)'
+  )
+  print(f'[miniwob_subset] {n_subset} tasks  ⊂ miniwob (names listed above)')
+  print(f'Total: 5 families, {len(distinct)} distinct tasks')
+
+
+def _count_passed(episodes: list[dict]) -> tuple[int, int]:
+  """统计通过数 / 计入数；异常中断（is_successful 为 NaN）的用例不计入分母。"""
+  passed = total = 0
+  for episode in episodes:
+    score = episode.get(constants.EpisodeConstants.IS_SUCCESSFUL)
+    if score is None or (isinstance(score, float) and math.isnan(score)):
+      continue
+    total += 1
+    if float(score) > 0.5:
+      passed += 1
+  return passed, total
+
+
+def _main() -> int:
+  """Runs eval suite and gets rewards back."""
+  if _PERFORM_EMULATOR_SETUP.value:
+    print(
+        '注意：redroid 容器没有模拟器，--perform_emulator_setup 无实际作用；'
+        '安装 App 请用 redroid/setup_apps。'
+    )
+
+  env = env_factory.create_env(
+      serial=_SERIAL.value, adb_path=_ADB_PATH.value or None
+  )
+  try:
+    n_task_combinations = _N_TASK_COMBINATIONS.value
+    task_registry = registry.TaskRegistry()
+    suite = suite_utils.create_suite(
+        task_registry.get_registry(family=_SUITE_FAMILY.value),
+        n_task_combinations=n_task_combinations,
+        seed=_TASK_RANDOM_SEED.value,
+        tasks=_TASKS.value,
+        use_identical_params=_FIXED_TASK_SEED.value,
+    )
+    suite.suite_family = _SUITE_FAMILY.value
+
+    agent = _get_agent(env, _SUITE_FAMILY.value)
+
+    if _SUITE_FAMILY.value.startswith('miniwob'):
+      # MiniWoB pages change quickly, don't need to wait for screen to stabilize.
+      agent.transition_pause = _MINIWOB_TRANSITION_PAUSE
+    else:
+      agent.transition_pause = None
+
+    if _CHECKPOINT_DIR.value:
+      checkpoint_dir = _CHECKPOINT_DIR.value
+    else:
+      checkpoint_dir = checkpointer_lib.create_run_directory(_OUTPUT_PATH.value)
+
+    if _MAX_STEPS.value:
+      # redroid 扩展：覆盖官方的 complexity * 10 步数预算。
+      suite_utils._allocate_step_budget = lambda _complexity: _MAX_STEPS.value  # pylint: disable=protected-access
+
+    print(
+        f'Starting eval with agent {_AGENT_NAME.value} and writing to'
+        f' {checkpoint_dir}'
+    )
+    episodes = suite_utils.run(
+        suite,
+        agent,
+        checkpointer=checkpointer_lib.IncrementalCheckpointer(checkpoint_dir),
+        demo_mode=_DEMO_MODE.value,
+    )
+    print(
+        f'Finished running agent {_AGENT_NAME.value} on {_SUITE_FAMILY.value}'
+        f' family. Wrote to {checkpoint_dir}.'
+    )
+  finally:
+    env.close()
+
+  passed, total = _count_passed(episodes)
+  print(f'Passed {passed}/{total}.')
+  return 0 if passed == total else 1
+
+
+def main(argv: Sequence[str]) -> None:
+  del argv
+  if _LIST.value or _LIST_ALL.value:
+    _print_tasks()
+    return
+  sys.exit(_main())
+
+
+if __name__ == '__main__':
+  app.run(main)
diff --git a/redroid/setup_apps.py b/redroid/setup_apps.py
new file mode 100644
index 0000000..df30937
--- /dev/null
+++ b/redroid/setup_apps.py
@@ -0,0 +1,263 @@
+"""安装 Android World 官方设备端 App（在官方 setup 基础上适配 redroid）。
+
+官方 run.py 在 `--perform_emulator_setup=True` 时做这件事：从 GCS 下载各用例需要的
+第三方 App、装进设备、做首次启动配置、保存 App 快照。本脚本把这一步原样搬到
+redroid 沙箱上，App 清单与安装/配置逻辑全部复用官方实现，仅做两处健壮性适配：
+
+1. 安装超时放宽到 5 分钟（VLC/OsmAnd 等大 APK 在 30s 内装不完）。
+2. 无 root 时（redroid production build）保存快照必然失败：官方实现会直接抛出
+   异常中止后续 App 的安装，这里改为**告警后继续**。任务初始化对缺失快照本身
+   是容错的（`TaskEval._initialize_apps` 只打印 warning），不影响跑用例，只是
+   多次跑同一个 App 的用例时不会自动清场。
+
+用法：
+  export AW_ADB_SERIAL=10.100.0.249:5555
+  .venv/bin/python -m redroid.setup_apps --list                       # 看可装哪些 App
+  .venv/bin/python -m redroid.setup_apps                              # 安装官方全量
+  .venv/bin/python -m redroid.setup_apps --apps markor vlc            # 只装指定 App
+  .venv/bin/python -m redroid.setup_apps --only-install               # 只装 APK，不做首次配置
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+
+from android_world.env import adb_utils
+from android_world.env.setup_device import apps as app_defs
+from android_world.env.setup_device import setup as setup_device
+from android_world.utils import app_snapshot
+from redroid import env_factory
+
+
+def _all_apps() -> tuple:
+  # 官方没有导出 App 清单常量，这里直接取模块内的 _APPS（仅用于 --list 与默认全量）。
+  return setup_device._APPS  # pylint: disable=protected-access
+
+
+def _patch_monkey_for_redroid() -> None:
+  """redroid 无物理按键，monkey 默认注入 syskeys 会以 251 退出。
+
+  官方有几个 App 的首次配置用 `adb shell monkey -p <pkg> ... 1` 启动应用
+  （audio recorder / joplin / vlc）。redroid 上该命令报
+  "SYS_KEYS has no physical keys but with factor 2.0%" 并返回 251，
+  被 AdbController 视为失败。加上 `--pct-syskeys 0` 即可正常启动。
+  """
+  original = adb_utils.issue_generic_request
+
+  def patched(args, env, timeout_sec=None):
+    if (
+        isinstance(args, (list, tuple))
+        and len(args) >= 2
+        and args[0] == 'shell'
+        and args[1] == 'monkey'
+        and '--pct-syskeys' not in args
+    ):
+      args = list(args)
+      args[2:2] = ['--pct-syskeys', '0']
+    return original(args, env, timeout_sec=timeout_sec)
+
+  adb_utils.issue_generic_request = patched
+
+
+def cmd_list() -> int:
+  for app_class in _all_apps():
+    kind = 'APK' if app_class.apk_names else '系统预装'
+    print(f'{app_class.app_name:24s} {app_class.__name__:24s} {kind}')
+  return 0
+
+
+# AOSP 一方 App 在 redroid 上首次启动会弹权限框；官方模拟器上用 Google 版
+# 时这些权限通常已预置。这里预授予，避免 Agent 把权限弹窗误当成目标界面。
+_AOSP_PERMISSIONS = {
+    'com.android.contacts': (
+        'android.permission.READ_CONTACTS',
+        'android.permission.WRITE_CONTACTS',
+        'android.permission.GET_ACCOUNTS',
+        'android.permission.POST_NOTIFICATIONS',
+    ),
+    'com.android.dialer': (
+        'android.permission.CALL_PHONE',
+        'android.permission.READ_PHONE_STATE',
+        'android.permission.READ_CALL_LOG',
+        'android.permission.WRITE_CALL_LOG',
+        'android.permission.POST_NOTIFICATIONS',
+    ),
+    'com.android.deskclock': ('android.permission.POST_NOTIFICATIONS',),
+}
+
+
+def _grant_aosp_permissions(env) -> None:
+  installed = set(adb_utils.get_all_package_names(env.controller.env))
+  for package, permissions in _AOSP_PERMISSIONS.items():
+    if package not in installed:
+      continue
+    for permission in permissions:
+      try:
+        adb_utils.grant_permissions(package, permission, env.controller)
+      except Exception:
+        pass  # 应用未声明该权限时 pm grant 会失败，忽略即可。
+
+
+def _install_apk(apk_name: str, env, timeout_sec: float) -> str:
+  """下载（有缓存则复用）并安装一个 APK，返回本地路径。
+
+  Android 14 默认拒绝安装 targetSdk < 23 的老 APK（如 clipper），
+  失败时用 `--bypass-low-target-sdk-block` 重试。
+  """
+  path = app_defs.download_app_data(apk_name)
+  try:
+    adb_utils.issue_generic_request(
+        ['install', '-r', path],
+        env.controller.env,
+        timeout_sec=timeout_sec,
+    )
+  except Exception:
+    adb_utils.issue_generic_request(
+        ['install', '-r', '--bypass-low-target-sdk-block', path],
+        env.controller.env,
+        timeout_sec=timeout_sec,
+    )
+  return path
+
+
+def _install_app(app, env, timeout_sec: float) -> str:
+  """安装单个 App；无 APK 的一方 App 直接跳过。"""
+  if not app.apk_names:
+    return '系统预装，跳过'
+
+  last_error = None
+  for apk_name in app.apk_names:
+    try:
+      _install_apk(apk_name, env, timeout_sec)
+      return f'已安装 {apk_name}'
+    except Exception as exc:  # 官方可能含多架构 APK，逐个尝试。
+      last_error = exc
+  raise RuntimeError(f'安装失败: {last_error}')
+
+
+def _setup_app(app, env) -> list[str]:
+  """执行首次启动配置并尽力保存快照，返回过程说明（不抛异常）。"""
+  notes = []
+  try:
+    app.setup(env)
+    notes.append('首次配置完成')
+  except Exception as exc:  # 官方实现只捕 ValueError，这里放宽以免中断全量安装。
+    notes.append(f'首次配置告警: {type(exc).__name__}: {exc}')
+  finally:
+    try:
+      adb_utils.press_home_button(env.controller)
+    except Exception:
+      pass
+
+  try:
+    app_snapshot.save_snapshot(app.app_name, env.controller)
+    notes.append('快照已保存')
+  except Exception as exc:
+    # redroid 无 root，无法读写 /data/data；任务初始化容忍快照缺失。
+    notes.append(f'快照跳过（需 root）: {type(exc).__name__}')
+  return notes
+
+
+def run(args: argparse.Namespace) -> int:
+  if args.apps:
+    app_list = []
+    for name in args.apps:
+      app_class = setup_device.get_app_mapping(name)
+      if app_class is None:
+        raise SystemExit(f'未知 App: {name}（--list 查看全部）')
+      app_list.append(app_class)
+  else:
+    app_list = list(_all_apps())
+
+  _patch_monkey_for_redroid()
+  env = env_factory.create_env(args.serial, args.adb_path)
+  failures = 0
+  try:
+    # 屏幕常亮，避免首次配置/后续用例执行中灭屏。
+    adb_utils.issue_generic_request(
+        ['shell', 'settings', 'put', 'system', 'screen_off_timeout', '2147483647'],
+        env.controller.env,
+    )
+    adb_utils.press_home_button(env.controller)
+    adb_utils.set_root_if_needed(env.controller.env)  # redroid 会提示不能 root，无妨。
+
+    print(f'[安装] 共 {len(app_list)} 个 App（APK 缓存: /tmp/android_world/app_data）')
+    for index, app in enumerate(app_list, 1):
+      print(f'\n[{index}/{len(app_list)}] {app.app_name} ({app.__class__.__name__})')
+      try:
+        install_note = _install_app(app, env, args.install_timeout)
+        print(f'  - {install_note}')
+      except Exception as exc:
+        failures += 1
+        print(f'  - 安装失败: {exc}')
+        continue
+
+      if args.only_install:
+        continue
+      for note in _setup_app(app, env):
+        print(f'  - {note}')
+
+    if not args.only_install:
+      _grant_aosp_permissions(env)
+
+    # 汇总：确认每个包确实在设备上。
+    installed = set(adb_utils.get_all_package_names(env.controller.env))
+    print('\n[汇总] App 安装状态:')
+    for app in app_list:
+      try:
+        if app.apk_names:
+          package = adb_utils.extract_package_name(
+              adb_utils.get_adb_activity(app.app_name)  # pyrefly: ignore[bad-argument-type]
+          )
+          status = 'OK' if package in installed else 'MISSING'
+        else:
+          status = '系统预装'
+      except Exception:
+        status = '未知'
+      print(f'  {app.app_name:24s} {status}')
+    if failures:
+      print(f'\n[完成] {failures} 个 App 安装失败，见上方日志。')
+      return 1
+    print('\n[完成] 全部成功。')
+    return 0
+  finally:
+    env.close()
+
+
+def _build_parser() -> argparse.ArgumentParser:
+  parser = argparse.ArgumentParser(
+      prog='python -m redroid.setup_apps',
+      description='安装 Android World 官方设备端 App 到 redroid 沙箱（复用官方实现）。',
+  )
+  parser.add_argument(
+      '--apps',
+      nargs='+',
+      help='只安装指定 App（按官方 app_name，如 markor / "simple sms messenger"）',
+  )
+  parser.add_argument(
+      '--list', action='store_true', help='列出官方可安装的 App 名称后退出'
+  )
+  parser.add_argument(
+      '--only-install', action='store_true', help='只安装 APK，跳过首次启动配置'
+  )
+  parser.add_argument(
+      '--install-timeout',
+      type=float,
+      default=300.0,
+      help='单个 APK 安装超时秒数（默认 300）',
+  )
+  parser.add_argument('--serial', help='adb serial，默认取环境变量 AW_ADB_SERIAL')
+  parser.add_argument('--adb_path', help='adb 路径，默认取环境变量 AW_ADB_PATH 或 PATH')
+  return parser
+
+
+def main() -> int:
+  args = _build_parser().parse_args()
+  if args.list:
+    return cmd_list()
+  return run(args)
+
+
+if __name__ == '__main__':
+  sys.exit(main())
