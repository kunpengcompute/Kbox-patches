diff --git a/redroid/run_suite.py b/redroid/run_suite.py
new file mode 100644
index 0000000..47cf6f9
--- /dev/null
+++ b/redroid/run_suite.py
@@ -0,0 +1,168 @@
+"""套件 runner：按官方 suite 语义在 cube + redroid 沙箱上批量跑用例。
+
+与 redroid/run_task.py 的分工：
+  run_task.py   一次跑一个（或逗号分隔的若干）用例，逐条落盘截图与 result.json，
+                适合冒烟、单点复现与人工验收；
+  run_suite.py  直接复用官方 android_world.suite_utils，支持「整族 / 指定多任务 /
+                每个用例多组随机参数 / 增量 checkpoint 断点续跑」，结果汇总表由官方
+                process_episodes 打印，适合批量评测。
+
+环境层与 agent 构造都复用 redroid.run_task，保证与单用例路径完全一致；官方源码零修改。
+
+用法：
+  export AW_ADB_SERIAL=10.100.0.2:5555
+  .venv/bin/python -m redroid.run_suite --suite_family=android_world --tasks=A,B --agent=random
+  .venv/bin/python -m redroid.run_suite --suite_family=android_world --n_task_combinations=2 --agent=t3a
+  .venv/bin/python -m redroid.run_suite --suite_family=miniwob --agent=m3a --demo_mode
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+
+from android_world import checkpointer as checkpointer_lib
+from android_world import registry
+from android_world import suite_utils
+from redroid import env_factory
+from redroid.run_task import build_agent
+
+_FAMILIES = (
+    registry.TaskRegistry.ANDROID_WORLD_FAMILY,
+    registry.TaskRegistry.ANDROID_FAMILY,
+    registry.TaskRegistry.MINIWOB_FAMILY,
+    registry.TaskRegistry.MINIWOB_FAMILY_SUBSET,
+    registry.TaskRegistry.INFORMATION_RETRIEVAL_FAMILY,
+)
+
+# 与官方 run.py 一致：MiniWoB 页面加载很快，不必等界面稳定。
+MINIWOB_TRANSITION_PAUSE = 0.2
+
+# MiniWoB 跑在 mock app 里，需额外约束 agent 不要退回桌面（官方同名常量）。
+MINIWOB_ADDITIONAL_GUIDELINES = [
+    (
+        'This task is running in a mock app, you must stay in this app and'
+        ' DO NOT use the `navigate_home` action.'
+    ),
+]
+
+
+def tune_agent(agent, family: str) -> None:
+  """对齐官方 run.py 的 agent 调优：miniwob 族用 0.2s 过渡 + 追加 guidelines，
+  其余族等界面稳定（None = 自动等待）。human/random 也照此设置，与官方一致。
+  """
+  if family.startswith('miniwob'):
+    agent.transition_pause = MINIWOB_TRANSITION_PAUSE
+    if hasattr(agent, 'set_task_guidelines'):
+      agent.set_task_guidelines(MINIWOB_ADDITIONAL_GUIDELINES)
+  else:
+    agent.transition_pause = None
+
+
+def _build_parser() -> argparse.ArgumentParser:
+  parser = argparse.ArgumentParser(
+      prog='python -m redroid.run_suite',
+      description=(
+          '套件 runner：在 cube + redroid 沙箱上按官方 suite 语义批量跑用例。'
+      ),
+  )
+  parser.add_argument(
+      '--suite_family',
+      default=registry.TaskRegistry.ANDROID_WORLD_FAMILY,
+      choices=_FAMILIES,
+      help='任务族，缺省 android_world（整族）；其余为 android / miniwob / miniwob_subset / information_retrieval',
+  )
+  parser.add_argument('--tasks', help='可选：只跑这些用例，逗号分隔，如 A,B；缺省跑整族')
+  parser.add_argument(
+      '--n_task_combinations',
+      type=int,
+      default=1,
+      help='每个用例生成几组不同随机参数（缺省 1）',
+  )
+  parser.add_argument(
+      '--task_random_seed', type=int, default=30, help='任务参数随机种子（缺省 30）'
+  )
+  parser.add_argument(
+      '--fixed_task_seed',
+      action='store_true',
+      help='每个用例的多组参数使用同一组（与官方同名 flag 语义一致）',
+  )
+  parser.add_argument(
+      '--agent',
+      default='random',
+      choices=('human', 'random', 'seeact', 't3a', 'm3a'),
+      help=(
+          'human=人工投屏操作；random=随机点击（默认，验证链路用）；'
+          'seeact=官方 SeeAct + AW_LLM_*；t3a=官方纯文本 agent + LLM；'
+          'm3a=官方多模态 agent + LLM'
+      ),
+  )
+  parser.add_argument('--output_path', default='runs', help='输出根目录（缺省 runs）')
+  parser.add_argument(
+      '--checkpoint_dir', help='检查点目录；缺省在 --output_path 下按时间戳新建'
+  )
+  parser.add_argument(
+      '--demo_mode',
+      action='store_true',
+      help='演示模式：每个用例开始时把目标以通知方式显示在设备上（与官方同名 flag 一致）',
+  )
+  parser.add_argument('--serial', help='adb serial，默认取环境变量 AW_ADB_SERIAL')
+  parser.add_argument('--adb_path', help='adb 路径，默认取环境变量 AW_ADB_PATH 或 PATH')
+  return parser
+
+
+def main() -> int:
+  args = _build_parser().parse_args()
+
+  tasks = None
+  if args.tasks:
+    tasks = [t.strip() for t in args.tasks.split(',') if t.strip()]
+    if not tasks:
+      print('--tasks 为空，请形如 --tasks=A,B')
+      return 2
+
+  env = env_factory.create_env(args.serial, args.adb_path)
+  try:
+    task_registry = registry.TaskRegistry()
+    try:
+      suite = suite_utils.create_suite(
+          task_registry.get_registry(family=args.suite_family),
+          n_task_combinations=args.n_task_combinations,
+          seed=args.task_random_seed,
+          tasks=tasks,
+          use_identical_params=args.fixed_task_seed,
+      )
+    except ValueError as exc:  # 任务名拼错 / 族名不支持
+      print(f'[错误] 套件构建失败: {exc}')
+      return 2
+    suite.suite_family = args.suite_family
+
+    instances = sum(len(v) for v in suite.values())
+    print(
+        f'套件: {args.suite_family}；用例数 {len(suite)}；实例总数 {instances}；'
+        f'每用例参数组数 {args.n_task_combinations}；agent {args.agent}'
+    )
+
+    agent = build_agent(args.agent, env)
+    agent.name = args.agent
+    tune_agent(agent, args.suite_family)
+
+    checkpoint_dir = args.checkpoint_dir or checkpointer_lib.create_run_directory(
+        args.output_path
+    )
+    print(f'检查点目录（中断后重跑同一目录即续跑）: {checkpoint_dir}')
+
+    suite_utils.run(
+        suite,
+        agent,
+        checkpointer=checkpointer_lib.IncrementalCheckpointer(checkpoint_dir),
+        demo_mode=args.demo_mode,
+    )
+    print(f'完成；逐用例结果与汇总表见上面的输出，检查点与结果文件在 {checkpoint_dir}')
+    return 0
+  finally:
+    env.close()
+
+
+if __name__ == '__main__':
+  sys.exit(main())
diff --git a/redroid/run_task.py b/redroid/run_task.py
new file mode 100644
index 0000000..3e6b3f3
--- /dev/null
+++ b/redroid/run_task.py
@@ -0,0 +1,358 @@
+"""最小任务 runner：在 cube + redroid 沙箱上运行 Android World 测试用例。
+
+与官方 run.py 只差环境层：redroid 没有模拟器 console(5554)/gRPC(8554)，
+底层换成纯 adb 的 AdbEnv（android_env/envs/adb_env.py），无障碍树走 UIAUTOMATOR 模式。
+任务注册表、随机参数、初始化与判定（is_successful）全部复用官方 android_world 实现。
+SMS/Phone 用例另在 init 前注入底座适配补丁（清库 / 收信注入，与 manual_task.py
+共用实现），官方源码零修改。
+
+支持一次跑多个用例：--task=A,B,C（或 --tasks=A,B,C）。多个用例复用同一个环境与
+agent，每个用例开始前先复位桌面并清空 agent 历史，全部结束后打印逐条结果与汇总，
+并写 summary.json；只要有用例没通过，退出码就是 1，便于在 CI 里串联。
+加 --checkpoint_dir 可断点续跑：每跑完一个用例就落一份检查点，用同一目录重跑时
+跳过已完成的、只补未完成的；需要「整族 / 每模板多组参数」时用 redroid/run_suite.py。
+
+用法：
+  export AW_ADB_SERIAL=10.100.0.2:5555
+  .venv/bin/python -m redroid.run_task --list                    # 列出全部任务名
+  .venv/bin/python -m redroid.run_task --task=CameraTakePhoto --agent=human
+  .venv/bin/python -m redroid.run_task --task=SystemWifiTurnOn,SystemWifiTurnOff --agent=random
+  .venv/bin/python -m redroid.run_task --task=A,B --agent=m3a --checkpoint_dir=runs/ckpt_AB
+
+--agent 取值：human=人工投屏；random=随机点击（验证链路）；t3a/m3a=官方 agent +
+OpenAI 兼容 LLM；seeact=官方 SeeAct（端点、鉴权、模型名由 AW_LLM_* 决定）。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import random
+import sys
+import traceback
+from datetime import datetime
+
+import cv2
+
+from android_world import checkpointer as checkpointer_lib
+from android_world import registry
+from android_world.agents import human_agent
+from android_world.agents import m3a
+from android_world.agents import random_agent
+from android_world.agents import seeact
+from android_world.agents import t3a
+from android_world.task_evals import task_eval
+from redroid import env_factory
+from redroid import openai_compat_llm
+from redroid import seeact_compat
+
+_RESULT_JSON = 'result.json'
+_SUMMARY_JSON = 'summary.json'
+
+
+def _get_task_class(task_name: str) -> type[task_eval.TaskEval]:
+  task_registry = registry.TaskRegistry().ANDROID_TASK_REGISTRY
+  if task_name not in task_registry:
+    close = [n for n in sorted(task_registry) if task_name.lower() in n.lower()]
+    msg = f'未知任务: {task_name}'
+    if close:
+      msg += f'\n你是不是想找: {", ".join(close[:10])}'
+    msg += '\n用 --list 查看全部可用任务。'
+    raise SystemExit(msg)
+  return task_registry[task_name]
+
+
+def build_agent(agent_name: str, env):
+  """构造 agent；t3a/m3a 接 OpenAI 兼容 LLM，seeact 走端点重定向（均需 AW_LLM_*）。"""
+  if agent_name == 'human':
+    return human_agent.HumanAgent(env)
+  if agent_name == 'random':
+    return random_agent.RandomAgent(env)
+  if agent_name == 'seeact':
+    # 官方 SeeAct 自己发起 OpenAI 请求（seeact_utils 里端点写死），
+    # 这里先做一次进程内重定向，使其端点/密钥/模型改由 AW_LLM_* 决定。
+    seeact_compat.install()
+    return seeact.SeeAct(env)
+  # 以下两个 = 官方 agent + OpenAI 兼容 LLM（需要 AW_LLM_* 环境变量）。
+  llm = openai_compat_llm.OpenAiCompatLlm()
+  if agent_name == 't3a':  # 纯文本 agent：只看无障碍树文本，不看截图。
+    return t3a.T3A(env, llm)
+  if agent_name == 'm3a':  # 多模态 agent：无障碍树 + 截图。
+    return m3a.M3A(env, llm)
+  raise SystemExit(
+      f'未知 agent: {agent_name}（可选: human / random / seeact / t3a / m3a）'
+  )
+
+
+def cmd_list() -> int:
+  task_registry = registry.TaskRegistry().ANDROID_TASK_REGISTRY
+  for name in sorted(task_registry):
+    print(name)
+  return 0
+
+
+def _parse_tasks(args: argparse.Namespace) -> list[str]:
+  """--task / --tasks 二选一，值可以是逗号分隔的多个任务名（去重且保持顺序）。"""
+  raw = args.tasks or args.task or ''
+  return list(dict.fromkeys(t.strip() for t in raw.split(',') if t.strip()))
+
+
+def _output_dir(
+    args: argparse.Namespace, task_name: str, stamp: str, n_tasks: int
+) -> str:
+  """单用例沿用 runs/<任务名>_<时间戳>/；多用例时在指定目录下按任务名分子目录。"""
+  if args.output_dir:
+    if n_tasks > 1:
+      return os.path.join(args.output_dir, task_name)
+    return args.output_dir
+  return os.path.join('runs', f'{task_name}_{stamp}')
+
+
+def _load_done(
+    checkpointer: checkpointer_lib.Checkpointer, task_name: str
+) -> dict | None:
+  """取该用例上次跑完的记录；上次是异常中断的返回 None，让它重跑。
+
+  与官方 suite 一致：异常中断（带 error 字段）的用例不算完成，续跑时会重试。
+  """
+  for row in checkpointer.load():
+    if row.get('task_name') == task_name and not row.get('error'):
+      return row
+  return None
+
+
+def _run_one(
+    args: argparse.Namespace, task_name: str, env, agent, output_dir: str
+) -> dict:
+  """复位 -> 初始化 -> 执行 -> 验收 -> 落盘证据，返回该用例的结果字典。"""
+  # 复位桌面并清空上一用例留给 agent 的历史（T3A/M3A 累积 self.history，
+  # 不清会串到下一用例）。必须用位置参数，与官方 episode_runner 一致：
+  # 各 agent 的 reset() 关键字不统一（base/SeeAct 是 go_home，T3A/M3A 是 go_home_on_reset）。
+  print(f'[1/4] 复位到桌面（任务: {task_name}，agent: {args.agent}）...')
+  agent.reset(True)
+  env.hide_automation_ui()
+
+  task_class = _get_task_class(task_name)
+  if args.seed is not None:
+    random.seed(args.seed)
+  params = task_class.generate_random_params()
+  task = task_class(params)
+
+  print('[2/4] 调用官方 initialize_task() 初始化任务 ...')
+  try:
+    task.initialize_task(env)
+  except Exception as exc:
+    print(
+        f'[错误] 任务初始化失败: {exc}\n'
+        ' 常见原因: ① 用例需要的 App 没装；'
+        '② 命中本底座的已知限制（见 redroid/START.md 第六部分）。'
+    )
+    raise
+  print(f'      目标 goal: {task.goal}')
+
+  print('[3/4] Agent 开始执行 ...')
+  if args.agent == 'human':
+    print(
+        '      请用投屏工具（scrcpy）操作沙箱完成上述目标；\n'
+        '      完成后回到本终端按回车，脚本会自动验收。'
+    )
+  max_steps = args.max_steps or max(1, int(task.complexity * 10))
+  for _ in range(max_steps):
+    if agent.step(task.goal).done:
+      break
+
+  print('[4/4] 调用官方 is_successful() 验收 ...')
+  score = float(task.is_successful(env))
+
+  # 落盘证据：末屏截图 + 结果 JSON。
+  os.makedirs(output_dir, exist_ok=True)
+  state = env.get_state()
+  cv2.imwrite(
+      os.path.join(output_dir, 'final_screen.png'),
+      cv2.cvtColor(state.pixels, cv2.COLOR_RGB2BGR),
+  )
+  passed = score > 0.5
+  result = {
+      'task_name': task_name,
+      'goal': task.goal,
+      'params': params,
+      'agent': args.agent,
+      'score': score,
+      'passed': passed,
+      'serial': env_factory.resolve_serial(args.serial),
+      'finished_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
+  }
+  with open(os.path.join(output_dir, _RESULT_JSON), 'w') as f:
+    json.dump(result, f, ensure_ascii=False, indent=2, default=str)
+
+  print('=' * 64)
+  print(
+      f'结果: {"PASS ✅" if passed else "FAIL ❌"}'
+      f'（官方 is_successful() = {score}）'
+  )
+  print(f'证据: {os.path.abspath(output_dir)}/final_screen.png')
+  print(f'结果: {os.path.abspath(output_dir)}/{_RESULT_JSON}')
+  print('=' * 64)
+  return result
+
+
+def _write_summary(
+    args: argparse.Namespace, rows: list[dict], stamp: str, n_passed: int
+) -> None:
+  """多用例运行额外落一份汇总，并在终端打印逐条结果。"""
+  summary_dir = args.output_dir or os.path.join('runs', f'multi_{stamp}')
+  os.makedirs(summary_dir, exist_ok=True)
+  path = os.path.join(summary_dir, _SUMMARY_JSON)
+  summary = {
+      'agent': args.agent,
+      'serial': env_factory.resolve_serial(args.serial),
+      'finished_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
+      'total': len(rows),
+      'passed': n_passed,
+      'failed': len(rows) - n_passed,
+      'results': rows,
+  }
+  with open(path, 'w') as f:
+    json.dump(summary, f, ensure_ascii=False, indent=2, default=str)
+
+  print()
+  print('用例汇总:')
+  for row in rows:
+    mark = 'PASS' if row['passed'] else 'FAIL'
+    score = '-' if row['score'] is None else row['score']
+    print(f'  {mark}  {row["task_name"]:<40} score={score}')
+  print(f'汇总文件: {os.path.abspath(path)}')
+
+
+def run(args: argparse.Namespace) -> int:
+  # 设备对时（P3）/SMS 清库（P4）/收信注入（P5）适配已随 patch 进入官方源码。
+  tasks = _parse_tasks(args)
+  # 先校验全部任务名，避免跑到一半才发现拼错。
+  for task_name in tasks:
+    _get_task_class(task_name)
+
+  env = env_factory.create_env(args.serial, args.adb_path)
+  try:
+    agent = build_agent(args.agent, env)
+    if args.agent in ('t3a', 'm3a', 'seeact'):
+      # 与官方 run.py 一致：等界面稳定后再取状态（None = 自动等待）。
+      agent.transition_pause = None
+
+    checkpointer = (
+        checkpointer_lib.IncrementalCheckpointer(args.checkpoint_dir)
+        if args.checkpoint_dir
+        else None
+    )
+    if checkpointer is not None:
+      print(f'断点续跑已开启，检查点目录: {os.path.abspath(args.checkpoint_dir)}')
+
+    stamp = datetime.now().strftime('%Y%m%d-%H%M%S')
+    rows = []
+    for i, task_name in enumerate(tasks, start=1):
+      print()
+      print(f'[用例 {i}/{len(tasks)}] {task_name}')
+      print('-' * 64)
+      if checkpointer is not None:
+        done = _load_done(checkpointer, task_name)
+        if done is not None:
+          print('      检查点里已有该用例，跳过（断点续跑）。')
+          rows.append(done)
+          continue
+      try:
+        row = _run_one(
+            args,
+            task_name,
+            env,
+            agent,
+            _output_dir(args, task_name, stamp, len(tasks)),
+        )
+        rows.append(row)
+      except SystemExit:
+        raise
+      except Exception as exc:  # 单个用例失败不中断后续用例，与官方 suite 行为一致。
+        traceback.print_exc()
+        row = {
+            'task_name': task_name,
+            'goal': None,
+            'params': None,
+            'agent': args.agent,
+            'score': None,
+            'passed': False,
+            'serial': env_factory.resolve_serial(args.serial),
+            'finished_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
+            'error': f'{type(exc).__name__}: {exc}',
+        }
+        rows.append(row)
+      if checkpointer is not None:
+        checkpointer.save_episodes([row], task_name)
+
+    n_passed = sum(1 for row in rows if row['passed'])
+    if len(tasks) > 1:
+      _write_summary(args, rows, stamp, n_passed)
+    print()
+    print('=' * 64)
+    print(f'总计: {n_passed}/{len(rows)} PASS，{len(rows) - n_passed} FAIL')
+    print('=' * 64)
+    return 0 if n_passed == len(rows) else 1
+  finally:
+    env.close()
+
+
+def _build_parser() -> argparse.ArgumentParser:
+  parser = argparse.ArgumentParser(
+      prog='python -m redroid.run_task',
+      description=(
+          '最小任务 runner：在 cube + redroid 沙箱上运行 Android World 用例'
+          '（支持一次跑多个，逗号分隔）。'
+      ),
+  )
+  parser.add_argument('--task', help='任务名，如 CameraTakePhoto；多个用逗号分隔，如 A,B,C')
+  parser.add_argument('--tasks', help='同 --task（与 --task 二选一，便于对齐官方 run.py 的写法）')
+  parser.add_argument(
+      '--agent',
+      default='human',
+      choices=('human', 'random', 'seeact', 't3a', 'm3a'),
+      help=(
+          'human=人工投屏操作（默认）；random=随机点击（验证链路用）；'
+          'seeact=官方 SeeAct + AW_LLM_*；t3a=官方纯文本 agent + LLM；'
+          'm3a=官方多模态 agent + LLM'
+      ),
+  )
+  parser.add_argument('--list', action='store_true', help='列出全部可用任务名后退出')
+  parser.add_argument('--seed', type=int, help='可选：随机种子（复现同一组任务参数）')
+  parser.add_argument(
+      '--max_steps', type=int, help='可选：agent 最大步数（默认 复杂度x10，逐用例生效）'
+  )
+  parser.add_argument(
+      '--output_dir',
+      help=(
+          '可选：证据与结果输出目录。单用例默认 runs/<任务名>_<时间戳>/；'
+          '多用例默认 runs/<任务名>_<时间戳>/，指定本参数时在其下按任务名分子目录'
+      ),
+  )
+  parser.add_argument(
+      '--checkpoint_dir',
+      help=(
+          '可选：断点续跑目录。跑完一个用例即落一份检查点，用同一目录重跑会跳过'
+          '已完成的用例、只补未完成的；异常中断的用例不算完成，会被重试。'
+          '不指定则每次全跑'
+      ),
+  )
+  parser.add_argument('--serial', help='adb serial，默认取环境变量 AW_ADB_SERIAL')
+  parser.add_argument('--adb_path', help='adb 路径，默认取环境变量 AW_ADB_PATH 或 PATH')
+  return parser
+
+
+def main() -> int:
+  args = _build_parser().parse_args()
+  if args.list:
+    return cmd_list()
+  if not (args.task or args.tasks):
+    print('请指定 --task=<任务名>（多个用逗号分隔；--list 可查看全部任务名）')
+    return 2
+  return run(args)
+
+
+if __name__ == '__main__':
+  sys.exit(main())
