diff --git a/camera/camera.mk b/camera/camera.mk
new file mode 100644
index 0000000..7f522fb
--- /dev/null
+++ b/camera/camera.mk
@@ -0,0 +1,41 @@
+# Cuttlefish EmulatedCamera 纯 HAL mock 相机仿真
+# 来源: hardware/google/camera/devices/EmulatedCamera (AOSP android-14.0.0_r75)
+# 参照: device/google/cuttlefish/shared/camera/{device_vendor.mk,config/standard.mk}
+# 说明: 仅集成进程内软件仿真部分(EmulatedCamera HWL 软件渲染虚拟场景),
+#       不含 vsock guest-host 交互; 绕过 APEX 打包路线(redroid 未启用 VNDK),
+#       直接以 vendor 模块方式安装 cc_binary(自带 init rc 与 VINTF fragment)。
+#
+# media_profiles: CamcorderProfile(Java API) 只从 media_profiles_V1_0.xml 静态查表,
+# 不会从相机 characteristics 推导(frameworks/av/media/libmedia/MediaProfiles.cpp).
+# 缺失该文件时 CamcorderProfile.hasProfile() 对所有档位返回 false, Camera2 App
+# 在 SettingsUtil.getNextSupportedVideoQualityIndex 抛
+# "Could not find supported video qualities" 闪退. redroid 原产品配置不带此文件,
+# 故随相机方案一并引入(搜索路径与两个目标文件名均与 cuttlefish device.mk 一致).
+# 注意: 基于 cuttlefish shared/config/media_profiles.xml 拷贝, 并修复了后置
+# cameraId 0 的 quality="720p " 尾空格 bug —— MediaProfiles 按字符串精确匹配,
+# 尾空格导致该档解析失败, 后置录像仅剩 QVGA 可用.
+
+# libgooglecamerahwl_impl 定义于 EmulatedCamera soong 命名空间, 需声明方可被
+# PRODUCT_PACKAGES 按名解析(与 cuttlefish device_vendor.mk 保持一致)
+PRODUCT_SOONG_NAMESPACES += hardware/google/camera
+PRODUCT_SOONG_NAMESPACES += hardware/google/camera/devices/EmulatedCamera
+
+# AIDL camera provider 服务, 安装到 /vendor/bin/hw/, 由 init 拉起后
+# dlopen libgooglecamerahwl_impl.so(纯 mock HWL)
+PRODUCT_PACKAGES += \
+    android.hardware.camera.provider@2.7-service-google \
+    libgooglecamerahwl_impl \
+
+# 相机能力配置(后置/前置/深度), EmulatedCameraProviderHWLImpl 从
+# /vendor/etc/config/ 读取(缺失 external.json 属预期, 默认不加载外接相机)
+PRODUCT_COPY_FILES += \
+    hardware/google/camera/devices/EmulatedCamera/hwl/configs/emu_camera_back.json:$(TARGET_COPY_OUT_VENDOR)/etc/config/emu_camera_back.json \
+    hardware/google/camera/devices/EmulatedCamera/hwl/configs/emu_camera_front.json:$(TARGET_COPY_OUT_VENDOR)/etc/config/emu_camera_front.json \
+    hardware/google/camera/devices/EmulatedCamera/hwl/configs/emu_camera_depth.json:$(TARGET_COPY_OUT_VENDOR)/etc/config/emu_camera_depth.json \
+    device/redroid/camera/media_profiles.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_profiles_V1_0.xml \
+    device/redroid/camera/media_profiles.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_profiles_vendor.xml \
+    frameworks/native/data/etc/android.hardware.camera.concurrent.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.concurrent.xml \
+    frameworks/native/data/etc/android.hardware.camera.flash-autofocus.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.flash-autofocus.xml \
+    frameworks/native/data/etc/android.hardware.camera.front.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.front.xml \
+    frameworks/native/data/etc/android.hardware.camera.full.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.full.xml \
+    frameworks/native/data/etc/android.hardware.camera.raw.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.camera.raw.xml
