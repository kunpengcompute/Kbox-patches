diff --git a/offload/disable_offload.cpp b/offload/disable_offload.cpp
new file mode 100644
index 0000000..0080c8d
--- /dev/null
+++ b/offload/disable_offload.cpp
@@ -0,0 +1,61 @@
+// 关闭 eth0 的 TX checksum offload / TSO / GSO。
+//
+// 通过 SIOCETHTOOL（ethtool 机制）向内核下发 offload 开关。
+// 背景：Cube 网络数据面下 guest 侧若保留 offload，virtio/veth 数据面
+// 的校验和与分段语义不一致，导致出方向 TCP 包校验和错误或大包被丢弃。
+// 本程序在 boot 阶段以 init 服务运行一次，替代 entrypoint 的循环守护。
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+
+#include <linux/ethtool.h>
+#include <linux/sockios.h>
+#include <net/if.h>
+
+#include <log/log.h>
+
+namespace {
+
+// 向 eth0 下发一个 ethtool offload 开关，返回 0 成功、非 0 失败。
+int SetOffload(int fd, uint32_t cmd) {
+    struct ifreq ifr;
+    memset(&ifr, 0, sizeof(ifr));
+    strncpy(ifr.ifr_name, "eth0", IFNAMSIZ - 1);
+
+    struct ethtool_value eval;
+    memset(&eval, 0, sizeof(eval));
+    eval.cmd = cmd;
+    eval.data = 0;  // 0 = off
+
+    ifr.ifr_data = reinterpret_cast<char*>(&eval);
+    if (ioctl(fd, SIOCETHTOOL, &ifr) < 0) {
+        ALOGE("disable_offload: cmd 0x%x failed: %s", cmd, strerror(errno));
+        return -1;
+    }
+    return 0;
+}
+
+}  // namespace
+
+int main() {
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) {
+        ALOGE("disable_offload: socket failed: %s", strerror(errno));
+        return 1;
+    }
+
+    int ret = 0;
+    // TX checksum offload off
+    ret |= SetOffload(fd, ETHTOOL_STXCSUM);
+    // TCP Segmentation Offload off
+    ret |= SetOffload(fd, ETHTOOL_STSO);
+    // Generic Segmentation Offload off
+    ret |= SetOffload(fd, ETHTOOL_SGSO);
+
+    close(fd);
+    return ret ? 1 : 0;
+}
