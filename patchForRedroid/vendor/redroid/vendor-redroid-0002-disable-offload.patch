diff --git a/offload.rc b/offload.rc
new file mode 100644
index 0000000..538f434
--- /dev/null
+++ b/offload.rc
@@ -0,0 +1,9 @@
+# 关闭 eth0 的 TX checksum offload / TSO / GSO。
+# Cube 网络数据面下 guest 侧 offload 与 virtio/veth 分段语义不一致，
+# 会导致出方向 TCP 校验和错误或大包被丢弃。以 init 服务在 boot 阶段
+# 运行一次，替代 entrypoint 的循环守护脚本。
+service disable_offload /vendor/bin/disable_offload
+    class main
+    user root
+    group root
+    oneshot
