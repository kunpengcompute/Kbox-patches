+    /**
+     * redroid: 假 WiFi 状态的统一广播出口。以 Settings.Global.WIFI_ON 为唯一状态源,
+     * 设置值变化时补发 sticky WIFI_STATE_CHANGED_ACTION(与原生 ClientModeManager 行为一致),
+     * 供 SystemUI 状态栏磁贴等广播驱动方刷新。用成员布尔去重避免重复广播。
+     */
+    private void updateFakeWifiState(boolean on) {
+        if (mFakeWifiOn == on) {
+            return;
+        }
+        mFakeWifiOn = on;
+        final int newState = on ? WifiManager.WIFI_STATE_ENABLED
+                : WifiManager.WIFI_STATE_DISABLED;
+        final int prevState = on ? WifiManager.WIFI_STATE_DISABLED
+                : WifiManager.WIFI_STATE_ENABLED;
+        Intent intent = new Intent(WifiManager.WIFI_STATE_CHANGED_ACTION);
+        intent.addFlags(Intent.FLAG_RECEIVER_REGISTERED_ONLY_BEFORE_BOOT);
+        intent.putExtra(WifiManager.EXTRA_WIFI_STATE, newState);
+        intent.putExtra(WifiManager.EXTRA_PREVIOUS_WIFI_STATE, prevState);
+        mContext.sendStickyBroadcastAsUser(intent, UserHandle.ALL);
+    }
