@@ -0,0 +1,53 @@
+type preubt_a32a64_exec, system_file_type, exec_type, file_type;
+
+# binfmt_misc mount for init
+allow init proc:dir { mounton };
+allow init binfmt_miscfs:file rw_file_perms;
+
+set_prop(vendor_init, exagear_prop)
+
+# Allow the pretranslator to write log files
+userdebug_or_eng(`
+  allow preubt_a32a64 exagear_debug_file:file create_file_perms;
+  allow preubt_a32a64 exagear_debug_file:dir w_dir_perms;
+')
+
+# When invoked from installd, we use a special sandbox domain
+domain_auto_trans(installd, preubt_a32a64_exec, preubt_a32a64)
+allow preubt_a32a64 installd:fd use;
+allow preubt_a32a64 dalvikcache_data_file:file { r_file_perms write };
+allow preubt_a32a64 { apk_tmp_file apk_private_tmp_file }:file { r_file_perms write };
+allow preubt_a32a64 { apk_data_file apk_private_data_file }:file { r_file_perms write };
+allow preubt_a32a64 dalvikcache_data_file:dir r_dir_perms;
+allow preubt_a32a64 { apk_tmp_file apk_private_tmp_file }:dir r_dir_perms;
+allow preubt_a32a64 { apk_data_file apk_private_data_file }:dir r_dir_perms;
+allow installd { apk_tmp_file apk_private_tmp_file }:file create_file_perms;
+allow installd { apk_data_file apk_private_data_file }:file create_file_perms;
+
+# Access to properties which control pre-translation behavior
+get_prop(system_server, exagear_prop)
+get_prop(preubt_a32a64, exagear_prop)
+get_prop(installd, exagear_prop)
+
+# 32-bit zygote
+exagear_translated(zygote)
+exagear_translated(webview_zygote)
+
+# 32-bit app
+exagear_translated(appdomain)
+
+# 32-bit system servers
+exagear_translated(audioserver)
+exagear_translated(cameraserver)
+exagear_translated(drmserver)
+exagear_translated(mediaserver)
+
+# 32-bit ART utilities
+exagear_translated(dex2oat)
+exagear_translated(profman)
+exagear_translated(dexoptanalyzer)
+
+# 32-bit misc
+exagear_translated(boringssl_self_test)
+exagear_translated(vendor_boringssl_self_test)
+exagear_translated(crash_dump)
