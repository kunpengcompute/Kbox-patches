diff --git a/build/make/core/dynamic_binary.mk b/build/make/core/dynamic_binary.mk
index 48072b3695..4b3abdbe8a 100644
--- a/build/make/core/dynamic_binary.mk
+++ b/build/make/core/dynamic_binary.mk
@@ -148,3 +148,24 @@ $(cleantarget): PRIVATE_CLEAN_FILES += \
     $(breakpad_output) \
     $(symbolic_output) \
     $(strip_output)
+
+###########################################################
+## ExaGear pre-translation
+###########################################################
+
+ifeq ($(EXAGEAR_PRETRANSLATE_BINARY),true)
+ifeq ($($(LOCAL_2ND_ARCH_VAR_PREFIX)DEX2OAT_TARGET_ARCH),arm)
+
+# Perform pretranslation on the *unstripped* output file so that the
+# pre-translator can take advantage of symbol information.
+$(LOCAL_BUILT_MODULE).exagear: $(LOCAL_BUILT_MODULE) $(symbolic_output) $(EXAGEAR_PRETRANSLATOR)
+	@echo "Pre-translate: $@"
+	$(call exagear-pretranslate-sym,$<,$(word 2,$^),$@)
+$(eval $(call copy-one-file,$(LOCAL_BUILT_MODULE).exagear,$(LOCAL_INSTALLED_MODULE).exagear))
+
+$(my_register_name): $(LOCAL_INSTALLED_MODULE).exagear
+ALL_MODULES.$(my_register_name).INSTALLED += $(LOCAL_INSTALLED_MODULE).exagear
+ALL_MODULES.$(my_register_name).BUILT_INSTALLED += $(LOCAL_BUILT_MODULE).exagear:$(LOCAL_INSTALLED_MODULE).exagear
+
+endif # DEX2OAT_TARGET_ARCH
+endif # EXAGEAR_PRETRANSLATE_BINARY
