+                            }
+                        })) {
+                        exagearPretranslateFile(lib.getAbsolutePath(), sharedGid, bootComplete, false);
+                    }
+                }
+            }
+        } else {
+            Slog.i(TAG, "exagear: skipping shared library pre-translation for " + pkg.getPackageName());
+        }
