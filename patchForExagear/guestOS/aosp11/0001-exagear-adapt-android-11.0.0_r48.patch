diff --git a/build/make/core/app_prebuilt_internal.mk b/build/make/core/app_prebuilt_internal.mk
index ab574b3fa4..b74d30427a 100644
--- a/build/make/core/app_prebuilt_internal.mk
+++ b/build/make/core/app_prebuilt_internal.mk
@@ -296,3 +296,16 @@ $(my_all_targets): $(installed_apk_splits)
 
 endif # LOCAL_PACKAGE_SPLITS
 
+# Pre-translate embedded shared libraries in an APK
+ifeq ($(EXAGEAR_PRETRANSLATE_APK),true)
+
+$(LOCAL_BUILT_MODULE).exagear: $(LOCAL_BUILT_MODULE) $(EXAGEAR_PRETRANSLATOR)
+	@echo "Pre-translate: $@"
+	$(call exagear-pretranslate-apk,$<,$@)
+$(eval $(call copy-one-file,$(LOCAL_BUILT_MODULE).exagear,$(LOCAL_INSTALLED_MODULE).exagear))
+
+$(my_register_name): $(LOCAL_INSTALLED_MODULE).exagear
+ALL_MODULES.$(my_register_name).INSTALLED += $(LOCAL_INSTALLED_MODULE).exagear
+ALL_MODULES.$(my_register_name).BUILT_INSTALLED += $(LOCAL_BUILT_MODULE).exagear:$(LOCAL_INSTALLED_MODULE).exagear
+
+endif # EXAGEAR_PRETRANSLATE_APK
diff --git a/build/make/core/cc_prebuilt_internal.mk b/build/make/core/cc_prebuilt_internal.mk
index 99b7d0f6ab..223ece6b1e 100644
--- a/build/make/core/cc_prebuilt_internal.mk
+++ b/build/make/core/cc_prebuilt_internal.mk
@@ -74,6 +74,29 @@ else  # my_strip_module not true
   include $(BUILD_SYSTEM)/base_rules.mk
   built_module := $(LOCAL_BUILT_MODULE)
 
+# Pre-translate prebuilt shared libraries and executables. This only handles the
+# non-stripped case. The stripped case is handled in dynamic_binary.mk.
+ifeq ($(EXAGEAR_PRETRANSLATE_BINARY),true)
+ifeq ($($(LOCAL_2ND_ARCH_VAR_PREFIX)DEX2OAT_TARGET_ARCH),arm)
+ifneq ($(filter SHARED_LIBRARIES EXECUTABLES,$(LOCAL_MODULE_CLASS)),)
+ifndef LOCAL_IS_HOST_MODULE
+ifdef LOCAL_INSTALLED_MODULE
+
+$(LOCAL_BUILT_MODULE).exagear: $(LOCAL_BUILT_MODULE) $(EXAGEAR_PRETRANSLATOR)
+	@echo "Pre-translate: $@"
+	$(call exagear-pretranslate,$<,$@)
+$(eval $(call copy-one-file,$(LOCAL_BUILT_MODULE).exagear,$(LOCAL_INSTALLED_MODULE).exagear))
+
+$(my_register_name): $(LOCAL_INSTALLED_MODULE).exagear
+ALL_MODULES.$(my_register_name).INSTALLED += $(LOCAL_INSTALLED_MODULE).exagear
+ALL_MODULES.$(my_register_name).BUILT_INSTALLED += $(LOCAL_BUILT_MODULE).exagear:$(LOCAL_INSTALLED_MODULE).exagear
+
+endif # LOCAL_INSTALLED_MODULE
+endif # LOCAL_IS_HOST_MODULE
+endif # LOCAL_MODULE_CLASS
+endif # DEX2OAT_TARGET_ARCH
+endif # EXAGEAR_PRETRANSLATE_BINARY
+
 ifdef prebuilt_module_is_a_library
 EXPORTS_LIST += $(intermediates)
 EXPORTS.$(intermediates).FLAGS := $(foreach d,$(LOCAL_EXPORT_C_INCLUDE_DIRS),-I $(d))
