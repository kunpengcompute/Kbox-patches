+                    && VMRuntime.getInstructionSet(secondaryCpuAbi).equals("arm")) {
+                libDir = pkg.getSecondaryNativeLibraryDir();
+            }
+            if (libDir != null) {
+                File f = new File(libDir);
+                if (f.exists() && f.isDirectory()) {
+                    for (File lib : f.listFiles(new FilenameFilter() {
