+    private void exagearPretranslatePkg(AndroidPackage pkg, PackageSetting pkgSetting,
+            boolean bootComplete) {
+        // We only support pre-translating packages in the data partition.
+        if (!AndroidPackageUtils.canHaveOatDir(pkg,
+                pkgSetting.getPkgState().isUpdatedSystemApp()))
+            return;
+
+        final int sharedGid = UserHandle.getSharedAppGid(pkg.getUid());
+
+        // Pre-translate .so files which are embedded in apk files. These are
+        // page-aligned and uncompressed, which allows them to be mmap'ed
+        // directly without extracting them.
+        if (SystemProperties.getBoolean("exagear.pretrans.apk", false)) {
+            for (String apk : AndroidPackageUtils.getAllCodePathsExcludingResourceOnly(pkg)) {
+                exagearPretranslateFile(apk, sharedGid, bootComplete, true);
+            }
+        } else {
+            Slog.i(TAG, "exagear: skipping APK pre-translation for " + pkg.getPackageName());
+        }
+
+        // Pre-translate .so files which are extracted from apk files.
+        if (SystemProperties.getBoolean("exagear.pretrans.lib", false)) {
+            String libDir = null;
+            String primaryCpuAbi = AndroidPackageUtils.getPrimaryCpuAbi(pkg, pkgSetting);
+            String secondaryCpuAbi = AndroidPackageUtils.getSecondaryCpuAbi(pkg, pkgSetting);
