+//该接口非线程安全，不支持并发调用forecast_space提供给公用此函数读取文件的调用，自定义预估读取字节
+static char* read_file(int& file_fd, int forecast_space = 0) {
+    static ssize_t buf_size = PAGE_SIZE;
+    ssize_t size;
+    static char *new_buf, *buf = NULL;
+
+    if (buf == NULL && (buf = static_cast<char *>(malloc(buf_size))) == NULL) {
+        ALOGE("open vmem temp space fail");
+        return NULL;
+    }
+    while (true) {
+        size = read_all(file_fd, buf, forecast_space <= 0 ? buf_size - 1 : forecast_space - 1);
+        if (size < 0) {
+            ALOGE("Read vmemfile fail");
+            close_fd(file_fd);
+            free(buf);
+            buf = NULL;
+            return NULL;
+        }
+        //过量使用会进行减少内存
+        if (buf_size != PAGE_SIZE && (buf_size >= MEM_LIMT * size)) {
+            free(buf);
+            new_buf = NULL;
+            buf = NULL;
+            buf_size = PAGE_SIZE;
+            if ((buf = static_cast<char *>(malloc(buf_size))) == NULL) {
+                ALOGE("open vmem temp space fail");
+                return NULL;
+            }
+            continue;
+        }
+        if (size < buf_size - 1) {
+            break;
+        }
+        if ((new_buf = static_cast<char *>(realloc(buf, buf_size * 2))) == NULL) {
+            ALOGE("realloc fail!");
+            return NULL;
+        }
+        buf = new_buf;
+        buf_size *= 2;
+    }
+    return buf;
+}
+
+static void get_mem_info(char* m_buf, char* m_line) {
+    // 不采用strstr, 字符串匹配会带来性能损失，确定了需要的内容在1 2 3 15 16行。直接按需读取即可
+    char *line, *rest = NULL;
+    int line_count = 1;
+    line = strtok_r(m_buf, PARSE_LINE_BREAK, &rest);
+    while (line != NULL) {
+        if (line_count <= 3 || line_count == 15) {
+            snprintf(m_line + strlen(m_line), BUFFER_SIZE_256 - strlen(m_line) - 1, "%s|", line);
+        } else if (line_count == 16) {
+            snprintf(m_line + strlen(m_line), BUFFER_SIZE_256 - strlen(m_line) - 1, "%s", line);
+            break;
+        }
+        ++line_count;
+        line = strtok_r(NULL, PARSE_LINE_BREAK, &rest);
+    }
+}
+
+static void get_vmem_info(char* m_buf, char* m_line, const char* m_containerid) {
+    char *line, *rest = NULL;
+    line = strtok_r(m_buf, PARSE_LINE_BREAK, &rest);
+    while (line != NULL) {
+        if (strstr(line, m_containerid)) {
+            // 由于文件位数比较固定，直接读取26位后的数据
+            snprintf(m_line + strlen(m_line), BUFFER_SIZE_256 - strlen(m_line) - 1, "%s", line + 26);
+            break;
+        }
+        line = strtok_r(NULL, PARSE_LINE_BREAK, &rest);
+    }
+}
+
+static void print_meminfo(const char* m_file, const char* m_containerid = NULL) {
+    int file_fd = -1;
+    char* buf = NULL;
+    char mem_info_line[BUFFER_SIZE_256] = {0};
+
+    file_fd = open(m_file, O_RDONLY | O_CLOEXEC);
+    if (file_fd < 0) {
+        ALOGE("%s file open fail", m_file);
+    } else {
+        buf = m_containerid == NULL? read_file(file_fd, PAGE_SIZE) : read_file(file_fd);
+        if (buf == NULL) {
+            ALOGE("read %s file fail", m_file);
+        } else {
+            if (m_containerid == NULL) {
+                get_mem_info(buf, mem_info_line);
+                ALOGI("MemInfo:[%s]", mem_info_line);
+            } else {
+                get_vmem_info(buf, mem_info_line, m_containerid);
+                ALOGI("VMemInfo:[%s]", mem_info_line);
+            }
+        }
+    }
+    close_fd(file_fd);
+}
