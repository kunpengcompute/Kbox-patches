+static void get_containerdata(char* buf, const char* path, ssize_t bytes) {
+    // 确保container文件在读取前生成
+    int redo_time = 5;
+    int path_fd = -1;
+    while ((path_fd = open(path, O_RDONLY | O_CLOEXEC)) < 0 && --redo_time >= 0) {
+        sleep(1);
+    }
+    if (path_fd < 0) {
+        ALOGE("%s file open fail", path);
+    }
+    ssize_t bytes_read = read(path_fd, buf, bytes - 1);
+    if (bytes_read < 0) {
+        ALOGE("Read %s file fail", path);
+    }
+    close_fd(path_fd);
+}
