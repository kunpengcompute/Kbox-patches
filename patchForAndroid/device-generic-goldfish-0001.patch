+static char g_noParam = '\0';
+char *Camera::GetParameters()
+{
+    int width = 0, height = 0;
+    m_parameters.getPictureSize(&width, &height);
+    if (height > 0) {
+        // 除法存在精度损失问题，改用乘法进行比较 (double)width / height) < 1.55
+        if (((double)width * 1.55) < height) {
+            m_parameters.set(CameraParameters::KEY_HORIZONTAL_VIEW_ANGLE, "61.0");
+        } else {
+            m_parameters.set(CameraParameters::KEY_HORIZONTAL_VIEW_ANGLE, "70.0");
+        }
+    }
+
+    android::String8 params(m_parameters.flatten());
+    char *retStr = reinterpret_cast<char *>(malloc(sizeof(char) * (params.length() + 1)));
+    memset(retStr, 0, params.length() + 1);
+    if (retStr != nullptr) {
+        strncpy(retStr, params.string(), params.length() + 1);
+        return retStr;
+    } else {
+        ALOGE("Unable to allocate string for %s", params.string());
+        return &g_noParam;
+    }
+}
