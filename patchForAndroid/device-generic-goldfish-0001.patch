+ */
+
+#include "camera_factory.h"
+#include <vector>
+#include <log/log.h>
+#include <cerrno>
+#include "camera_hal_interface.h"
+#include "camera.h"
+CameraMock::CameraFactory g_cameraFactory;
+
+namespace CameraMock {
+CameraFactory::CameraFactory() noexcept
+    : m_constructedOK(false), m_gBM(&android::GraphicBufferMapper::get()), m_callbacks(nullptr)
+{
+    CreateCamera(true);
+    CreateCamera(false);
+    m_constructedOK = true;
+}
+
+CameraFactory::~CameraFactory()
+{
+    for (auto &c : m_cameras) {
+        c->CloseCamera();
+        c = nullptr;
+    }
+    m_cameras.clear();
+}
+
+void CameraFactory::CreateCamera(bool backCamera)
+{
+    auto camera = std::make_unique<Camera>(m_cameras.size(), backCamera, &HAL_MODULE_INFO_SYM.common, m_gBM);
+    if (camera == nullptr) {
+        ALOGE("Camera malloc fail");
+        return;
+    }
+    android::status_t res = camera->Initialize();
+    if (res == android::NO_ERROR) {
+        m_cameras.push_back(std::move(camera));
+    } else {
+        ALOGE("Unable to initialize %s camera %zu: %s (%d)",
+            backCamera ? "back" : "front",
+            m_cameras.size(),
+            strerror(-res),
+            res);
+    }
+}
+
+int CameraFactory::StaticDeviceOpen(const hw_module_t *module, const char *name, hw_device_t **device)
+{
+    return g_cameraFactory.DeviceOpen(atoi(name), device);
+}
+
+int CameraFactory::StaticGetNumberOfCameras(void)
+{
+    return g_cameraFactory.GetNumberOfCameras();
+}
+
+int CameraFactory::StaticGetCameraInfo(int cameraId, struct camera_info *info)
+{
+    return g_cameraFactory.GetCameraInfo(cameraId, info);
+}
+
+int CameraFactory::StaticSetCallbacks(const camera_module_callbacks_t *callbacks)
+{
+    return g_cameraFactory.SetCallbacks(callbacks);
+}
+
+void CameraFactory::StaticGetVendorTagOps(vendor_tag_ops_t *ops)
+{
+    return g_cameraFactory.GetVendorTagOps(ops);
+}
+
+int CameraFactory::StaticOpenLegacy(
+    const struct hw_module_t *module, const char *id, uint32_t halVersion, struct hw_device_t **device)
+{
+    return -ENOSYS;
+}
+
+int CameraFactory::DeviceOpen(int cameraId, hw_device_t **device)
+{
+    *device = nullptr;
+    if (!IsConstructedOK()) {
+        ALOGE("CameraFactory has failed to initialize");
+        return -EINVAL;
+    }
+    if (cameraId < 0 || cameraId >= GetNumberOfCameras()) {
+        ALOGE("Camera id %d is out of bounds (%d)", cameraId, GetNumberOfCameras());
+        return -ENODEV;
+    }
+    return m_cameras[cameraId]->ConnectCamera(device);
+}
+
+int CameraFactory::GetNumberOfCameras() const
+{
+    return m_cameras.size();
+}
+
+int CameraFactory::GetCameraInfo(int cameraId, struct camera_info *info)
+{
+    if (!IsConstructedOK()) {
+        ALOGE("CameraFactory has failed to initialize");
+        return -EINVAL;
+    }
+
+    if (cameraId < 0 || cameraId >= GetNumberOfCameras()) {
+        ALOGE("Camera id %d is out of bounds (%d)", cameraId, GetNumberOfCameras());
+        return -ENODEV;
+    }
+    return m_cameras[cameraId]->GetCameraInfo(info);
+}
+
+int CameraFactory::SetCallbacks(const camera_module_callbacks_t *callbacks)
+{
+    ALOGD("callbacks = %p", callbacks);
+    m_callbacks = callbacks;
+    return android::OK;
+}
+
+void CameraFactory::GetVendorTagOps(vendor_tag_ops_t *ops)
+{
+    ALOGD("ops = %p", ops);
+}
+
+struct hw_module_methods_t CameraFactory::m_cameraModuleMethods = {.open = CameraFactory::StaticDeviceOpen};
+
+bool CameraFactory::IsConstructedOK() const
+{
+    return m_constructedOK;
+}
+
+int CameraFactory::GetFakeCameraOrientation()
+{
+    int degree = property_get_int32(KBOX_CAMERA_ORIENTATION, 0);
+    return degree;
+}
+}  // namespace CameraMock
