+bool CameraDevice::ProduceFrame(void *buffer, int64_t *timestamp)
+{
+    int width = 1080;
+    int height = 1920;
+    int ySize = width * height;
+    int uvSize = ySize / 4;
+    int fileSize = ySize + uvSize * 2;
+
+    char prop[PROPERTY_VALUE_MAX] = {0};
+    // 此处带默认值调用property_get接口，不存在失败场景。因此不判断错误码。
+    property_get(KBOX_CAMERA_MOCK_YUV, prop, DEFAULT_YUV.c_str());
+    FILE *fp = std::fopen(prop, "rb");
+    bool res = true;
+    if (fp == nullptr) {
+        ALOGE("Open file failed");
+        m_currentColor = &m_greenYUV;
+        DrawSolid(buffer, m_currentColor);
+    } else {
+        uint8_t *currentFrame = static_cast<uint8_t *>(buffer);
+        int count = fread(currentFrame, fileSize, 1, fp);
+        if (count == 0) {
+            res = false;
+        }
+        (void)fclose(fp);
+    }
+    if (timestamp != nullptr) {
+        *timestamp = 0L;
+    }
+    return true;
+}
+
+void CameraDevice::DrawSolid(void *buffer, YUVPixel *color)
+{
+    ALOGV("Draw green frame");
+    YUVPixel adjustedColor = *color;
+    ChangeWhiteBalance(adjustedColor.Y, adjustedColor.U, adjustedColor.V);
+    uint8_t *mCurrentFrame = static_cast<uint8_t *>(buffer);
+    memset(mCurrentFrame, ChangeExposure(adjustedColor.Y), m_frameHeight * m_yStride);
+
+    uint8_t *mFrameU = mCurrentFrame + m_frameUOffset;
+    uint8_t *mFrameV = mCurrentFrame + m_frameVOffset;
+    for (int y = 0; y < m_frameHeight / 2; ++y) {
+        uint8_t *u = mFrameU + y * m_uVStride;
+        uint8_t *v = mFrameV + y * m_uVStride;
+
+        for (int x = 0; x < m_frameWidth / 2; ++x, u += m_uVStep, v += m_uVStep) {
+            *u = color->U;
+            *v = color->V;
+        }
+    }
+}
+
+void CameraDevice::ChangeWhiteBalance(uint8_t &y, uint8_t &u, uint8_t &v) const
+{
+    float rScale = m_whiteBalanceScale[0];
+    float bScale = m_whiteBalanceScale[2];
+    int r = static_cast<float>(YUV2R(y, u, v)) / rScale;
+    int g = YUV2G(y, u, v);
+    int b = static_cast<float>(YUV2B(y, u, v)) / bScale;
+
+    y = RGB2Y(r, g, b);
+    u = RGB2U(r, g, b);
+    v = RGB2V(r, g, b);
+}
+
+void CameraDevice::CheckAutoFocusTrigger()
+{
+    bool expectedTrigger = true;
+    if (m_triggerAutoFocus.compare_exchange_strong(expectedTrigger, false)) {
+        m_cameraHAL->AutoFocusComplete();
+    }
+}
+
+}  // namespace CameraMock
