+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
+ */
+#ifndef CAMERA_MOCK_WORKER_THREAD_H
+#define CAMERA_MOCK_WORKER_THREAD_H
+#include <utils/Thread.h>
+
+using ::android::Mutex;
+
+namespace CameraMock {
+
+class Camera;
+class CameraDevice;
+class WorkerThread : public android::Thread {
+public:
+    WorkerThread(const char *threadName, CameraDevice *cameraDev, Camera *cameraHAL);
+    virtual ~WorkerThread() = default;
+
+    android::status_t StartThread(bool oneBurst);
+
+    android::status_t StopThread();
+
+    android::status_t WakeThread();
+
+    android::status_t JoinThread();
+
+protected:
+    virtual bool InWorkerThread() = 0;
+
+    virtual android::status_t OnThreadStart();
+    virtual void OnThreadExit();
+
+    CameraDevice *m_cameraDevice;
+    Camera *m_cameraHAL;
+    bool m_oneBurst;
+    android::Condition m_runningCondition;
+    Mutex m_runningMutex;
+    bool m_running;
+
+private:
+    android::status_t readyToRun() final;
+
+    bool threadLoop() final;
+
+    const char *m_threadName;
+};
+}  // namespace CameraMock
+#endif  // CAMERA_MOCK_WORKER_THREAD_H
