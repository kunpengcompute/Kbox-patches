+android::status_t CameraDevice::StartWorkerThread(bool oneBurst)
+{
+    if (!IsInitialized()) {
+        ALOGE("Camera device is not initialized");
+        return EINVAL;
+    }
+
+    m_cameraThread = new CameraThread(this, staticProduceFrame, this);
+    if (m_cameraThread == nullptr) {
+        ALOGE("Unable to instantiate CameraThread object");
+        return ENOMEM;
+    }
+    android::status_t res = m_cameraThread->StartThread(oneBurst);
+    if (res != android::NO_ERROR) {
+        ALOGE("Unable to start CameraThread: %s", strerror(res));
+        return res;
+    }
+
+    return res;
+}
+
+android::status_t CameraDevice::StopWorkerThread()
+{
+    if (!IsInitialized()) {
+        ALOGE("Emulated camera device is not initialized");
+        return EINVAL;
+    }
+    android::status_t res = m_cameraThread->StopThread();
+    if (res != android::NO_ERROR) {
+        ALOGE("Unable to stop CameraThread");
+        return res;
+    }
+    res = m_cameraThread->JoinThread();
+    if (res != android::NO_ERROR) {
+        ALOGE("Unable to join CameraThread");
+        return res;
+    }
+
+    m_cameraThread.clear();
+    return res;
+}
