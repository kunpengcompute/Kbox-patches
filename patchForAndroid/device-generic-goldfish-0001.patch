+android::status_t CameraDevice::CommonStartDevice(int width, int height, uint32_t pixFmt)
+{
+    if (width <= 0 || height <= 0) {
+        ALOGE("Invalid width or height");
+    }
+    switch (pixFmt) {
+        case V4L2_PIX_FMT_YVU420:
+        case V4L2_PIX_FMT_YUV420:
+            m_yStride = Align(width, 16);
+            m_uVStride = Align(m_yStride / 2, 16);
+            m_frameBufferSize = m_yStride * height + m_uVStride * height;
+            break;
+        case V4L2_PIX_FMT_NV21:
+        case V4L2_PIX_FMT_NV12:
+            m_yStride = width;
+            m_uVStride = m_yStride;
+            m_frameBufferSize = m_yStride * height + m_uVStride * (height / 2);
+            break;
+        default:
+            ALOGE("Unknown pixel format %.4s", reinterpret_cast<const char *>(&pixFmt));
+            return EINVAL;
+    }
+    m_frameWidth = width;
+    m_frameHeight = height;
+    m_pixelFormat = pixFmt;
+    m_totalPixels = width * height;
+
+    m_frameBuffers[0].resize(m_frameBufferSize);
+    m_frameBuffers[1].resize(m_frameBufferSize);
+    ALOGV("Allocated %zu bytes for %d pixels in %.4s[%dx%d] frame",
+        m_frameBufferSize,
+        m_totalPixels,
+        reinterpret_cast<const char *>(&m_pixelFormat),
+        m_frameWidth,
+        m_frameHeight);
+    return android::NO_ERROR;
+}
+
+void CameraDevice::CommonStopDevice()
+{
+    m_frameWidth = m_frameHeight = m_totalPixels = 0;
+    m_pixelFormat = 0;
+
+    m_frameBuffers[0].clear();
+    m_frameBuffers[1].clear();
+    m_frameBuffers[0].shrink_to_fit();
+    m_frameBuffers[1].shrink_to_fit();
+}
