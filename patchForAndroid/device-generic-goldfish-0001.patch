+#include <log/log.h>
+#include "camera_device.h"
+#include <ui/GraphicBuffer.h>
+#include <cerrno>
+
+namespace CameraMock {
+
+PreviewWindow::PreviewWindow(android::GraphicBufferMapper *gbm)
+    : m_previewWindow(nullptr), mGBM(gbm), mPreviewFrameWidth(0), mPreviewFrameHeight(0), mPreviewEnabled(false)
+{}
+
+PreviewWindow::~PreviewWindow()
+{}
+
+android::status_t PreviewWindow::SetPreviewWindow(struct preview_stream_ops *window, int previewFps)
+{
+    ALOGV("current: %p -> new: %p", m_previewWindow, window);
+
+    android::status_t res = android::NO_ERROR;
+    Mutex::Autolock locker(&m_objectLock);
+
+    mPreviewFrameWidth = mPreviewFrameHeight = 0;
+
+    if (window != nullptr) {
+        res = window->set_usage(window, GRALLOC_USAGE_SW_WRITE_OFTEN);
+        if (res != android::NO_ERROR) {
+            window = nullptr;
+            res = -res;
+            ALOGE("Error setting preview window usage %d -> %s", res, strerror(res));
+        }
+    }
+    m_previewWindow = window;
+    return res;
+}
+
+android::status_t PreviewWindow::StartPreview()
+{
+    Mutex::Autolock locker(&m_objectLock);
+    mPreviewEnabled = true;
+
+    return android::NO_ERROR;
+}
+
+void PreviewWindow::StopPreview()
+{
+    Mutex::Autolock locker(&m_objectLock);
+    mPreviewEnabled = false;
+}
+
+void PreviewWindow::OnNextFrameAvailable(nsecs_t timestamp, CameraDevice *cameraDev)
+{
+    int res;
+    Mutex::Autolock locker(&m_objectLock);
+    if (!IsPreviewEnabled() || m_previewWindow == nullptr) {
+        return;
+    }
+
+    if (AdjustPreviewDimensions(cameraDev)) {
+        ALOGV(
+            "Adjusting preview windows %p geometry to %dx%d", m_previewWindow, mPreviewFrameWidth, mPreviewFrameHeight);
+        res = m_previewWindow->set_buffers_geometry(
+            m_previewWindow, mPreviewFrameWidth, mPreviewFrameHeight, HAL_PIXEL_FORMAT_RGBA_8888);
+        if (res != android::NO_ERROR) {
+            ALOGE("Error in set_buffers_geometry %d -> %s", -res, strerror(-res));
+            return;
+        }
+    }
+
+    buffer_handle_t *buffer = nullptr;
+    int stride = 0;
+    res = m_previewWindow->dequeue_buffer(m_previewWindow, &buffer, &stride);
+    if (res != android::NO_ERROR || buffer == nullptr) {
+        ALOGE("Unable to dequeue preview window buffer: %d -> %s", -res, strerror(-res));
+        return;
+    }
+    res = m_previewWindow->lock_buffer(m_previewWindow, buffer);
+    if (res != android::NO_ERROR) {
+        ALOGE("Unable to lock preview window buffer: %d -> %s", -res, strerror(-res));
+        m_previewWindow->cancel_buffer(m_previewWindow, buffer);
+        return;
+    }
+
+    void *img = nullptr;
+
+    android::status_t status = mGBM->lock(*buffer,
+        android::GraphicBuffer::USAGE_SW_WRITE_OFTEN,
+        android::Rect(0, 0, mPreviewFrameWidth, mPreviewFrameHeight),
+        &img);
+    if (status != android::OK) {
+        ALOGE("Gralloc.lock failure: %d -> %s", res, strerror(res));
+        m_previewWindow->cancel_buffer(m_previewWindow, buffer);
+        return;
+    }
+    int64_t frame_timestamp = 0L;
+    res = cameraDev->GetCurrentPreviewFrame(img, &frame_timestamp);
+    if (res == android::NO_ERROR) {
+        m_previewWindow->set_timestamp(m_previewWindow, frame_timestamp != 0L ? frame_timestamp : timestamp);
+        m_previewWindow->enqueue_buffer(m_previewWindow, buffer);
+    } else {
+        ALOGE("Unable to obtain preview frame: %d", res);
+        m_previewWindow->cancel_buffer(m_previewWindow, buffer);
+    }
+    mGBM->unlock(*buffer);
+}
+
+bool PreviewWindow::AdjustPreviewDimensions(CameraDevice *cameraDev)
+{
+    if (mPreviewFrameWidth == cameraDev->GetFrameWidth() && mPreviewFrameHeight == cameraDev->GetFrameHeight()) {
+        return false;
+    }
+
+    mPreviewFrameWidth = cameraDev->GetFrameWidth();
+    mPreviewFrameHeight = cameraDev->GetFrameHeight();
+
+    return true;
+}
+}  // namespace CameraMock
