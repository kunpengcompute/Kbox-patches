+++ b/camera-kbox/worker_thread.cpp
@@ -0,0 +1,78 @@
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
+ */
+#include "worker_thread.h"
+#include <log/log.h>
+#include <cerrno>
+#include <algorithm>
+
+namespace CameraMock {
+
+WorkerThread::WorkerThread(const char *threadName, CameraDevice *cameraDevice, Camera *cameraHAL)
+    : android::Thread(true), m_cameraDevice(cameraDevice), m_cameraHAL(cameraHAL), m_running(false), m_threadName(threadName)
+{}
+
+android::status_t WorkerThread::StartThread(bool oneBurst)
+{
+    ALOGV("Starting worker thread, oneBurst=%s", oneBurst ? "true" : "false");
+    m_oneBurst = oneBurst;
+    {
+        Mutex::Autolock lock(m_runningMutex);
+        m_running = true;
+    }
+    return run(m_threadName, ANDROID_PRIORITY_URGENT_DISPLAY, 0);
+}
+
+android::status_t WorkerThread::StopThread()
+{
+    ALOGV("%s: Stopping worker thread...");
+
+    Mutex::Autolock lock(m_runningMutex);
+    m_running = false;
+    m_runningCondition.signal();
+    return android::NO_ERROR;
+}
+
+android::status_t WorkerThread::WakeThread()
+{
+    ALOGV("%s: Waking emulated camera device's worker thread...");
+
+    m_runningCondition.signal();
+    return android::NO_ERROR;
+}
+
+android::status_t WorkerThread::JoinThread()
+{
+    return join();
+}
+
+android::status_t WorkerThread::readyToRun()
+{
+    android::status_t res = OnThreadStart();
+    if (res != android::NO_ERROR) {
+        return res;
+    }
+    return android::NO_ERROR;
+}
+
+bool WorkerThread::threadLoop()
+{
+    if (InWorkerThread() && !m_oneBurst) {
+        Mutex::Autolock lock(m_runningMutex);
+        if (m_running) {
+            return true;
+        }
+    }
+    OnThreadExit();
+    ALOGD("Exiting thread, m_oneBurst=%s", m_oneBurst ? "true" : "false");
+    return false;
+}
+
+android::status_t WorkerThread::OnThreadStart()
+{
+    return android::NO_ERROR;
+}
+
+void WorkerThread::OnThreadExit()
+{}
+}  // namespace CameraMock
