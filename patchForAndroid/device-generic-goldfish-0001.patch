+android::status_t Camera::CloseCamera()
+{
+    android::status_t res = android::NO_ERROR;
+
+    res = DoStopPreview();
+    if (res != android::NO_ERROR) {
+        return -res;
+    }
+
+    CameraDevice *const cameraDev = GetCameraDevice();
+    if (cameraDev != nullptr) {
+        if (cameraDev->IsStarted()) {
+            cameraDev->StopDeliveringFrames();
+            res = cameraDev->StopDevice();
+            if (res != android::NO_ERROR) {
+                return -res;
+            }
+        }
+        if (cameraDev->IsConnected()) {
+            res = cameraDev->DisconnectDevice();
+            if (res != android::NO_ERROR) {
+                return -res;
+            }
+        }
+    }
+
+    Initialize();
+
+    return android::NO_ERROR;
+}
