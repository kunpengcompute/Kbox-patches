diff --git a/camera-kbox/callback_notifier.cpp b/camera-kbox/callback_notifier.cpp
new file mode 100644
index 0000000..d1faf28
--- /dev/null
+++ b/camera-kbox/callback_notifier.cpp
@@ -0,0 +1,213 @@
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
+ */
+#include "callback_notifier.h"
+#include <log/log.h>
+#include <media/hardware/MetadataBufferType.h>
+#include <cerrno>
+#include "jpeg_compressor.h"
+#include "exif.h"
+#include "thumbnail.h"
+
+
+namespace CameraMock {
+
+static const char *g_cameraMessages[] = {"CAMERA_MSG_ERROR",
+    "CAMERA_MSG_SHUTTER",
+    "CAMERA_MSG_FOCUS",
+    "CAMERA_MSG_ZOOM",
+    "CAMERA_MSG_PREVIEW_FRAME",
+    "CAMERA_MSG_VIDEO_FRAME",
+    "CAMERA_MSG_POSTVIEW_FRAME",
+    "CAMERA_MSG_RAW_IMAGE",
+    "CAMERA_MSG_COMPRESSED_IMAGE",
+    "CAMERA_MSG_RAW_IMAGE_NOTIFY",
+    "CAMERA_MSG_PREVIEW_METADATA"};
+
+static const int CAMERA_MESSAGES_NUM = sizeof(g_cameraMessages) / sizeof(char *);
+
+static int GetMessageStrings(uint32_t msg, const char **strings, int max)
+{
+    int index = 0;
+    int out = 0;
+    while (msg != 0 && out < max && index < CAMERA_MESSAGES_NUM) {
+        while ((msg & 0x1) == 0 && index < CAMERA_MESSAGES_NUM) {
+            msg >>= 1;
+            index++;
+        }
+        if ((msg & 0x1) != 0 && index < CAMERA_MESSAGES_NUM) {
+            strings[out] = g_cameraMessages[index];
+            out++;
+            msg >>= 1;
+            index++;
+        }
+    }
+
+    return out;
+}
+
+static void PrintMessages(uint32_t msg)
+{
+    const char *strs[CAMERA_MESSAGES_NUM];
+    const int translated = GetMessageStrings(msg, strs, CAMERA_MESSAGES_NUM);
+    for (int n = 0; n < translated; n++) {
+        ALOGV("    %s", strs[n]);
+    }
+}
+
+CallbackNotifier::CallbackNotifier()
+    : mNotifyCB(nullptr), mDataCB(nullptr), mDataCBTimestamp(nullptr), mGetMemoryCB(nullptr), mCBOpaque(nullptr),
+      mVideoRecEnabled(false), mLastFrameTimestamp(0), mFrameRefreshFreq(0), mMessageEnabler(0), mJpegQuality(90),
+      mTakingPicture(false)
+{}
+
+void CallbackNotifier::SetCallbacks(camera_notify_callback notify_cb, camera_data_callback data_cb,
+    camera_data_timestamp_callback data_cb_timestamp, camera_request_memory get_memory, void *user)
+{
+    Mutex::Autolock locker(&m_objectLock);
+    mNotifyCB = notify_cb;
+    mDataCB = data_cb;
+    mDataCBTimestamp = data_cb_timestamp;
+    mGetMemoryCB = get_memory;
+    mCBOpaque = user;
+}
+
+void CallbackNotifier::EnableMessage(uint msg_type)
+{
+    PrintMessages(msg_type);
+
+    Mutex::Autolock locker(&m_objectLock);
+    mMessageEnabler |= msg_type;
+    ALOGV("**** Currently enabled messages:");
+    PrintMessages(mMessageEnabler);
+}
+
+void CallbackNotifier::DisableMessage(uint msg_type)
+{
+    PrintMessages(msg_type);
+
+    Mutex::Autolock locker(&m_objectLock);
+    mMessageEnabler &= ~msg_type;
+    ALOGV("**** Currently disabled messages:");
+    PrintMessages(mMessageEnabler);
+}
+
+android::status_t CallbackNotifier::EnableVideoRecording(int fps)
+{
+    ALOGV("FPS = %d", fps);
+
+    Mutex::Autolock locker(&m_objectLock);
+    mVideoRecEnabled = true;
+    mLastFrameTimestamp = 0;
+    mFrameRefreshFreq = 1000000000LL / fps;
+
+    return android::NO_ERROR;
+}
+
+void CallbackNotifier::DisableVideoRecording()
+{
+    Mutex::Autolock locker(&m_objectLock);
+    mVideoRecEnabled = false;
+    mLastFrameTimestamp = 0;
+    mFrameRefreshFreq = 0;
+}
+
+void CallbackNotifier::ReleaseRecordingFrame(const void *opaque)
+{
+    android::List<camera_memory_t *>::iterator it = mCameraMemoryTs.begin();
+    for (; it != mCameraMemoryTs.end(); ++it) {
+        if ((*it)->data == opaque) {
+            (*it)->release(*it);
+            mCameraMemoryTs.erase(it);
+            break;
+        }
+    }
+}
+
+void CallbackNotifier::AutoFocusComplete()
+{
+    mNotifyCB(CAMERA_MSG_FOCUS, true, 0, mCBOpaque);
+}
+
+void CallbackNotifier::OnNextFrameAvailable(nsecs_t timestamp, CameraDevice *cameraDev)
+{
+    if (IsMessageEnabled(CAMERA_MSG_VIDEO_FRAME) && IsVideoRecordingEnabled() && IsNewVideoFrameTime(timestamp)) {
+        const size_t frameSize = cameraDev->GetVideoFrameBufferSize();
+        camera_memory_t *cam_buff = mGetMemoryCB(-1, frameSize, 1, mCBOpaque);
+        if (nullptr != cam_buff && nullptr != cam_buff->data) {
+            int64_t frame_timestamp = 0L;
+            cameraDev->GetCurrentFrame(cam_buff->data, V4L2_PIX_FMT_YUV420, &frame_timestamp);
+            mDataCBTimestamp(
+                frame_timestamp != 0L ? frame_timestamp : timestamp, CAMERA_MSG_VIDEO_FRAME, cam_buff, 0, mCBOpaque);
+            mCameraMemoryTs.push_back(cam_buff);
+        } else {
+            ALOGE("Memory failure in CAMERA_MSG_VIDEO_FRAME");
+        }
+    }
+
+    if (IsMessageEnabled(CAMERA_MSG_PREVIEW_FRAME)) {
+        camera_memory_t *cam_buff = mGetMemoryCB(-1, cameraDev->GetFrameBufferSize(), 1, mCBOpaque);
+        if (nullptr != cam_buff && nullptr != cam_buff->data) {
+            int64_t frame_timestamp = 0L;
+            cameraDev->GetCurrentFrame(cam_buff->data, cameraDev->GetOriginalPixelFormat(), &frame_timestamp);
+            mDataCB(CAMERA_MSG_PREVIEW_FRAME, cam_buff, 0, nullptr, mCBOpaque);
+            cam_buff->release(cam_buff);
+        } else {
+            ALOGE("Memory failure in CAMERA_MSG_PREVIEW_FRAME");
+        }
+    }
+
+    if (mTakingPicture) {
+        mTakingPicture = false;
+        if (IsMessageEnabled(CAMERA_MSG_SHUTTER)) {
+            mNotifyCB(CAMERA_MSG_SHUTTER, 0, 0, mCBOpaque);
+        }
+        if (IsMessageEnabled(CAMERA_MSG_RAW_IMAGE_NOTIFY)) {
+            mNotifyCB(CAMERA_MSG_RAW_IMAGE_NOTIFY, 0, 0, mCBOpaque);
+        }
+        if (IsMessageEnabled(CAMERA_MSG_COMPRESSED_IMAGE)) {
+            ExifData *exifData = CreateExifData(mCameraParameters);
+            CameraDevice::FrameLock lock(*cameraDev);
+            const void *frame = cameraDev->GetCurrentFrame();
+            int width = cameraDev->GetFrameWidth();
+            int height = cameraDev->GetFrameHeight();
+            int thumbWidth = mCameraParameters.getInt(CameraParameters::KEY_JPEG_THUMBNAIL_WIDTH);
+            int thumbHeight = mCameraParameters.getInt(CameraParameters::KEY_JPEG_THUMBNAIL_HEIGHT);
+            if (thumbWidth > 0 && thumbHeight > 0) {
+                NV21JpegCompressor compressor;
+                android::status_t res = compressor.CompressRawImage(frame, width, height, mJpegQuality, nullptr);
+                if (res == android::NO_ERROR) {
+                    camera_memory_t *jpeg_buff = mGetMemoryCB(-1, compressor.GetCompressedSize(), 1, mCBOpaque);
+                    if (nullptr != jpeg_buff && nullptr != jpeg_buff->data) {
+                        compressor.GetCompressedImage(jpeg_buff->data);
+                        mDataCB(CAMERA_MSG_COMPRESSED_IMAGE, jpeg_buff, 0, nullptr, mCBOpaque);
+                        jpeg_buff->release(jpeg_buff);
+                    } else {
+                        ALOGE("Memory failure in CAMERA_MSG_VIDEO_FRAME");
+                    }
+                } else {
+                    ALOGE("Compression failure in CAMERA_MSG_VIDEO_FRAME");
+                }
+                FreeExifData(exifData);
+            }
+        }
+    }
+}
+
+void CallbackNotifier::OnCameraDeviceError(int err)
+{
+    if (IsMessageEnabled(CAMERA_MSG_ERROR) && mNotifyCB != nullptr) {
+        mNotifyCB(CAMERA_MSG_ERROR, err, 0, mCBOpaque);
+    }
+}
+
+bool CallbackNotifier::IsNewVideoFrameTime(nsecs_t timestamp)
+{
+    Mutex::Autolock locker(&m_objectLock);
+    if ((timestamp - mLastFrameTimestamp) >= mFrameRefreshFreq) {
+        mLastFrameTimestamp = timestamp;
+        return true;
+    }
+    return false;
+}
+}  // namespace CameraMock
