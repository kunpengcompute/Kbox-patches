+#include "worker_thread.h"
+
+namespace CameraMock {
+
+class Camera;
+
+class CameraDevice {
+public:
+    explicit CameraDevice(Camera *cameraHal);
+
+    virtual ~CameraDevice();
+
+    virtual android::status_t ConnectDevice();
+
+    virtual android::status_t DisconnectDevice();
+
+    virtual android::status_t StartDevice(int width, int height, uint32_t pix_fmt);
+    virtual android::status_t StopDevice();
+
+    virtual android::status_t StopDeliveringFrames();
+    virtual android::status_t StartDeliveringFrames(bool oneBurst);
+    virtual android::status_t GetCurrentPreviewFrame(void *buffer, int64_t *timestamp);
+    virtual const void *GetCurrentFrame();
+
+    virtual android::status_t GetCurrentFrame(void *buffer, uint32_t pixelFormat, int64_t *timestamp);
+
+    android::status_t GetCurrentFrameImpl(const uint8_t *source, uint8_t *dest, uint32_t pixelFormat) const;
+    virtual android::status_t Initialize();
+
+    inline int GetFrameWidth() const
+    {
+        ALOGE_IF(!IsStarted(), "Device is not started");
+        return m_frameWidth;
+    }
+    inline int GetFrameHeight() const
+    {
+        ALOGE_IF(!IsStarted(), "Device is not started");
+        return m_frameHeight;
+    }
+
+    inline size_t GetFrameBufferSize() const
+    {
+        ALOGE_IF(!IsStarted(), "Device is not started");
+        return m_frameBufferSize;
+    }
+    inline size_t GetVideoFrameBufferSize() const
+    {
+        ALOGE_IF(!IsStarted(), "Device is not started");
+        return m_frameWidth * m_frameHeight * 3 / 2;  // YUV大小为frame大小的1.5倍
+    }
+    inline int GetPixelNum() const
+    {
+        ALOGE_IF(!IsStarted(), "Device is not started");
+        return m_totalPixels;
+    }
+
+    inline uint32_t GetOriginalPixelFormat() const
+    {
+        ALOGE_IF(!IsStarted(), "Device is not started");
+        return m_pixelFormat;
+    }
+
+    inline bool IsInitialized() const
+    {
+        return m_state != ECDS_CONSTRUCTED;
+    }
+    inline bool IsConnected() const
+    {
+        return m_state == ECDS_CONNECTED || m_state == ECDS_STARTED;
+    }
+    inline bool IsStarted() const
+    {
+        return m_state == ECDS_STARTED;
+    }
+
+    class FrameLock {
+    public:
+        FrameLock(CameraDevice &cameraDevice);
+        ~FrameLock();
+
+    private:
+        CameraDevice &m_cameraDevice;
+    };
+
+    /*
+     * 白平衡
+     */
+    virtual void InitializeWhiteBalanceModes(const char *mode, const float r_scale, const float b_scale);
+    virtual void SetWhiteBalanceMode(const char *mode);
+    android::status_t SetPreviewFrameRate(int framesPerSecond);
+    virtual android::status_t SetAutoFocus();
+    virtual android::status_t CancelAutoFocus();
+    bool RequestRestart(int width, int height, uint32_t pixelFormat, bool takingPicture, bool oneBurst);
+    virtual android::status_t CommonStartDevice(int width, int height, uint32_t pix_fmt);
+    virtual void CommonStopDevice();
+    inline uint8_t ChangeExposure(const uint8_t &inputY) const
+    {
+        return static_cast<uint8_t>(clamp(static_cast<float>(inputY) * m_exposureCompensation));
+    }
+    void CheckAutoFocusTrigger();
+    void ChangeWhiteBalance(uint8_t &y, uint8_t &u, uint8_t &v) const;
+    void DrawSolid(void *buffer, YUVPixel *color);
+    virtual android::status_t StartWorkerThread(bool oneBurst);
+    virtual android::status_t StopWorkerThread();
+    virtual bool ProduceFrame(void *buffer, int64_t *timestamp);
+
+    virtual void *GetPrimaryBuffer()
+    {
+        return m_frameBuffers[0].data();
+    }
+
+    class CameraThread : public WorkerThread {
+    public:
+        typedef bool (*ProduceFrameFunc)(void *opaque, void *destinationBuffer, int64_t *destinationTimestamp);
+        CameraThread(CameraDevice *cameraDevice, ProduceFrameFunc producer, void *producerOpaque);
+
+        const void *GetPrimaryBuffer() const;
+        int64_t GetPrimaryTimestamp() const;
+        void LockPrimaryBuffer();
+        void UnlockPrimaryBuffer();
+
+        void RequestRestart(int width, int height, uint32_t pixelFormat, bool takingPicture, bool oneBurst);
+
+    private:
+        bool CheckRestartRequest();
+        bool WaitForFrameOrTimeout(nsecs_t timeout);
+        bool InWorkerThread() override;
+        android::status_t OnThreadStart() override;
+        void OnThreadExit() override;
+
+        class FrameProducer : public WorkerThread {
+        public:
+            FrameProducer(CameraDevice *cameraDevice, ProduceFrameFunc producer, void *opaque, void *primaryBuffer);
+            /* Indicates if the producer has produced at least one frame. */
+            bool HasFrame() const;
+            const void *GetPrimaryBuffer() const;
+            int64_t GetPrimaryTimestamp() const;
+            void LockPrimaryBuffer();
+            void UnlockPrimaryBuffer();
+
+        protected:
+            bool InWorkerThread() override;
+
+            ProduceFrameFunc m_producer;
+            void *m_opaque;
+            void *m_primaryBuffer;
+            int64_t m_primaryTimestamp;
+            nsecs_t m_lastFrame;
+            mutable Mutex m_bufferMutex;
+        };
+
+        nsecs_t m_curFrameTimestamp;
+        android::sp<FrameProducer> m_frameProducer;
+        ProduceFrameFunc m_producerFunc;
+        void *m_producerOpaque;
+
+        Mutex m_requestMutex;
+        int m_restartWidth;
+        int m_restartHeight;
+        uint32_t m_restartPixelFormat;
+        bool m_restartOneBurst;
+        bool m_restartTakingPicture;
+        bool m_restartRequested;
+    };
