+static inline bool isDigit(char c) {
+    return '0' <= c && c <= '9';
+}
+
+static inline bool isDigits(char* s) {
+    for (int i = 0; i < strlen(s); i++) {
+        if (!isDigit(s[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static inline bool isLetter(char c) {
+    return ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z');
+}
+
+static inline bool isLetterOrDigit(char c) {
+    return isLetter(c) || isDigit(c);
+}
+
+static inline bool isLetterOrDigits(char* s) {
+    for (int i = 0; i < strlen(s); i++) {
+        if (!isLetterOrDigit(s[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// The caller must ensure that the input parameters are in the range of [0, 0xf].
+static inline char Hex2Ascii(int c) {
+    if (c >= 0 && c <= 9) {
+        return '0' + c;
+    } else {
+        return 'a' + c - 10;
+    }
+}
+
+/* 
+    Internal function, the caller must ensure that: 1. The prefix length is smaller than the num length. 
+    2. The prefix length plus 17 is greater than the num length (17 is the length of time).
+*/
+static string get_sequence_by_time(string prefix, int num) {
+    auto now = chrono::time_point_cast<chrono::milliseconds>(chrono::system_clock::now());
+    time_t t = chrono::system_clock::to_time_t(now);
+    int milliSecond = now.time_since_epoch().count() % 1000;
+    auto localTm = localtime(&t);
+    char buff[32];
+    int len = strftime(buff, 32, "%Y%m%d%H%M%S", localTm);
+    sprintf(buff + len, "%03u", milliSecond);
+    int pos = strlen(buff) - (num - prefix.length());
+    return prefix + string(buff).substr(pos, strlen(buff) - pos);
+}
