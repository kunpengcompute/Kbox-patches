+static string get_imei_by_prop() {
+    char propBuf[PROPERTY_VALUE_MAX];
+    property_get("persist.sys.prop.writeimei", propBuf, NULL);
+
+    int length = strlen(propBuf);
+    if (length < MIN_IMEI_LENGTH || length > MAX_IMEI_LENGTH) {
+        ALOGE("get_imei_by_prop %s length error", propBuf);
+        string imei = get_sequence_by_time("86", MAX_IMEI_LENGTH);
+        property_set("persist.sys.prop.writeimei", imei.c_str());
+        return imei;
+    }
+
+    if (!isDigits(propBuf)) {
+        ALOGE("get_imei_by_prop %s Character error", propBuf);
+        string imei = get_sequence_by_time("86", MAX_IMEI_LENGTH);
+        property_set("persist.sys.prop.writeimei", imei.c_str());
+        return imei;
+    }
+
+    ALOGE("get_imei_by_prop %s ok", propBuf);
+    return string(propBuf);
+}
