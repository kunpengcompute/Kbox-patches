+#define VSYNC_PERIOD_VALUE_BASE 1000000000
+#define MAX_FPS 300
+#define DEFAULT_FPS 30
+static nsecs_t getPeriodFromProp(std::string prop)
+{
+    char tmpFps[PROPERTY_VALUE_MAX] = {0};
+    property_get(prop.c_str(), tmpFps, "30");
+    std::stringstream stream;
+    stream << tmpFps;
+    int fps;
+    stream >> fps;
+
+    if (fps <= 0 || fps > MAX_FPS) {
+        fps = DEFAULT_FPS;
+    }
+    return VSYNC_PERIOD_VALUE_BASE / fps; // 1000*1000*1000/30
+}
