+static VkResult
+create_bc3_layout(struct vk_device *device, VkAllocationCallbacks *allocator,
+                  struct vk_texcompress_bcn_state *bcn)
+{
+   VkResult result;
+   VkDevice _device = vk_device_to_handle(device);
