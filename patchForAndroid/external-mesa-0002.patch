+static VkResult
+create_sampler(struct vk_device *device, VkAllocationCallbacks *allocator,
+               VkSampler *sampler, VkFilter filter, VkSamplerMipmapMode mipmapMode)
+{
+   VkDevice _device = vk_device_to_handle(device);
