+
+uint16_t convertBigEndianUInt16(uint16_t value);
+uint32_t convertBigEndianUInt32(uint32_t value);
+
+bool writePackedString(const std::string& str, FILE *stream);
+bool writePackedUInt16(uint16_t value, FILE *stream);
+bool writePackedUInt32(uint32_t value, FILE *stream);
+
+uint16_t convertBigEndianUInt16(uint16_t value)
+{
+	union { uint16_t value; unsigned char data[2]; } aux = { 0x4142 };
+
+	if (aux.data[0] == 0x41)
+	{
+		return value;
+	}
+
+	aux.data[0] = (value >> 8) & 0xff;
+	aux.data[1] = value & 0xff;
+
+	return aux.value;
+}
+
+uint32_t convertBigEndianUInt32(uint32_t value)
+{
+	union { uint32_t value; unsigned char data[4]; } aux = { 0x41424344 };
+
+	if (aux.data[0] == 0x41)
+	{
+		return value;
+	}
+
+	aux.data[0] = (value >> 24) & 0xff;
+	aux.data[1] = (value >> 16) & 0xff;
+	aux.data[2] = (value >> 8) & 0xff;
+	aux.data[3] = value & 0xff;
+
+	return aux.value;
+}
+
+bool writePackedString(const std::string& str, FILE *stream)
+{
+    const char *string = str.c_str();
+	size_t stringLength = strlen(string);
+
+	if (!writePackedUInt16(stringLength, stream))
+	{
+		return false;
+	}
+
+	return fwrite(string, stringLength, 1, stream) == 1;
+}
+
+bool writePackedUInt16(uint16_t value, FILE *stream)
+{
+	uint16_t buffer = convertBigEndianUInt16(value);
+	return fwrite(&buffer, sizeof buffer, 1, stream) == 1;
+}
+
+bool writePackedUInt32(uint32_t value, FILE *stream)
+{
+	uint32_t buffer = convertBigEndianUInt32(value);
+	return fwrite(&buffer, sizeof buffer, 1, stream) == 1;
+}
+
+// 执行系统命令并返回输出结果
+std::string execute_command(const std::string& command) {
+    FILE* fp = popen(command.c_str(), "r");
+    if (!fp) {
+        return "";
+    }
+    char buffer[128];
+    std::string result;
+    while (fgets(buffer, sizeof(buffer), fp) != nullptr) {
+        result += buffer;
+    }
+    pclose(fp);
+    if (!result.empty() && result.back() == '\n') {
+        result.pop_back();  // 去除末尾换行符
+    }
+    return result;
+}
+
+// 从build.prop文件中读取指定属性值
+std::string read_prop_from_file(const std::string& filename, const std::string& key) {
+    std::ifstream file(filename);
+    if (!file) {
+        return "";
+    }
+    std::string line;
+    while (std::getline(file, line)) {
+        if (line.find(key) != std::string::npos) {
+            size_t pos = line.find('=');
+            if (pos != std::string::npos) {
+                return line.substr(pos + 1);
+            }
+        }
+    }
+    return "";
+}
+
+// 获取DNS地址，优先读取系统属性，否则读取build.prop
+std::string get_dns(int index) {
+    char key[32];
+    snprintf(key, sizeof(key), "net.dns%d", index);
+    std::string vendor_dns = read_prop_from_file("/vendor/build.prop", key);
+    if (!vendor_dns.empty()) {
+        return vendor_dns;
+    }
+    std::string system_vendor_dns = read_prop_from_file("/system/build.prop", key);
+    return system_vendor_dns;
+}
+
+int main() {
+    const std::string ipconfigfile = "/data/misc/ethernet/ipconfig.txt";
+    const std::string ipconfigpath = "/data/misc/ethernet";
+    const std::string apexipconfigfile = "/data/misc/apexdata/com.android.tethering/misc/ethernet/ipconfig.txt";
+    // 删除旧文件
+    unlink(ipconfigfile.c_str());
+    // 创建目录
+    struct stat info;
+    if (stat(ipconfigpath.c_str(), &info) != 0) {
+        mkdir(ipconfigpath.c_str(), 0755);
+    }
+
+    FILE *out = fopen("/data/misc/ethernet/ipconfig.txt", "w+");
+    if (!out) {
+        LOG(ERROR) << "Failed to open ipconfigfile";
+        return 1;
+    }
+
+    writePackedUInt32(3, out);
+    writePackedString("ipAssignment", out);
+    writePackedString("STATIC", out);
+    writePackedString("linkAddress", out);
+
+    // 获取IP地址
+    std::string ip = execute_command("ifconfig | grep Bcast |awk -F \"[: ]\" '{print $13}'");
+    if (ip.empty()) {
+        LOG(ERROR) << "Failed to get IP address";
+        return 1;
+    }
+    writePackedString(ip, out);
+    writePackedUInt32(24, out);
+    writePackedString("gateway", out);
+    writePackedUInt32(0, out);
+    writePackedUInt32(1, out);
+
+    std::string gateway = execute_command("ip route show table all | grep default | awk -F \"[: ]\" '{print $3}'");
+    if (gateway.empty()) {
+        LOG(ERROR) << "Failed to get gateway";
+        return 1;
+    }
+    writePackedString(gateway, out);
+    writePackedString("dns", out);
+    writePackedString(get_dns(1), out);
+    writePackedString("dns", out);
+    writePackedString(get_dns(2), out);
+    writePackedString("dns", out);
+    writePackedString(get_dns(3), out);
+    writePackedString("id", out);
+
+
+    std::string id = execute_command("ifconfig | grep Ethernet | awk '{print $1}'");
+    writePackedString(id, out);
+    writePackedString("eos", out);
+
+    fclose(out);
+    // 设置文件权限
+
+    chmod(ipconfigfile.c_str(), 0600);
+    chown(ipconfigfile.c_str(), getuid(), getgid());  // 需要root权限
+
+    // 复制到apex目录
+    if (access(apexipconfigfile.c_str(), F_OK) == 0) {
+        std::ifstream src(ipconfigfile, std::ios::binary);
+        std::ofstream dst(apexipconfigfile, std::ios::binary | std::ios::trunc);
+        dst << src.rdbuf();
+    }
+    return 0;
+}
