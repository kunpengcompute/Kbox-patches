+/*
+ * 云手机（容器化）定制：读取 Android 原生系统属性（ro.*）。
+ * java.lang.System 的 Java 属性表并不会镜像任意 ro.* 属性（见
+ * System.initUnchangeableSystemProperties），而 core-oj（libcore）在编译期
+ * 又不能依赖 framework 的 android.os.SystemProperties，因此通过 bionic
+ * __system_property_get 在此直接读取。非 Android（host）构建返回 NULL。
+ */
+static jstring System_nativeGetSystemProperty(JNIEnv* env, jclass ignored, jstring name) {
+#if defined(__ANDROID__)
+  const char* name_chars = (*env)->GetStringUTFChars(env, name, NULL);
+  if (name_chars == NULL) {
+    return NULL;  // OutOfMemoryError already thrown.
+  }
+  char value[PROP_VALUE_MAX];
+  int len = __system_property_get(name_chars, value);
+  (*env)->ReleaseStringUTFChars(env, name, name_chars);
+  if (len <= 0) {
+    return NULL;  // 属性未设置。
+  }
+  return (*env)->NewStringUTF(env, value);
+#else
+  return NULL;
+#endif
+}
