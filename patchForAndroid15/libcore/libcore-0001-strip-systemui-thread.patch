+++ b/ojluni/src/main/java/java/lang/Runtime.java
@@ -725,7 +725,23 @@ public class Runtime {
      * @since 1.4
      */
     public int availableProcessors() {
-        return (int) Libcore.os.sysconf(_SC_NPROCESSORS_CONF);
+        // 云手机（容器化）场景定制：宿主机配置核数（如 128）会导致各进程线程池
+        // （SystemUIBg、ART GC/JIT、HWUI、ForkJoinPool 及第三方应用自身）按该值预创建
+        // 大量常驻空闲线程。通过 ro.config.available_processors 覆盖为实例实际分配核数，
+        // 可在不改动各线程池调用方的前提下统一收缩。属性未设置或非法时回退到系统默认值。
+        // 注意：必须经 nativeGetSystemProperty 直接读取 Android 原生系统属性——
+        // java.lang.System 的 Java 属性表不会镜像任意 ro.* 属性，System.getProperty 恒为 null。
+        String override = System.nativeGetSystemProperty("ro.config.available_processors");
+        int n = 0;
+        if (override != null && !override.isEmpty()) {
+            try {
+                n = Integer.parseInt(override);
+            } catch (NumberFormatException ignored) {
+                // 非法取值，回退到默认实现。
+            }
+        }
+        int result = n > 0 ? n : (int) Libcore.os.sysconf(_SC_NPROCESSORS_CONF);
+        return result;
     }
 
