+void RenderSurface::queueBypassBuffer(const sp<GraphicBuffer>& buffer,
+                                      const sp<Fence>& acquireFence, ui::Dataspace dataspace,
+                                      base::unique_fd cancelFence, float hdrSdrRatio) {
+    status_t result =
+            mDisplaySurface->setBypassClientTarget(buffer, acquireFence, dataspace, hdrSdrRatio);
+    if (result != NO_ERROR) {
+        // The display surface cannot present a foreign buffer (e.g. a virtual
+        // display). Fall back to the regular path and present the client
+        // target as-is, matching the behavior of the previous bypass
+        // implementation which relied on a cooperating HWC.
+        queueBuffer(std::move(cancelFence), hdrSdrRatio);
+        return;
+    }
+
+    // The client-target buffer was dequeued but never rendered into for this
+    // bypassed frame. Return it to the buffer queue with its original dequeue
+    // fence (cancelFence) so the slot can be reused; presenting it would show
+    // a stale frame.
+    if (mTexture != nullptr) {
+        const int fenceFd = cancelFence.get() >= 0 ? dup(cancelFence.get()) : -1;
+        int error = mNativeWindow->cancelBuffer(mNativeWindow.get(),
+                                                mTexture->getBuffer()->getNativeBuffer(), fenceFd);
+        ALOGW_IF(error != NO_ERROR,
+                 "ANativeWindow::cancelBuffer failed for display [%s] with error: %d",
+                 mDisplay.getName().c_str(), error);
+        mTexture = nullptr;
+    }
+}
