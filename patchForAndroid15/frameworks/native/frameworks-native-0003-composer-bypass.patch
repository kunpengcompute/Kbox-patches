+status_t FramebufferSurface::setBypassClientTarget(const sp<GraphicBuffer>& buffer,
+                                                   const sp<Fence>& acquireFence,
+                                                   ui::Dataspace dataspace, float hdrSdrRatio) {
+    Mutex::Autolock lock(mMutex);
+    if (buffer == nullptr) {
+        return BAD_VALUE;
+    }
+
+    // The presented buffer is not one of ours: it is the single bypassed
+    // layer buffer given to HWC directly. Invalidate the per-slot HWC buffer
+    // cache so the next regular frame re-sends its buffer for every slot
+    // instead of relying on a stale slot-to-buffer mapping.
+    for (size_t i = 0; i < sizeof(mHwcBufferIds) / sizeof(mHwcBufferIds[0]); ++i) {
+        mHwcBufferIds[i] = UINT64_MAX;
+    }
+
+    // The bypass buffer has no BufferQueue slot of ours; reuse slot 0 for
+    // the HWC client-target cache entry. SF always sends the full buffer
+    // handle for the bypass frame (and for the frames following the cache
+    // invalidation above), so the slot choice is self-correcting.
+    const uint32_t bypassSlot = 0;
+    status_t result = mHwc.setClientTarget(mDisplayId, bypassSlot, acquireFence, buffer, dataspace,
+                                           hdrSdrRatio);
+    if (result != NO_ERROR) {
+        ALOGE("error posting bypass client target: %s (%d)", strerror(-result), result);
+        return result;
+    }
+
+    // The client-target buffer acquired by the previous regular frame is no
+    // longer presented. Convert it to a pending release, mirroring the
+    // slot-change handling in advanceFrame(), so that onFrameCommitted()
+    // releases it after this frame's present. Dropping the reference without
+    // releasing would leave the slot permanently ACQUIRED: with only
+    // maxFrameBufferAcquiredBuffers slots in the queue, a later dequeueBuffer
+    // would then block the SurfaceFlinger main thread forever.
+    if (mCurrentBufferSlot != BufferQueue::INVALID_BUFFER_SLOT) {
+        mHasPendingRelease = true;
+        mPreviousBufferSlot = mCurrentBufferSlot;
+        mPreviousBuffer = mCurrentBuffer;
+    }
+    mCurrentBufferSlot = BufferQueue::INVALID_BUFFER_SLOT;
+    mCurrentBuffer.clear();
+
+    // Keep the client target state consistent for the rest of the frame:
+    // mCurrentFence is reported as the client target acquire fence, and it
+    // is exactly the acquire fence of the buffer now being presented.
+    mCurrentFence = acquireFence;
+    mDataspace = static_cast<Dataspace>(dataspace);
+
+    return NO_ERROR;
+}
