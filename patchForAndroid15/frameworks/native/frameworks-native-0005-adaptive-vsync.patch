+void Scheduler::notifyAppVsync(const char* const name) {
+    setAdaptiveVysncFlag(false);
+    if (adaptiveVsyncFlag && strcmp(name, "app") == 0 && renderAccJudge && data) {
+        nsecs_t now = systemTime(SYSTEM_TIME_MONOTONIC);
+        renderAccJudge(data, now);
+        scheduleFrame();
+    }
+}
