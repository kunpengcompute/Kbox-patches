+#define RENDERACC_SO_PATH "/system/lib64/AdaptiveVsync.kbox.so"
+void Scheduler::RenderAccInitialize() {
+    char value[PROPERTY_VALUE_MAX];
+    property_get("ro.vmi.adaptive.vsync", value, "0");
+    adaptiveVsyncFlag = (atoi(value) == 1);
+    ALOGI_IF(adaptiveVsyncFlag, "Scheduler Enabling adaptive vsync.");
+
+    if (adaptiveVsyncFlag) {
+        void *renderAcclibHdl = dlopen(RENDERACC_SO_PATH, RTLD_LAZY);
+        if (renderAcclibHdl == nullptr) {
+            ALOGE("AdaptiveVsync: open AdaptiveVsync.kbox.so failed. path %s, error %s", RENDERACC_SO_PATH,dlerror());
+        }
+
+        renderAccInitialize = reinterpret_cast<RenderAccInitializeProxy>(dlsym(renderAcclibHdl, "AdaptiveVsyncInit"));
+        if (renderAccInitialize == nullptr) {
+            ALOGE("AdaptiveVsync: Get RenderAccInitializeProxy function fail, error: %s", dlerror());
+        }
+
+        renderAccDeinit = reinterpret_cast<RenderAccDeinitProxy>(dlsym(renderAcclibHdl, "AdaptiveVsyncDeinit"));
+        if (renderAccDeinit == nullptr) {
+            ALOGE("AdaptiveVsync: Get RenderAccDeinitProxy function fail, error: %s", dlerror());
+        }
+        
+        renderAccJudge = reinterpret_cast<RenderAccJudgeProxy>(dlsym(renderAcclibHdl, "IsCloseAdaptiveVsync"));
+        if (renderAccJudge == nullptr) {
+            ALOGE("AdaptiveVsync: Get RenderAccJudgeProxy function fail, error: %s", dlerror());
+        }
+        
+        renderAccQueueBuffer = reinterpret_cast<RenderAccQueueBufferProxy>(dlsym(renderAcclibHdl, "AdaptiveVsyncOnQueueBuffer"));
+        if (renderAccQueueBuffer == nullptr) {
+            ALOGE("AdaptiveVsync: Get RenderAccQueueBufferProxy function fail, error: %s", dlerror());
+        }
+
+        renderAccProc = reinterpret_cast<RenderAccProcProxy>(dlsym(renderAcclibHdl, "AdaptiveVsyncOnVsync"));
+        if (renderAccProc == nullptr) {
+            ALOGE("AdaptiveVsync: Get RenderAccProcProxy function fail, error: %s", dlerror());
+        }
+
+        if ((renderAccInitialize == nullptr) || (renderAccDeinit == nullptr) || (renderAccJudge == nullptr) || (renderAccQueueBuffer == nullptr) || (renderAccProc == nullptr)) {
+            renderAccInitialize = nullptr;
+            renderAccDeinit = nullptr;
+            renderAccJudge = nullptr;
+            renderAccQueueBuffer = nullptr;
+            renderAccProc = nullptr;
+            dlclose(renderAcclibHdl);
+            return;
+        }
+
+        data = renderAccInitialize();
+        if (data == nullptr) {
+            ALOGE("AdaptiveVsync: RenderAccInitialize fail.");
+            renderAccInitialize = nullptr;
+            renderAccDeinit = nullptr;
+            renderAccJudge = nullptr;
+            renderAccQueueBuffer = nullptr;
+            renderAccProc = nullptr;
+            dlclose(renderAcclibHdl);
+        } else {
+            ALOGI("AdaptiveVsync: RenderAccInitialize success.");
+        }
+    }
+}
 
