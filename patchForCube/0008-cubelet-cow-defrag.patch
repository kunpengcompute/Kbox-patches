new file mode 100644
index 00000000..8c63c6ea
--- /dev/null
+++ b/Cubelet/storage/defrag.go
@@ -0,0 +1,200 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+//
+
+package storage
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/log"
+)
+
+// defragSem serialises rootfs rewrites: a rewrite competes with the XFS log
+// and the disk bandwidth of running sandboxes, so never run more than one.
+var defragSem = make(chan struct{}, 1)
+
+// cowDefragKey carries the per-request defrag switch from the RPC handler down
+// to the CoW store. A template/snapshot is only rewritten when the caller
+// explicitly asked for it; the [cow.defrag] config remains the operator-level
+// circuit breaker.
+type cowDefragKey struct{}
+
+// WithCowDefrag marks this request as defrag-enabled. No-op for false.
+func WithCowDefrag(ctx context.Context, requested bool) context.Context {
+	if !requested {
+		return ctx
+	}
+	return context.WithValue(ctx, cowDefragKey{}, true)
+}
+
+func cowDefragRequested(ctx context.Context) bool {
+	v, _ := ctx.Value(cowDefragKey{}).(bool)
+	return v
+}
+
+// maybeDefragCowObject rewrites a freshly created template/snapshot rootfs in
+// sequential order. The object is not referenced by any sandbox yet, so the
+// file can be replaced atomically. Failures never fail the caller.
+func (m *XfsCow) maybeDefragCowObject(ctx context.Context, kind, scope, name, devPath string) {
+	cfg := m.defrag
+	requested := cowDefragRequested(ctx)
+	// effective = operator switch (enable) AND scope switch (template/snapshot)
+	// AND the caller explicitly asked for it when creating the artifact.
+	if !requested || !cfg.Enable {
+		return
+	}
+	if scope == "template" && !cfg.Template {
+		return
+	}
+	if scope == "snapshot" && !cfg.Snapshot {
+		return
+	}
+	// Cubelet filters Info lines out of the request-scoped log stream, so the
+	// outcome of a rewrite is reported at Warn level; otherwise operators
+	// cannot tell whether a rewrite ran or why it was skipped.
+	logger := log.G(context.Background())
+	logger.Warnf("cow defrag: candidate scope=%s name=%s requested=%v effective=%v devPath=%q", scope, name, requested, true, devPath)
+	if devPath == "" {
+		resolved, err := m.ResolveDevPath(ctx, name, kind)
+		if err != nil {
+			logger.Warnf("cow defrag: resolve %s failed: %v", name, err)
+			return
+		}
+		devPath = resolved
+	}
+	fi, err := os.Stat(devPath)
+	if err != nil {
+		logger.Warnf("cow defrag: stat %q failed: %v", devPath, err)
+		return
+	}
+	if !fi.Mode().IsRegular() {
+		logger.Warnf("cow defrag: %q is not a regular file (mode=%v)", devPath, fi.Mode())
+		return
+	}
+	stat, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok {
+		return
+	}
+	allocBytes := int64(stat.Blocks) * 512
+	if allocBytes > int64(cfg.MaxAllocatedMiB)<<20 {
+		logger.Warnf("cow defrag: skip %s, allocated %dMiB > limit %dMiB", name, allocBytes>>20, cfg.MaxAllocatedMiB)
+		return
+	}
+	extents, err := cowExtentCount(devPath, cfg.TimeoutSeconds)
+	if err != nil {
+		logger.Warnf("cow defrag: read extents of %s failed: %v", name, err)
+		return
+	}
+	if extents < cfg.MinExtents {
+		return
+	}
+	if !hasRoomForRewrite(filepath.Dir(devPath), allocBytes) {
+		logger.Warnf("cow defrag: skip %s, not enough free space", name)
+		return
+	}
+
+	select {
+	case defragSem <- struct{}{}:
+		defer func() { <-defragSem }()
+	case <-time.After(time.Duration(cfg.TimeoutSeconds) * time.Second):
+		logger.Warnf("cow defrag: skip %s, busy", name)
+		return
+	}
+
+	start := time.Now()
+	tmpPath := fmt.Sprintf("%s.defrag.%d.tmp", devPath, os.Getpid())
+	_ = os.Remove(tmpPath)
+	rewritten := false
+	defer func() {
+		if !rewritten {
+			_ = os.Remove(tmpPath)
+		}
+	}()
+
+	cmdCtx, cancel := context.WithTimeout(ctx, time.Duration(cfg.TimeoutSeconds)*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(cmdCtx, "cp", "-a", "--reflink=never", "--sparse=always", devPath, tmpPath)
+	if out, err := cmd.CombinedOutput(); err != nil {
+		logger.Warnf("cow defrag: rewrite %s failed: %v: %s", name, err, strings.TrimSpace(string(out)))
+		return
+	}
+	if err := syncPath(tmpPath); err != nil {
+		logger.Warnf("cow defrag: fsync %s failed: %v", name, err)
+		return
+	}
+	newFi, err := os.Stat(tmpPath)
+	if err != nil {
+		logger.Warnf("cow defrag: stat rewrite of %s failed: %v", name, err)
+		return
+	}
+	newStat, ok := newFi.Sys().(*syscall.Stat_t)
+	if !ok || int64(newStat.Blocks)*512*100 < allocBytes*95 {
+		logger.Warnf("cow defrag: %s rewrite lost allocated blocks, keep original", name)
+		return
+	}
+	newExtents, err := cowExtentCount(tmpPath, cfg.TimeoutSeconds)
+	if err != nil || newExtents >= extents {
+		logger.Warnf("cow defrag: %s no gain (%d -> %d extents), keep original", name, extents, newExtents)
+		return
+	}
+	if err := os.Rename(tmpPath, devPath); err != nil {
+		logger.Warnf("cow defrag: replace %s failed: %v", name, err)
+		return
+	}
+	rewritten = true
+	if dir, err := os.Open(filepath.Dir(devPath)); err == nil {
+		_ = dir.Sync()
+		_ = dir.Close()
+	}
+	logger.Warnf("cow defrag: scope=%s name=%s extents %d->%d alloc %dMiB duration_ms=%d",
+		scope, name, extents, newExtents, allocBytes>>20, time.Since(start).Milliseconds())
+}
+
+// cowExtentCount returns fsxattr.nextents via xfs_io.
+func cowExtentCount(path string, timeoutSec int) (int, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeoutSec)*time.Second)
+	defer cancel()
+	out, err := exec.CommandContext(ctx, "xfs_io", "-c", "stat", path).Output()
+	if err != nil {
+		return 0, err
+	}
+	for _, line := range strings.Split(string(out), "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "fsxattr.nextents") {
+			continue
+		}
+		parts := strings.SplitN(line, "=", 2)
+		if len(parts) != 2 {
+			break
+		}
+		return strconv.Atoi(strings.TrimSpace(parts[1]))
+	}
+	return 0, fmt.Errorf("fsxattr.nextents not found")
+}
+
+func syncPath(path string) error {
+	f, err := os.OpenFile(path, os.O_RDWR, 0)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return f.Sync()
+}
+
+func hasRoomForRewrite(dir string, allocBytes int64) bool {
+	var st syscall.Statfs_t
+	if err := syscall.Statfs(dir, &st); err != nil {
+		return false
+	}
+	free := int64(st.Bavail) * int64(st.Bsize)
+	return free >= allocBytes+(64<<20)
+}
