+
+// CowDefragConfig is the operator-facing `[cow.defrag]` block. When enabled,
+// cubelet rewrites a freshly created template/snapshot rootfs image in
+// sequential order, collapsing the extents reflink clones and boot-time CoW
+// left behind. Later sandbox creations then clone a handful of extents
+// instead of hundreds.
+type CowDefragConfig struct {
+	Enable          bool `toml:"enable"`
+	Template        bool `toml:"template"`
+	Snapshot        bool `toml:"snapshot"`
+	MinExtents      int  `toml:"min_extents"`
+	MaxAllocatedMiB int  `toml:"max_allocated_mib"`
+	TimeoutSeconds  int  `toml:"timeout_seconds"`
+}
+
+func (c CowDefragConfig) withDefaults() CowDefragConfig {
+	if c.MinExtents <= 0 {
+		c.MinExtents = 64
+	}
+	if c.MaxAllocatedMiB <= 0 {
+		c.MaxAllocatedMiB = 2048
+	}
+	if c.TimeoutSeconds <= 0 {
+		c.TimeoutSeconds = 60
+	}
+	return c
 }
 
